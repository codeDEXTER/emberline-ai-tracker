# macOS writes these into any folder opened in Finder. They are per-machine
# noise, never content, and one appeared here as soon as the folder became a
# repo — so ignore them rather than letting them turn up as untracked files
# every time someone runs git status.
.DS_Store
._*

# Editor and OS scratch
*.swp
.idea/
.vscode/

# bin/ has no .py extension so python3 -m py_compile writes its cache here
bin/__pycache__/

# build_towerapp.sh stages Tower.app here. Build output, regenerable in a
# second, and it contains a compiled Swift binary — the source is committed,
# the binary never is.
dist/

# Python bytecode from tests/ (bin/ already covered above). Build output --
# regenerable, machine-specific, and it slipped into a commit once because a
# `grep -q __pycache__` guard matched the bin/ line and skipped the append.
__pycache__/
*.pyc

# Agent and session worktrees. Each is a full checkout of this repo; left
# unignored, fourteen of them showed up as one untracked directory and hid
# real changes in `git status`.
.worktrees/
.claude/worktrees/

# Ruflo (claude-flow) runtime state. The CLI writes these wherever it runs --
# daemon and policy state, logs, neural patterns, and its memory databases with
# their WAL files -- and proposal 19 made the Ruflo loop mandatory, so every
# item run from this checkout leaves them behind. Machine-local, regenerated,
# never content. Only Ruflo's own files under .claude/ are ignored: settings.json
# and skills/ are what derecord installs, and stay committable.
.claude-flow/
.swarm/
ruvector.db
.claude/memory.db
.claude/proven-config.json
.claude/.proven-config-version
.claude-flow/data
.claude-flow/logs
.claude-flow/sessions

# bin/worklog's incremental-read bookmark (proposal 27, W-02): per-transcript
# byte offsets and in-progress message state, so a re-run knows what it
# already collected. Machine-local and regenerable from the transcripts --
# worklog/<date>.jsonl itself is the record and stays committable.
worklog/.state.json
