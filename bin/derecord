#!/usr/bin/env bash
# derecord -- make a project's record files structurally unable to conflict,
# and install the guards that stop a bad merge reaching main.
#
#   derecord [project-dir]     default: current directory
#
# Installs seven things:
#   1. .gitattributes merge rules for the record files
#   2. a pre-commit hook that refuses to commit conflict markers and, when a
#      ledger is staged, regenerates and stages its tracker page and the
#      checkpoint (proposal 20, D12); a project's own pre-commit hook, if it
#      had one, is preserved and chained rather than dropped
#   3. a SessionStart hook that runs rulecheck --quiet
#   4. the project-owned prose (HANDOFF.md, docs/OPERATING-RULES.md,
#      docs/handovers/lead-prompt.md), seeded from templates/ only where a
#      project does not already have its own copy
#   5. the PreCompact, Stop, SessionStart and PostToolUse hooks (proposal 19
#      D8's checkpoint loop, plus proposal 20 V-05/D13's Agent|Task reminder)
#   6. the /warmup skill (proposal 19, D1), kept identical to common-rules'
#      copy rather than seeded once and left to drift
#   7. .gitignore lines for Ruflo's runtime state only (proposal 20, D13);
#      shared Ruflo config stays tracked
#
# Idempotent, and in the strong sense: running it makes the project MATCH the
# shared rules, rather than merely not adding the same line twice. A rule whose
# value changed upstream is rewritten in place. That distinction is the whole of
# issue #57 -- the weak version froze every value at whatever it was when the
# project first adopted, and reported success while doing it.
#
# ONE ORDERING TRAP, and it bites exactly once per branch:
#
#   git reads .gitattributes as of the merge's STARTING state. A merge that is
#   itself delivering .gitattributes therefore runs without it, so the first
#   merge after installing still conflicts on CHANGELOG.md -- which looks like
#   the union rules do not work, when in fact they are not in effect yet.
#
#   Commit .gitattributes on its own, first, then merge. Hit on 2026-08-06
#   bringing a long-lived branch up to date: the merge conflicted, and the
#   identical merge succeeded with zero conflicts once the file had landed in
#   a commit of its own beforehand. The check at the bottom of this script
#   prints that reminder whenever it leaves the file uncommitted.
set -euo pipefail

RULES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJ="${1:-$PWD}"
cd "$PROJ"

GIT="git"
command -v git >/dev/null 2>&1 || GIT=/Library/Developer/CommandLineTools/usr/bin/git
$GIT rev-parse --git-dir >/dev/null 2>&1 || { echo "not a git repo: $PROJ" >&2; exit 1; }

TOP="$($GIT rev-parse --show-toplevel)"
cd "$TOP"

# --- 0. .claude/settings.json must be a valid JSON object, or nothing runs --
#
# Every step below that touches settings.json used to fall back to `d = {}`
# on ANY read failure, including a file that exists but is malformed -- so a
# broken settings.json was silently replaced rather than reported (V-07 round
# 2, finding 2). Checked once, here, before any step writes anything: a
# missing file is fine (steps below start it from {}); a file that exists and
# is not a JSON object refuses the whole run.
if [ -f "$TOP/.claude/settings.json" ]; then
    python3 -c '
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
sys.exit(0 if isinstance(d, dict) else 1)
' "$TOP/.claude/settings.json" || {
        echo "derecord: .claude/settings.json is not valid JSON; fix it and run again (nothing changed)" >&2
        exit 1
    }
fi

# --- 1. merge rules for the record files -------------------------------------
#
# This used to ask "is there a line for this path?" and nothing more, so once a
# pattern was present its value was frozen forever: changing a rule in
# gitattributes-for-projects silently failed to reach any project that had
# already run derecord, and the script still reported success. It bit for real
# when AGENT-LOG.md moved from merge=union to merge=ours (proposal 08) --
# pockets kept union-merging a file that is now generated output, which would
# interleave two generated tables into a file that is neither side's truth.
#
# So the check is now "is there a line for this path WITH THIS VALUE?", and a
# stale value is rewritten in place rather than left alone. Local lines for
# patterns we say nothing about are never touched.
touch .gitattributes
python3 - ".gitattributes" "$RULES_DIR/gitattributes-for-projects" <<'PY'
import sys

target, source = sys.argv[1], sys.argv[2]

def split(line):
    """(pattern, attributes) for a rule line, or None for blank/comment."""
    s = line.strip()
    if not s or s.startswith("#"):
        return None
    parts = s.split()
    return parts[0], " ".join(parts[1:])

rules = [r for r in (split(l) for l in open(source)) if r]
lines = open(target).read().splitlines()

added = corrected = 0
for pat, attrs in rules:
    for i, line in enumerate(lines):
        cur = split(line)
        if not cur or cur[0] != pat:
            continue
        if cur[1] != attrs:
            lines[i] = f"{pat}      {attrs}"
            corrected += 1
        break
    else:
        lines.append(f"{pat}      {attrs}")
        added += 1

if added or corrected:
    with open(target, "w") as fh:
        fh.write("\n".join(lines).rstrip("\n") + "\n")

bits = []
if added:     bits.append(f"{added} added")
if corrected: bits.append(f"{corrected} corrected")
print("  .gitattributes: " + (", ".join(bits) if bits else "already matches the shared rules"))
PY

# --- merge drivers: what git needs, and what actively breaks it --------------
#
# `union` is BUILT IN and must be left alone. An earlier version of this script
# ran `git config merge.union.name "..."`, meaning it as a cosmetic label. It is
# not cosmetic: defining merge.union.* declares a *custom* driver called "union"
# that shadows the built-in, and a custom driver with no `.driver` command makes
# git abort with
#
#     fatal: custom merge driver union lacks command line.
#
# So the line intended to help made every merge touching a record file fail
# outright. Measured 2026-08-06: finance-tracker -- the only project that had
# derecord installed -- carried that setting, and reproducing it fataled a
# CHANGELOG merge. Removed here, and unset below for anyone who already has it.
$GIT config --unset merge.union.name 2>/dev/null || true
$GIT config --unset merge.union.driver 2>/dev/null || true

# `ours`, by contrast, is NOT built in and does need a driver. Without one,
# `.common-rules-version merge=ours` silently degrades to an ordinary merge --
# demonstrated the same day: two branches each writing that file left
# `<<<<<<< HEAD` in it, which is the exact failure these rules exist to
# prevent, in the file recording which rules you are on. `driver true` runs
# /usr/bin/true: it succeeds and leaves our version in place.
$GIT config merge.ours.driver true

# --- 2. pre-commit: conflict guard, D12 ledger regeneration, hook chaining ---
#
# Never commit a conflict marker (2026-08-05: a hand-rolled conflict resolver
# put `<<<<<<< HEAD` into three Python files and main stopped importing at
# all -- the cheapest possible guard against it). Then, when a ledger is
# staged (proposal 20, D12): regenerate its tracker page and the checkpoint
# and stage them in the same commit, so the two never go stale between a
# ledger commit and a later, separate "refresh checkpoint" one -- the finding
# that opened this row: the PhotoVault engine's checkpoint went stale because
# nothing regenerated it when the ledger moved, and the lead had to run
# `tracker checkpoint` by hand.
#
# V-07 round 2 findings, all inside the generated hook below:
#   * finding 1 -- a ledger, its page, or the checkpoint with UNSTAGED edits
#     refuses the commit outright, rather than rendering the working tree's
#     copy and stamping the commit with text nobody staged.
#   * finding 4 -- the checkpoint path staged is whatever `tracker checkpoint`
#     itself printed, parsed from its stdout, never recomputed from today's
#     date a second time (the two can disagree across midnight).
#
# A project that already has its own pre-commit hook must not lose it (V-07
# round 2, finding 3): "ours" is a `# derecord-body-sha256: <hex>` line whose
# value is the sha256 of the hook body that follows it -- generated that way,
# so coincidental text (even the exact wording of an older, unmarked derecord
# hook) can never be mistaken for ours. A foreign hook is preserved as
# hooks/pre-commit.local and chained, once; if pre-commit.local already
# exists and the current hook is still foreign, derecord refuses rather than
# picking a side, and writes nothing.
HOOKS="$($GIT rev-parse --git-path hooks)"
mkdir -p "$HOOKS"
PRECOMMIT="$HOOKS/pre-commit"
LOCAL_HOOK="$HOOKS/pre-commit.local"

BODY_TMPL="$(mktemp)"
trap 'rm -f "$BODY_TMPL"' EXIT
cat > "$BODY_TMPL" <<'HOOKBODY'
set -euo pipefail
GIT=git; command -v git >/dev/null 2>&1 || GIT=/Library/Developer/CommandLineTools/usr/bin/git

# 1. never commit a conflict marker.
bad=$($GIT diff --cached --name-only --diff-filter=ACM | while read -r f; do
    [ -f "$f" ] || continue
    if $GIT show ":$f" 2>/dev/null | grep -qE '^(<{7}|={7}|>{7})( |$)'; then echo "$f"; fi
done)
if [ -n "$bad" ]; then
    echo "pre-commit: unresolved conflict markers in:" >&2
    echo "$bad" | sed 's/^/  /' >&2
    echo "resolve them, or commit with --no-verify if you truly mean it." >&2
    exit 1
fi

# 2. a staged ledger (proposal 20, D12) regenerates and stages its tracker
#    page and the checkpoint. common-rules is resolved from the absolute path
#    baked in at install time -- never from cwd, the same way the other
#    installed hooks (hooks/precompact, hooks/stop, ...) are.
RULES="__RULES_DIR__"
TOP="$($GIT rev-parse --show-toplevel)"
refuse_unstaged() {
    echo "pre-commit: $1 has unstaged changes; stage all of it (git add $1) or none, so its page matches what is committed" >&2
    exit 1
}

# "is a ledger" is read from the INDEX (`git show :path`), what will actually
# be committed -- not the working tree, which may already have moved on.
ledgers=""
for f in $($GIT diff --cached --name-only --diff-filter=ACM); do
    case "$f" in
        docs/proposals/[0-9][0-9]*-*.json) ;;
        *) continue ;;
    esac
    # docs/proposals also holds plain data files shaped like NN-*.json -- a
    # sidecar with no `items` -- and those get no tracker work at all
    # (tools/tracker/ledger.find's own rule for "is this a ledger").
    if $GIT show ":$f" 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
sys.exit(0 if isinstance(d, dict) and isinstance(d.get("items"), list) else 1)
'; then
        ledgers="$ledgers $f"
    fi
done

if [ -n "$ledgers" ]; then
    # Refuse first, render nothing, if a ledger, its page, or today's
    # checkpoint has changes that are not staged -- the page about to be
    # regenerated must carry only what is actually being committed.
    for f in $ledgers; do
        $GIT diff --quiet -- "$f" || refuse_unstaged "$f"
        base=$(basename "$f" .json)
        page="$TOP/docs/proposals/tracker/$base.html"
        if $GIT ls-files --error-unmatch -- "$page" >/dev/null 2>&1; then
            $GIT diff --quiet -- "$page" || refuse_unstaged "$page"
        fi
    done
    cp_guess="$TOP/docs/handovers/$(date +%Y-%m-%d)-checkpoint.md"
    if $GIT ls-files --error-unmatch -- "$cp_guess" >/dev/null 2>&1; then
        $GIT diff --quiet -- "$cp_guess" || refuse_unstaged "$cp_guess"
    fi

    for f in $ledgers; do
        out=$(python3 "$RULES/bin/tracker" render "$TOP/$f" 2>&1) || {
            echo "$out" >&2
            exit 1
        }
        base=$(basename "$f" .json)
        page="$TOP/docs/proposals/tracker/$base.html"
        if [ -f "$page" ]; then
            $GIT add -- "$page"
        fi
    done

    # Stage exactly the path tracker itself reports, never a path recomputed
    # a second time from today's date -- the two can disagree across
    # midnight. If nothing parses (including "no open ledger", which should
    # not happen right after staging one), fail with tracker's own output
    # rather than silently proceeding without a checkpoint.
    cp_out=$(python3 "$RULES/bin/tracker" checkpoint --project "$TOP" 2>&1) || {
        echo "$cp_out" >&2
        exit 1
    }
    cp_path=$(printf '%s\n' "$cp_out" | sed -n 's/^checkpoint: wrote //p')
    if [ -z "$cp_path" ]; then
        echo "$cp_out" >&2
        exit 1
    fi
    $GIT add -- "$cp_path"
fi

# 3. chain to a project's own pre-commit hook, preserved as pre-commit.local
#    rather than dropped -- run last, and only once the checks above pass.
here="$(cd "$(dirname "$0")" && pwd)"
if [ -x "$here/pre-commit.local" ]; then
    "$here/pre-commit.local"
fi
HOOKBODY

python3 - "$PRECOMMIT" "$LOCAL_HOOK" "$RULES_DIR" "$BODY_TMPL" <<'PY'
import hashlib, os, re, shutil, sys

precommit, local_hook, rules_dir, body_tmpl_path = sys.argv[1:5]
MARKER_RE = re.compile(r'^# derecord-body-sha256: ([0-9a-f]{64})$')

def is_ours(path):
    """True only when `path` carries a `# derecord-body-sha256: <hex>` line
    whose value equals the sha256 of everything after that line. Never a
    text match -- an older, unmarked derecord hook, or a hook that happens
    to paste in the same words, is foreign (V-07 round 2, finding 3)."""
    if not os.path.exists(path):
        return False
    lines = open(path, "r", errors="replace").read().split("\n")
    for i, line in enumerate(lines):
        m = MARKER_RE.match(line)
        if m:
            body = "\n".join(lines[i + 1:])
            return hashlib.sha256(body.encode()).hexdigest() == m.group(1)
    return False

body = open(body_tmpl_path).read().replace("__RULES_DIR__", rules_dir)
digest = hashlib.sha256(body.encode()).hexdigest()
new_content = f"#!/usr/bin/env bash\n# derecord-body-sha256: {digest}\n{body}"

exists = os.path.exists(precommit)
if exists and not is_ours(precommit):
    if os.path.exists(local_hook):
        print(f"derecord: {precommit} is a foreign hook and {local_hook} already exists; "
              "resolve them by hand -- decide which one is the real local hook, then "
              "re-run derecord (nothing changed)", file=sys.stderr)
        sys.exit(1)
    shutil.move(precommit, local_hook)
    os.chmod(local_hook, 0o755)
    print("  hooks/pre-commit: project's own hook preserved as hooks/pre-commit.local and chained")

with open(precommit, "w") as fh:
    fh.write(new_content)
os.chmod(precommit, 0o755)
print("  hooks/pre-commit: conflict-marker guard and ledger regeneration installed")
PY

# --- 3. SessionStart: rulecheck without being asked --------------------------
SETTINGS=".claude/settings.json"
mkdir -p .claude
python3 - "$SETTINGS" "$RULES_DIR" <<'PY'
import json, os, sys
path, rules = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(path))
except Exception:
    d = {}
hooks = d.setdefault("hooks", {})
entries = hooks.setdefault("SessionStart", [])
cmd = f"{rules}/bin/rulecheck --quiet"
already = json.dumps(entries).find("rulecheck") >= 0
if not already:
    entries.append({"hooks": [{"type": "command", "command": cmd}]})
    json.dump(d, open(path, "w"), indent=2)
    print("  .claude/settings.json: SessionStart rulecheck installed")
else:
    print("  .claude/settings.json: SessionStart rulecheck already present")
PY

# --- 4. seed the project-owned prose ------------------------------------------
#
# Only the files a project fills in and keeps are seeded here: HANDOFF.md,
# docs/OPERATING-RULES.md, docs/handovers/lead-prompt.md. templates/ledger.json,
# brief.md and checkpoint.md are never copied into a project -- a ledger is
# created per proposal, the checkpoint is generated by the hooks below, and
# the brief is filled per agent, so a copy of any of them here would just
# drift from the source the tools actually read. Never overwrites: once a
# project has its own HANDOFF.md, this never touches it again, however far
# the template has moved on since.
PROJECT_NAME="$(basename "$TOP")"
TODAY="$(date +%Y-%m-%d)"
seed_prose() {
    local src="$1" dest="$2"
    mkdir -p "$(dirname "$dest")"
    if [ -f "$dest" ]; then
        echo "  $dest exists, left alone"
        return
    fi
    python3 - "$src" "$dest" "$PROJECT_NAME" "$TODAY" <<'PY'
import sys
src, dest, project, date = sys.argv[1:5]
text = open(src).read().replace("{{PROJECT}}", project).replace("{{DATE}}", date)
with open(dest, "w") as fh:
    fh.write(text)
PY
    echo "  seeded $dest"
}
seed_prose "$RULES_DIR/templates/HANDOFF.md" "HANDOFF.md"
seed_prose "$RULES_DIR/templates/OPERATING-RULES.md" "docs/OPERATING-RULES.md"
# A project that already keeps a lead prompt anywhere under docs/ gets no
# generic one: two lead prompts leave a later session choosing between them.
# The PhotoVault engine keeps docs/handovers/2026-09-13-proposal-71-lead-prompt.md;
# the PhotoVault app keeps docs/proposals/70-lead-prompt.md and has no
# handovers/ folder at all, which a handovers-only look missed (13 Sep).
existing_prompt="$(find docs -maxdepth 3 -type f -name '*lead-prompt*.md' ! -path 'docs/handovers/lead-prompt.md' 2>/dev/null | sort | head -1 || true)"
if [ -n "$existing_prompt" ] && [ ! -f docs/handovers/lead-prompt.md ]; then
    echo "  docs/handovers/lead-prompt.md not seeded -- this project already keeps $existing_prompt"
else
    seed_prose "$RULES_DIR/templates/lead-prompt.md" "docs/handovers/lead-prompt.md"
fi

# --- 5. checkpoint hooks: PreCompact, Stop, SessionStart, PostToolUse --------
#
# Closes the checkpoint loop (proposal 19, D8): PreCompact writes the
# checkpoint before Claude Code's own summary replaces context; Stop
# refreshes it after every turn; SessionStart points a fresh session at the
# ledger instead of the summary it just lost. Same "match, not merely add"
# idempotence as the rulecheck hook above (issue #57): ours is identified by
# the path suffix /hooks/<name>, so a hook entry left over from a relocated
# or renamed clone of common-rules gets its command corrected in place
# rather than duplicated.
#
# posttooluse-agent (proposal 20, D13 part 2 / V-05) rides the same
# install-and-correct logic, plus a `matcher`: the Agent/Task tool's own hook
# name is undocumented anywhere Claude Code publishes, so the matcher is
# `Agent|Task` and the hook itself filters further. A stale matcher, like a
# stale command, is corrected in place rather than left alone.
python3 - "$SETTINGS" "$RULES_DIR" <<'PY'
import json, sys
path, rules = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(path))
except Exception:
    d = {}
hooks = d.setdefault("hooks", {})
changed = False

HOOKS_TO_INSTALL = (
    ("precompact", "PreCompact", None),
    ("stop", "Stop", None),
    ("sessionstart", "SessionStart", None),
    ("posttooluse-agent", "PostToolUse", "Agent|Task"),
)

for name, event, matcher in HOOKS_TO_INSTALL:
    entries = hooks.setdefault(event, [])
    cmd = f"{rules}/hooks/{name}"
    suffix = f"/hooks/{name}"
    status = None
    for entry in entries:
        for h in entry.get("hooks", []):
            command = h.get("command", "")
            if not command.endswith(suffix):
                continue
            cmd_changed = command != cmd
            matcher_changed = matcher is not None and entry.get("matcher") != matcher
            if cmd_changed:
                h["command"] = cmd
            if matcher_changed:
                entry["matcher"] = matcher
            status = "corrected" if (cmd_changed or matcher_changed) else "already present"
            break
        if status:
            break
    if status is None:
        new_entry = {"hooks": [{"type": "command", "command": cmd}]}
        if matcher is not None:
            new_entry["matcher"] = matcher
        entries.append(new_entry)
        status = "installed"
        changed = True
    if status == "corrected":
        changed = True
    print(f"  .claude/settings.json: {event} {name} hook {status}")

if changed:
    json.dump(d, open(path, "w"), indent=2)
PY

# --- 6. the /warmup skill: kept identical to common-rules', not seeded once --
#
# Claude Code loads a project's skills from <project>/.claude/skills/<name>/
# SKILL.md. The skill is common-rules' file, not the project's, so a project
# must not keep a divergent copy: this MATCHES the source, the same principle
# as the .gitattributes rules and the hooks above, not a one-time seed like
# step 4's prose. Only .claude/skills/warmup/SKILL.md is ever touched here --
# every other file and directory under .claude/skills is left exactly alone.
SKILL_SRC="$RULES_DIR/skills/warmup/SKILL.md"
SKILL_DEST=".claude/skills/warmup/SKILL.md"
if [ ! -f "$SKILL_SRC" ]; then
    echo "  /warmup skill not found in $RULES_DIR/skills/warmup -- skipped"
elif [ ! -f "$SKILL_DEST" ]; then
    mkdir -p "$(dirname "$SKILL_DEST")"
    cp "$SKILL_SRC" "$SKILL_DEST"
    echo "  $SKILL_DEST: installed"
elif cmp -s "$SKILL_SRC" "$SKILL_DEST"; then
    echo "  $SKILL_DEST: already current"
else
    cp "$SKILL_SRC" "$SKILL_DEST"
    echo "  $SKILL_DEST: corrected"
fi

# --- 7. .gitignore: Ruflo runtime state only, not its config (D13, part 1) --
#
# Ruflo (claude-flow) is mandatory (proposal 19), so every project that runs
# it writes daemon state, logs, sessions and its vector/memory databases.
# Reuses exactly the lines PR #149 (ignore-ruflo-state) already named for
# this checkout, minus the blanket `.claude-flow/` -- shared Ruflo config
# (`.claude-flow/config*`, `claude-flow.config.json`) must stay tracked, so
# only its data/logs/sessions subdirectories are ignored, never the
# directory itself. Idempotent per line: each is added only if missing, and
# nothing already in a project's .gitignore is ever touched.
IGNORE_LINES=(
    ".claude-flow/data"
    ".claude-flow/logs"
    ".claude-flow/sessions"
    ".swarm/"
    "ruvector.db"
    ".claude/memory.db"
    ".claude/proven-config.json"
    ".claude/.proven-config-version"
)
touch .gitignore
gi_added=0
for line in "${IGNORE_LINES[@]}"; do
    if grep -qxF -- "$line" .gitignore; then
        continue
    fi
    printf '%s\n' "$line" >> .gitignore
    gi_added=$((gi_added + 1))
done
if [ "$gi_added" -gt 0 ]; then
    echo "  .gitignore: $gi_added Ruflo runtime line(s) added"
else
    echo "  .gitignore: Ruflo runtime lines already present"
fi

# An ignore line does nothing for a path git already tracks (V-07 round 2,
# finding 5) -- so say so, and name exactly what to run, rather than either
# silently leaving a false impression that Ruflo state is now out of git, or
# untracking it ourselves. Scoped to our own lines, not the whole
# .gitignore, so an unrelated ignore rule with tracked matches stays quiet.
already_tracked=""
for line in "${IGNORE_LINES[@]}"; do
    pathspec="${line%/}"
    matches=$($GIT ls-files -- "$pathspec")
    if [ -n "$matches" ]; then
        already_tracked="$already_tracked
$matches"
    fi
done
already_tracked=$(printf '%s\n' "$already_tracked" | sed '/^$/d' | sort -u)
if [ -n "$already_tracked" ]; then
    n=$(printf '%s\n' "$already_tracked" | grep -c .)
    echo "derecord: $n Ruflo runtime file(s) are already tracked; the ignore lines do not untrack them. To untrack (the files stay on disk): git rm -r --cached <paths>"
    printf '%s\n' "$already_tracked" | sed 's/^/    /'
fi

echo "derecord: $TOP is done."

# --- the ordering trap, surfaced rather than left in a comment ---------------
# Whoever just ran this is precisely the person about to merge with the rules
# not yet in effect. Say so, but only when it actually applies: if
# .gitattributes is already committed and unmodified, there is nothing to warn
# about and a standing warning would just be noise to scroll past.
if ! $GIT diff --quiet -- .gitattributes 2>/dev/null \
   || ! $GIT ls-files --error-unmatch .gitattributes >/dev/null 2>&1; then
    cat >&2 <<'NOTE'

  NOTE: commit .gitattributes on its own before your next merge.
  git reads .gitattributes as of the merge's starting state, so a merge that is
  itself delivering the file runs without it -- your next merge would still
  conflict on CHANGELOG.md and look like the union rules do not work.

      git add .gitattributes && git commit -m "union-merge the record files"

  Merges after that commit get the union rules for real.
NOTE
fi
