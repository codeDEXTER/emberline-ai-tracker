#!/usr/bin/env bash
# derecord -- make a project's record files structurally unable to conflict,
# and install the guards that stop a bad merge reaching main.
#
#   derecord [project-dir]     default: current directory
#
# Installs six things:
#   1. .gitattributes merge rules for the record files
#   2. a pre-commit hook that refuses to commit conflict markers
#   3. a SessionStart hook that runs rulecheck --quiet
#   4. the project-owned prose (HANDOFF.md, docs/OPERATING-RULES.md,
#      docs/handovers/lead-prompt.md), seeded from templates/ only where a
#      project does not already have its own copy
#   5. the PreCompact, Stop and SessionStart checkpoint hooks (proposal 19,
#      D8) that close the checkpoint loop
#   6. the /warmup skill (proposal 19, D1), kept identical to common-rules'
#      copy rather than seeded once and left to drift
#
# Idempotent, and in the strong sense: running it makes the project MATCH the
# shared rules, rather than merely not adding the same line twice. A rule whose
# value changed upstream is rewritten in place. That distinction is the whole of
# issue #57 -- the weak version froze every value at whatever it was when the
# project first adopted, and reported success while doing it.
#
# ONE ORDERING TRAP, and it bites exactly once per branch:
#
#   git reads .gitattributes as of the merge's STARTING state. A merge that is
#   itself delivering .gitattributes therefore runs without it, so the first
#   merge after installing still conflicts on CHANGELOG.md -- which looks like
#   the union rules do not work, when in fact they are not in effect yet.
#
#   Commit .gitattributes on its own, first, then merge. Hit on 2026-08-06
#   bringing a long-lived branch up to date: the merge conflicted, and the
#   identical merge succeeded with zero conflicts once the file had landed in
#   a commit of its own beforehand. The check at the bottom of this script
#   prints that reminder whenever it leaves the file uncommitted.
set -euo pipefail

RULES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJ="${1:-$PWD}"
cd "$PROJ"

GIT="git"
command -v git >/dev/null 2>&1 || GIT=/Library/Developer/CommandLineTools/usr/bin/git
$GIT rev-parse --git-dir >/dev/null 2>&1 || { echo "not a git repo: $PROJ" >&2; exit 1; }

TOP="$($GIT rev-parse --show-toplevel)"
cd "$TOP"

# --- 1. merge rules for the record files -------------------------------------
#
# This used to ask "is there a line for this path?" and nothing more, so once a
# pattern was present its value was frozen forever: changing a rule in
# gitattributes-for-projects silently failed to reach any project that had
# already run derecord, and the script still reported success. It bit for real
# when AGENT-LOG.md moved from merge=union to merge=ours (proposal 08) --
# pockets kept union-merging a file that is now generated output, which would
# interleave two generated tables into a file that is neither side's truth.
#
# So the check is now "is there a line for this path WITH THIS VALUE?", and a
# stale value is rewritten in place rather than left alone. Local lines for
# patterns we say nothing about are never touched.
touch .gitattributes
python3 - ".gitattributes" "$RULES_DIR/gitattributes-for-projects" <<'PY'
import sys

target, source = sys.argv[1], sys.argv[2]

def split(line):
    """(pattern, attributes) for a rule line, or None for blank/comment."""
    s = line.strip()
    if not s or s.startswith("#"):
        return None
    parts = s.split()
    return parts[0], " ".join(parts[1:])

rules = [r for r in (split(l) for l in open(source)) if r]
lines = open(target).read().splitlines()

added = corrected = 0
for pat, attrs in rules:
    for i, line in enumerate(lines):
        cur = split(line)
        if not cur or cur[0] != pat:
            continue
        if cur[1] != attrs:
            lines[i] = f"{pat}      {attrs}"
            corrected += 1
        break
    else:
        lines.append(f"{pat}      {attrs}")
        added += 1

if added or corrected:
    with open(target, "w") as fh:
        fh.write("\n".join(lines).rstrip("\n") + "\n")

bits = []
if added:     bits.append(f"{added} added")
if corrected: bits.append(f"{corrected} corrected")
print("  .gitattributes: " + (", ".join(bits) if bits else "already matches the shared rules"))
PY

# --- merge drivers: what git needs, and what actively breaks it --------------
#
# `union` is BUILT IN and must be left alone. An earlier version of this script
# ran `git config merge.union.name "..."`, meaning it as a cosmetic label. It is
# not cosmetic: defining merge.union.* declares a *custom* driver called "union"
# that shadows the built-in, and a custom driver with no `.driver` command makes
# git abort with
#
#     fatal: custom merge driver union lacks command line.
#
# So the line intended to help made every merge touching a record file fail
# outright. Measured 2026-08-06: finance-tracker -- the only project that had
# derecord installed -- carried that setting, and reproducing it fataled a
# CHANGELOG merge. Removed here, and unset below for anyone who already has it.
$GIT config --unset merge.union.name 2>/dev/null || true
$GIT config --unset merge.union.driver 2>/dev/null || true

# `ours`, by contrast, is NOT built in and does need a driver. Without one,
# `.common-rules-version merge=ours` silently degrades to an ordinary merge --
# demonstrated the same day: two branches each writing that file left
# `<<<<<<< HEAD` in it, which is the exact failure these rules exist to
# prevent, in the file recording which rules you are on. `driver true` runs
# /usr/bin/true: it succeeds and leaves our version in place.
$GIT config merge.ours.driver true

# --- 2. pre-commit: never commit a conflict marker ---------------------------
HOOKS="$($GIT rev-parse --git-path hooks)"
mkdir -p "$HOOKS"
cat > "$HOOKS/pre-commit" <<'HOOK'
#!/usr/bin/env bash
# Refuse to commit unresolved conflict markers. On 2026-08-05 a hand-rolled
# conflict resolver put `<<<<<<< HEAD` into three Python files and main
# stopped importing at all. This is the cheapest possible guard against it.
set -euo pipefail
GIT=git; command -v git >/dev/null 2>&1 || GIT=/Library/Developer/CommandLineTools/usr/bin/git
bad=$($GIT diff --cached --name-only --diff-filter=ACM | while read -r f; do
    [ -f "$f" ] || continue
    if $GIT show ":$f" 2>/dev/null | grep -qE '^(<{7}|={7}|>{7})( |$)'; then echo "$f"; fi
done)
if [ -n "$bad" ]; then
    echo "pre-commit: unresolved conflict markers in:" >&2
    echo "$bad" | sed 's/^/  /' >&2
    echo "resolve them, or commit with --no-verify if you truly mean it." >&2
    exit 1
fi
HOOK
chmod +x "$HOOKS/pre-commit"
echo "  hooks/pre-commit: conflict-marker guard installed"

# --- 3. SessionStart: rulecheck without being asked --------------------------
SETTINGS=".claude/settings.json"
mkdir -p .claude
python3 - "$SETTINGS" "$RULES_DIR" <<'PY'
import json, os, sys
path, rules = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(path))
except Exception:
    d = {}
hooks = d.setdefault("hooks", {})
entries = hooks.setdefault("SessionStart", [])
cmd = f"{rules}/bin/rulecheck --quiet"
already = json.dumps(entries).find("rulecheck") >= 0
if not already:
    entries.append({"hooks": [{"type": "command", "command": cmd}]})
    json.dump(d, open(path, "w"), indent=2)
    print("  .claude/settings.json: SessionStart rulecheck installed")
else:
    print("  .claude/settings.json: SessionStart rulecheck already present")
PY

# --- 4. seed the project-owned prose ------------------------------------------
#
# Only the files a project fills in and keeps are seeded here: HANDOFF.md,
# docs/OPERATING-RULES.md, docs/handovers/lead-prompt.md. templates/ledger.json,
# brief.md and checkpoint.md are never copied into a project -- a ledger is
# created per proposal, the checkpoint is generated by the hooks below, and
# the brief is filled per agent, so a copy of any of them here would just
# drift from the source the tools actually read. Never overwrites: once a
# project has its own HANDOFF.md, this never touches it again, however far
# the template has moved on since.
PROJECT_NAME="$(basename "$TOP")"
TODAY="$(date +%Y-%m-%d)"
seed_prose() {
    local src="$1" dest="$2"
    mkdir -p "$(dirname "$dest")"
    if [ -f "$dest" ]; then
        echo "  $dest exists, left alone"
        return
    fi
    python3 - "$src" "$dest" "$PROJECT_NAME" "$TODAY" <<'PY'
import sys
src, dest, project, date = sys.argv[1:5]
text = open(src).read().replace("{{PROJECT}}", project).replace("{{DATE}}", date)
with open(dest, "w") as fh:
    fh.write(text)
PY
    echo "  seeded $dest"
}
seed_prose "$RULES_DIR/templates/HANDOFF.md" "HANDOFF.md"
seed_prose "$RULES_DIR/templates/OPERATING-RULES.md" "docs/OPERATING-RULES.md"
seed_prose "$RULES_DIR/templates/lead-prompt.md" "docs/handovers/lead-prompt.md"

# --- 5. checkpoint hooks: PreCompact, Stop, SessionStart ----------------------
#
# Closes the checkpoint loop (proposal 19, D8): PreCompact writes the
# checkpoint before Claude Code's own summary replaces context; Stop
# refreshes it after every turn; SessionStart points a fresh session at the
# ledger instead of the summary it just lost. Same "match, not merely add"
# idempotence as the rulecheck hook above (issue #57): ours is identified by
# the path suffix /hooks/<name>, so a hook entry left over from a relocated
# or renamed clone of common-rules gets its command corrected in place
# rather than duplicated.
python3 - "$SETTINGS" "$RULES_DIR" <<'PY'
import json, sys
path, rules = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(path))
except Exception:
    d = {}
hooks = d.setdefault("hooks", {})
changed = False

for name, event in (("precompact", "PreCompact"), ("stop", "Stop"), ("sessionstart", "SessionStart")):
    entries = hooks.setdefault(event, [])
    cmd = f"{rules}/hooks/{name}"
    suffix = f"/hooks/{name}"
    status = None
    for entry in entries:
        for h in entry.get("hooks", []):
            command = h.get("command", "")
            if command.endswith(suffix):
                if command == cmd:
                    status = "already present"
                else:
                    h["command"] = cmd
                    status = "corrected"
                    changed = True
                break
        if status:
            break
    if status is None:
        entries.append({"hooks": [{"type": "command", "command": cmd}]})
        status = "installed"
        changed = True
    print(f"  .claude/settings.json: {event} {name} hook {status}")

if changed:
    json.dump(d, open(path, "w"), indent=2)
PY

# --- 6. the /warmup skill: kept identical to common-rules', not seeded once --
#
# Claude Code loads a project's skills from <project>/.claude/skills/<name>/
# SKILL.md. The skill is common-rules' file, not the project's, so a project
# must not keep a divergent copy: this MATCHES the source, the same principle
# as the .gitattributes rules and the hooks above, not a one-time seed like
# step 4's prose. Only .claude/skills/warmup/SKILL.md is ever touched here --
# every other file and directory under .claude/skills is left exactly alone.
SKILL_SRC="$RULES_DIR/skills/warmup/SKILL.md"
SKILL_DEST=".claude/skills/warmup/SKILL.md"
if [ ! -f "$SKILL_SRC" ]; then
    echo "  /warmup skill not found in $RULES_DIR/skills/warmup -- skipped"
elif [ ! -f "$SKILL_DEST" ]; then
    mkdir -p "$(dirname "$SKILL_DEST")"
    cp "$SKILL_SRC" "$SKILL_DEST"
    echo "  $SKILL_DEST: installed"
elif cmp -s "$SKILL_SRC" "$SKILL_DEST"; then
    echo "  $SKILL_DEST: already current"
else
    cp "$SKILL_SRC" "$SKILL_DEST"
    echo "  $SKILL_DEST: corrected"
fi

echo "derecord: $TOP is done."

# --- the ordering trap, surfaced rather than left in a comment ---------------
# Whoever just ran this is precisely the person about to merge with the rules
# not yet in effect. Say so, but only when it actually applies: if
# .gitattributes is already committed and unmodified, there is nothing to warn
# about and a standing warning would just be noise to scroll past.
if ! $GIT diff --quiet -- .gitattributes 2>/dev/null \
   || ! $GIT ls-files --error-unmatch .gitattributes >/dev/null 2>&1; then
    cat >&2 <<'NOTE'

  NOTE: commit .gitattributes on its own before your next merge.
  git reads .gitattributes as of the merge's starting state, so a merge that is
  itself delivering the file runs without it -- your next merge would still
  conflict on CHANGELOG.md and look like the union rules do not work.

      git add .gitattributes && git commit -m "union-merge the record files"

  Merges after that commit get the union rules for real.
NOTE
fi
