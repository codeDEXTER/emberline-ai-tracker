#!/usr/bin/env python3
"""proposalcheck -- did a proposal that asked numbered decisions record the answers?

  proposalcheck [--project DIR]     default: nearest project above cwd

CLAUDE-workflow.md, "A proposal that asked numbered decisions must record the
answers": a decision date (`<meta name="proposal-decided">`) says *when* a
proposal was decided, and nothing about *what* -- measured in finance-tracker
(issue #584), 11 proposals `accepted`, 9 with a decision date, 3 recording
what was actually decided. `proposal-auditor` has nothing to measure a build
against without the answers, only the date.

A proposal "asks numbered decisions" when it carries a non-empty
`<ol class="decisions">` list -- the shape already in live use across several
of finance-tracker's proposals. Once a proposal reaches `accepted`,
`completed`, `completed in part`, or the grandfathered `built`, the answers
must live in the *same document*, in a block carrying `id="decided"` --
proposal 18 (portfolio-pdf) already does exactly this by hand; this makes it
checkable rather than a habit that lapses.

A status of `completed in part` additionally requires an `id="exceptions"`
block beside the decisions: what was not built, and why. A partial-completion
status naming nothing is indistinguishable from quietly marking something
done -- that block is what keeps it honest.

GRANDFATHERED BY DATE, NOT BY LIST. A proposal decided before EFFECTIVE_DATE,
or carrying no `proposal-decided` date at all, is exempt from the
answers-recorded check. finance-tracker alone has 8 accepted proposals whose
answers are unrecoverable; inventing them after the fact would misstate
history worse than the gap does, and a test that fails on day one against
documents nobody can fix gets disabled -- so the floor is today, and
enforcement is forward-only. An undated proposal reads the same as "decided
before this rule existed", not as a loophole for a new one to leave the meta
off. `completed in part` is new vocabulary with nothing existing to
grandfather, so its exceptions requirement is not date-gated.

CLAUDE-workflow.md, "A document is either a proposal or an artifact":
measured across finance-tracker, pip and pockets while adding new proposal
content (2026-08-20) -- three real proposal-number collisions turned up
along the way, and separately, nothing had ever checked whether a document
claiming to BE a proposal (not a `part-of` section) actually carried a
status at all. Two finance-tracker part-of sections had spent their whole
history with no meta status and a mockup title informally borrowing their
lead's status word -- harmless, because the convention was already "a
section carries no status of its own", just never made checkable. This adds
the other half: a **lead** (a document with no `proposal-part-of`) must
carry a `proposal-status` from the known vocabulary
(`proposed`/`accepted`/`completed`/`completed in part`/`built`/`amends
NN`/`superseded by NN`) -- a lead with no status, or a typo'd one
(`superseded-by` for `superseded by`, found live in pockets), is exactly the
gap `proposal-auditor` and this project's own generated index have nothing
to measure against. A `part-of` document carrying its OWN status is the
mirror violation: a section pretending to a decision it doesn't have.

GRANDFATHERED THE SAME WAY, A SEPARATE FLOOR. `STATUS_EFFECTIVE_DATE` is its
own constant, not reused from the decisions-recorded rule above, because it
is a different rule written on a different day. pockets' typo'd status and
pip's two undated leads are both grandfathered by it today -- zero blocked
across every adopting project at the time this landed, same standard as the
rule above.

PROPOSAL 21, "THE STANDARD IS MANDATORY" (row S-03): the lead-with-no-status
check above only fires when the page carries a `proposal-decided` date on or
after STATUS_EFFECTIVE_DATE -- and a page with no status meta at all
typically has no decided meta either, so it reads as undated and is silently
grandfathered regardless of how new it actually is. PhotoVault's app
proposals 72, 75 and 76, and the engine's 77, all carry no status meta and no
decided date, and all passed unchecked. This adds a second, independent
check for exactly that gap: a lead that carries NO `proposal-status` meta at
all is a violation if the page itself -- not its undecided content -- is new,
measured by when it was first added to git rather than by a hand-maintained
declaration, because a floor nobody has to remember to update is a floor
nobody forgets to set. `NEW_PROPOSAL_FLOOR` is its own constant, a third
rule written on a third day. Grandfathered by the same "date, not list" rule
as everything else here: a page first added to git before the floor is
exempt, silently, forever. A page not yet committed cannot use that
exemption -- it has no "first added" date to be older than the floor, so it
reads as new. OUTSIDE A GIT REPOSITORY THIS CHECK NEVER FIRES: with no git
history to ask, "when was this page first added" has no answer, so today's
behaviour (nothing new flagged) holds rather than guessing.

Exit codes: 0 clean. 1 violations found. 2 nothing to check (no
docs/proposals/ under the project).
"""
from __future__ import annotations

import argparse
import re
import subprocess
import sys
from pathlib import Path

# The day this rule was written. Nothing decided before it is checked -- see
# the module docstring's "GRANDFATHERED BY DATE" section for why a floor
# rather than a hand-maintained exemption list.
EFFECTIVE_DATE = "2026-08-19"

# The day the "lead must carry a known status" rule was written -- its own
# floor, not reused from EFFECTIVE_DATE above, because it is a distinct rule.
STATUS_EFFECTIVE_DATE = "2026-08-20"

# The day proposal 21 ("the standard is mandatory") made bin/new-proposal the
# only way to create a proposal page. A lead first added to git on or after
# this date must carry a proposal-status -- see the module docstring's
# "PROPOSAL 21" section for why this is gated by the page's own git history
# rather than by its (often-absent) proposal-decided date.
NEW_PROPOSAL_FLOOR = "2026-09-14"

# proposed / accepted / completed / completed in part / built (grandfathered
# synonym), or the two parameterized cross-reference forms. A lead's status
# must match this whole-string shape -- CLAUDE-workflow.md's own vocabulary,
# made checkable rather than left to eyeballing.
KNOWN_STATUS_RE = re.compile(
    r"^(proposed|accepted|completed|completed in part|built"
    r"|amends \d+|superseded by \d+)$"
)

# Statuses under which a proposal that asked decisions must have recorded the
# answers. `proposed` is deliberately excluded -- a proposal still being
# negotiated is expected to have open decisions.
DECISION_STATUSES = {"accepted", "completed", "completed in part", "built"}


def meta(text: str, name: str) -> str | None:
    m = re.search(rf'<meta name="proposal-{name}" content="([^"]*)">', text)
    return m.group(1) if m else None


def asks_decisions(text: str) -> bool:
    """Does this document carry a non-empty <ol class="decisions"> list?

    An empty list literally asks nothing -- "did it ask?" is the mechanical
    test, not "how big is it", so a placeholder <ol class="decisions"></ol>
    does not trigger the requirement.
    """
    m = re.search(r'<ol\s+class="decisions">(.*?)</ol>', text, re.S)
    return bool(m and "<li" in m.group(1))


def records_answers(text: str) -> bool:
    return bool(re.search(r'\bid="decided"', text))


def records_exceptions(text: str) -> bool:
    return bool(re.search(r'\bid="exceptions"', text))


def grandfathered(decided: str | None, floor: str = EFFECTIVE_DATE) -> bool:
    """True if this proposal predates `floor`, or never carried a date.

    ISO dates (YYYY-MM-DD) sort correctly as plain strings, so a lexical
    comparison is exact -- no date parsing needed. `floor` defaults to
    EFFECTIVE_DATE (the decisions-recorded rule's own floor); the
    status-required rule below passes its own, later floor explicitly,
    because it is a different rule written on a different day.
    """
    if not decided:
        return True
    return decided < floor


def first_added_is_new(path: Path, floor: str = NEW_PROPOSAL_FLOOR) -> bool:
    """True if `path` counts as "new" for the no-status-meta rule: inside a
    git repository, and either not yet committed or first added to git on
    or after `floor`. False when there is no git repository above `path` at
    all -- read-only, no fallback guess, matches "outside a git repository,
    keep today's behaviour" in the module docstring.

    "First added" is `git log --diff-filter=A --follow`, oldest match, so a
    rename or a move does not reset the clock. A path with no "A" record at
    all -- never committed, or git's rename detection did not attribute one
    -- is new by construction: a proposal cannot dodge this rule by staying
    uncommitted.
    """
    inside = subprocess.run(
        ["git", "-C", str(path.parent), "rev-parse", "--is-inside-work-tree"],
        capture_output=True, text=True, check=False,
    )
    if inside.returncode != 0 or inside.stdout.strip() != "true":
        return False

    log = subprocess.run(
        ["git", "-C", str(path.parent), "log", "--diff-filter=A", "--follow",
         "--format=%aI", "--", path.name],
        capture_output=True, text=True, check=False,
    )
    added_dates = sorted(line[:10] for line in log.stdout.splitlines() if line.strip())
    if not added_dates:
        return True
    return added_dates[0] >= floor


def is_lead(text: str) -> bool:
    """A lead is a document with no `proposal-part-of` -- the one thing in
    its topic that carries an independent status and a decision. Everything
    else is a section: supporting material with nothing of its own to
    decide (CLAUDE-workflow.md, "A document is either a proposal or an
    artifact")."""
    return meta(text, "part-of") is None


def check_proposal(path: Path, text: str) -> list[str]:
    """Violations for one proposal document, or an empty list."""
    violations = []
    status = meta(text, "status")
    decided = meta(text, "decided")

    if status in DECISION_STATUSES and asks_decisions(text) and not records_answers(text):
        if not grandfathered(decided):
            violations.append(
                f'asks numbered decisions (<ol class="decisions">) and is '
                f'"{status}", but records no answers (no id="decided" block) -- '
                f'decided {decided}, on or after the {EFFECTIVE_DATE} floor'
            )

    if status == "completed in part" and not records_exceptions(text):
        violations.append(
            'status is "completed in part" but carries no id="exceptions" '
            'block naming what was not built and why'
        )

    lead = is_lead(text)
    if lead:
        if status is None:
            if not grandfathered(decided, floor=STATUS_EFFECTIVE_DATE):
                violations.append(
                    'is a lead (no proposal-part-of) but carries no proposal-status at '
                    f'all -- decided {decided}, on or after the {STATUS_EFFECTIVE_DATE} floor'
                )
            # Proposal 21 (S-03): a page with no status meta usually has no
            # decided meta either, so the check above reads it as undated and
            # grandfathers it regardless of how new it actually is. This is
            # gated by the page's own git history instead.
            if first_added_is_new(path):
                violations.append(
                    'carries no proposal status -- create proposals with '
                    'bin/new-proposal (common-rules proposal 21)'
                )
        elif not KNOWN_STATUS_RE.match(status):
            if not grandfathered(decided, floor=STATUS_EFFECTIVE_DATE):
                violations.append(
                    f'is a lead (no proposal-part-of) with status "{status}", which matches '
                    f'none of the known vocabulary (proposed/accepted/completed/completed in '
                    f'part/built/amends NN/superseded by NN) -- decided {decided}, on or '
                    f'after the {STATUS_EFFECTIVE_DATE} floor'
                )
    else:
        if status is not None:
            violations.append(
                f'carries proposal-part-of (a section, not a lead) but also claims its own '
                f'status ("{status}") -- a section has no decision of its own to track'
            )

    return violations


def collisions(documents: list[tuple[Path, str]]) -> list[str]:
    """Violations for proposal numbers claimed by more than one document.

    CLAUDE-workflow.md, "Number every proposal": numbered sequentially per
    project, *never reused*. Nothing checked the second half. Three collisions
    already existed in finance-tracker (ids 14, 15 and 20) and were found only
    because someone was reading every proposal for an unrelated reason -- both
    documents of every colliding pair passed every check this tool had.

    A collision is worse than an ordinary violation because it breaks every
    reference *to* a proposal at once: `proposal-part-of` names an id, the
    shared rules cite proposals by number, and the Tower groups a topic's
    pages by it. When two documents answer to "14", each of those is ambiguous
    and nothing says so.

    NOT GRANDFATHERED, unlike every other rule here, and the difference is in
    kind rather than in leniency. The other rules are grandfathered because a
    proposal's history cannot be honestly reconstructed after the fact --
    inventing the answers would misstate it worse than the gap does. A
    collision is a live ambiguity, not a missing record, and renumbering fixes
    it exactly. Measured when this landed: zero collisions across every
    adopting project, one in common-rules itself.

    A document carrying no `proposal-id` at all does not participate. Absent
    is not a value -- pip's 02a/02b are two sections with no id, and bucketing
    them together would fail a project on day one for a rule about *reuse*,
    which is how a check gets disabled.
    """
    claimed: dict[str, list[str]] = {}
    for path, text in documents:
        pid = meta(text, "id")
        if pid is None:
            continue
        claimed.setdefault(pid, []).append(path.name)

    return [f'proposal id "{pid}" is claimed by {len(names)} documents: '
            + ", ".join(sorted(names))
            # One line per id, not one per document: a two-way collision is
            # one thing wrong, and counting it twice inflates the total.
            for pid, names in sorted(claimed.items()) if len(names) > 1]


def find_project(start: Path) -> Path:
    """Nearest ancestor holding a CLAUDE.md or a .git -- same shape as rulecheck."""
    p = start.resolve()
    for d in (p, *p.parents):
        if (d / "CLAUDE.md").exists() or (d / ".git").exists():
            return d
    return p


def main() -> int:
    ap = argparse.ArgumentParser(prog="proposalcheck", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--project", default=None, help="default: nearest project above cwd")
    a = ap.parse_args()

    proj = Path(a.project).resolve() if a.project else find_project(Path.cwd())
    proposals_dir = proj / "docs" / "proposals"
    if not proposals_dir.is_dir():
        print(f"{proj.name}: no docs/proposals/ -- nothing to check.")
        return 2

    documents = [(path, path.read_text(encoding="utf-8", errors="replace"))
                 for path in sorted(proposals_dir.glob("*.html"))]

    total_violations = 0
    for path, text in documents:
        for v in check_proposal(path, text):
            print(f"{path.name}: {v}")
            total_violations += 1

    # Project-level, so it runs over the whole set rather than per document.
    for v in collisions(documents):
        print(v)
        total_violations += 1

    if total_violations:
        print(f"\n{total_violations} violation(s) in {proj.name}.")
        return 1

    # Say what was actually looked at, not what the rule is about. This line
    # read "every proposal that asked decisions recorded them" whatever it had
    # examined -- and across common-rules' own proposals, none carries a
    # decisions list, so it was vacuously true for the tool's whole life while
    # reading as a clean pass. The exit code already separates "checked and
    # clean" from "could not check" (2); the sentence a person reads did not
    # separate "checked and clean" from "there was nothing to check".
    asked = sum(1 for _, text in documents if asks_decisions(text))
    print(f"{proj.name}: {len(documents)} proposal(s), {asked} asked decisions "
          f"-- no violations.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
