<script>
const D=__DATA__;
const LB=__LABELS__;
const tl=document.getElementById('tl');
let mode='all', openAll=false, lane='*';
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function render(){
  tl.innerHTML='';
  let list = mode==='get' ? D.filter(x=>x.deliver) : D;
  if(lane!=='*') list=list.filter(x=>(x.tr||'')===lane);
  if(!list.length){tl.innerHTML='<p class="stand">Nothing here under this filter.</p>';return}
  list.forEach(x=>{
    const ev=document.createElement('div');
    ev.className='ev s-'+x.s+(x.deliver?' deliver':'');
    ev.innerHTML='<span class="sp"><span class="dot"></span></span>'+
      '<div class="card"><div class="row">'+
      '<span class="ttl" tabindex="0" role="button" aria-expanded="'+openAll+'">'+esc(x.t)+'</span>'+
      '<span class="tag g-'+x.s+'">'+esc(LB[x.s]||x.s)+'</span>'+
      (x.tr&&lane==='*'?'<span class="tag g-track">'+esc(x.tr)+'</span>':'')+
      (x.deliver?'<span class="tag g-get">you get something</span>':'')+
      '</div><div class="detail'+(openAll?'':' hidden')+'">'+
      '<div class="band pv"><b>proves</b>'+esc(x.pv)+'</div>'+
      (x.gt?'<div class="band gt"><b>you get</b>'+esc(x.gt)+'</div>':'')+
      '</div></div>';
    const t=ev.querySelector('.ttl'), det=ev.querySelector('.detail');
    const toggle=()=>{det.classList.toggle('hidden');
      t.setAttribute('aria-expanded',!det.classList.contains('hidden'))};
    t.addEventListener('click',toggle);
    t.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();toggle()}});
    tl.appendChild(ev);
    if(mode==='all'&&x.s==='now'){const h=document.createElement('div');
      h.className='here';h.textContent='You are here';tl.appendChild(h)}
  });
}
function meter(){
  const proven=D.filter(x=>x.s==='done'||x.s==='built').length;
  document.getElementById('m1').textContent=proven+' of '+D.length;
  const now=D.filter(x=>x.s==='now');
  document.getElementById('m2').textContent=now.length?now[0].t:'—';
  const del=D.filter(x=>x.deliver);
  const got=del.filter(x=>x.s==='done'||x.s==='built').length;
  document.getElementById('m3').textContent=del.length?got+' of '+del.length:'—';
  const nx=del.find(x=>x.s!=='done'&&x.s!=='built');
  document.getElementById('m4').textContent=nx?nx.gt:'—';
}
const bAll=document.getElementById('b-all'),bGet=document.getElementById('b-get'),
      bOpen=document.getElementById('b-open');
bAll.onclick=()=>{mode='all';bAll.setAttribute('aria-pressed','true');
  bGet.setAttribute('aria-pressed','false');render()};
bGet.onclick=()=>{mode='get';bGet.setAttribute('aria-pressed','true');
  bAll.setAttribute('aria-pressed','false');render()};
bOpen.onclick=()=>{openAll=!openAll;bOpen.setAttribute('aria-pressed',openAll);
  bOpen.textContent=openAll?'collapse all':'expand all';render()};
function tracks(){
  // Order of first appearance -- never sorted. A plan's lanes are listed in
  // the order the plan introduces them, the same way its rows are.
  const seen=[]; D.forEach(x=>{const k=x.tr||''; if(!seen.includes(k)) seen.push(k)});
  return seen;
}
function graph(){
  const g=document.getElementById('g'), L=36, R=688;
  const cs=getComputedStyle(document.documentElement), C=k=>cs.getPropertyValue(k).trim();
  const col=x=>C('--'+(x.s==='now'?'now':x.s));
  const TR=tracks(), multi=TR.length>1;
  // One lane per track. With a single (or unnamed) track this collapses to the
  // one rule it drew before tracks existed -- a project with no parallel work
  // should not pay for the concept in its picture.
  const labW = multi?96:0, x0=L+labW, top=multi?36:54, laneH=50;
  const H = multi ? top + TR.length*laneH + 26 : 104;
  g.setAttribute('viewBox','0 0 720 '+H);
  let s='';
  const maxN = Math.max(...TR.map(t=>D.filter(x=>(x.tr||'')===t).length));
  const step = maxN>1 ? (R-x0)/(maxN-1) : 0;
  TR.forEach((tr,li)=>{
    const rows=D.map((x,i)=>({x,i})).filter(o=>(o.x.tr||'')===tr);
    const y = multi ? top + li*laneH : 54;
    const n = rows.length;
    const laneEnd = x0 + step*(n-1);
    if(multi){
      s+='<text class="lane" x="'+(x0-10)+'" y="'+(y+3.5)+'" text-anchor="end">'+esc(tr||'—')+'</text>';
    }
    // A one-milestone lane gets a stub, not a full rule -- length is information.
    s+='<line x1="'+x0+'" y1="'+y+'" x2="'+(n>1?laneEnd:x0+14)+'" y2="'+y+
       '" stroke="'+C('--rule')+'" stroke-width="2"/>';
    const proven=rows.map((o,j)=>(o.x.s==='done'||o.x.s==='built')?j:-1).filter(j=>j>=0);
    if(proven.length) s+='<line x1="'+x0+'" y1="'+y+'" x2="'+(x0+step*proven[proven.length-1])+
      '" y2="'+y+'" stroke="'+C('--done')+'" stroke-width="2"/>';
    rows.forEach((o,j)=>{
      const cx=x0+step*j, x=o.x, c=col(x);
      const fill=(x.s==='done'||x.s==='built'||x.s==='now')?c:C('--ground');
      s+='<g class="tk" data-i="'+o.i+'"><title>'+esc((x.tr?x.tr+' · ':'')+x.t)+'</title>';
      s+='<rect class="hit" x="'+(cx-(step||24)/2)+'" y="'+(y-21)+'" width="'+(step||24)+
         '" height="42" fill="'+C('--ink')+'" opacity="0"/>';
      if(x.deliver){
        s+='<path d="M'+cx+','+(y-17)+' L'+(cx+5.5)+','+(y-11.5)+' L'+cx+','+(y-6)+
           ' L'+(cx-5.5)+','+(y-11.5)+' Z" fill="'+C('--get')+'"/>';
        s+='<line x1="'+cx+'" y1="'+(y-6)+'" x2="'+cx+'" y2="'+(y-3)+'" stroke="'+
           C('--get')+'" stroke-width="1"/>';
      }
      s+='<circle cx="'+cx+'" cy="'+y+'" r="'+(x.s==='now'?5.5:4)+'" fill="'+fill+
         '" stroke="'+c+'" stroke-width="1.6"/>';
      if(x.s==='now') s+='<circle cx="'+cx+'" cy="'+y+'" r="9" fill="none" stroke="'+
         c+'" stroke-width="1" opacity=".45"/>';
      if(x.s==='blocked'){
        s+='<line x1="'+(cx-3.2)+'" y1="'+(y-3.2)+'" x2="'+(cx+3.2)+'" y2="'+(y+3.2)+
           '" stroke="'+c+'" stroke-width="1.5"/>';
        s+='<line x1="'+(cx+3.2)+'" y1="'+(y-3.2)+'" x2="'+(cx-3.2)+'" y2="'+(y+3.2)+
           '" stroke="'+c+'" stroke-width="1.5"/>';
      }
      s+='</g>';
    });
    // Per lane, because with parallel work there is no single "here" -- each
    // track has its own front, and collapsing them to one would assert an
    // ordering between lanes that the plan does not claim.
    const nowJ=rows.findIndex(o=>o.x.s==='now');
    if(nowJ>=0) s+='<text class="lg" x="'+(x0+step*nowJ)+'" y="'+(y+19)+
      '" text-anchor="middle" fill="'+C('--now')+'">'+(multi?'here':'you are here')+'</text>';
    const fd=rows.findIndex(o=>o.x.deliver&&o.x.s!=='done'&&o.x.s!=='built');
    if(fd>=0&&!multi) s+='<text class="lg" x="'+(x0+step*fd)+'" y="'+(y-25)+
      '" text-anchor="middle" fill="'+C('--get')+'">next in your hands</text>';
  });
  if(!multi){
    s+='<text class="cap" x="'+x0+'" y="'+(54+32)+'">'+esc(D[0].t.slice(0,30))+'</text>';
    s+='<text class="cap" x="'+R+'" y="'+(54+32)+'" text-anchor="end">'+
       esc(D[D.length-1].t.slice(0,30))+'</text>';
  }
  g.innerHTML=s;
  g.querySelectorAll('.tk').forEach(el=>el.addEventListener('click',()=>{
    const i=+el.dataset.i;
    if(mode==='get'&&!D[i].deliver) bAll.click();
    if(lane!=='*'&&(D[i].tr||'')!==lane){lane='*';syncLanes();render();}
    const target=[...document.querySelectorAll('.ev')]
      .find(r=>r.querySelector('.ttl').textContent===D[i].t);
    if(target){target.querySelector('.detail').classList.remove('hidden');
      target.classList.add('flash');setTimeout(()=>target.classList.remove('flash'),1500);
      target.scrollIntoView({behavior:'smooth',block:'center'});}
  }));
}
function syncLanes(){
  [...document.querySelectorAll('#lanes button')].forEach(b=>
    b.setAttribute('aria-pressed', b.dataset.lane===lane));
}
(function buildLanes(){
  const TR=tracks();
  if(TR.length<2) return;           // no lanes worth filtering
  document.getElementById('lane-sep').hidden=false;
  const host=document.getElementById('lanes');
  [['*','all tracks'],...TR.map(t=>[t,t||'untracked'])].forEach(([v,label])=>{
    const b=document.createElement('button');
    b.dataset.lane=v; b.textContent=label;
    b.setAttribute('aria-pressed', v===lane);
    b.onclick=()=>{lane=v;syncLanes();render()};
    host.appendChild(b);
  });
})();
const _r=render; render=function(){_r();graph()};
meter();render();
</script>
"""


def digest(rows) -> str:
    """A fingerprint of the plan's content, so staleness is checkable.

    The generated page carries this in a meta tag and `bin/milestonecheck`
    recomputes it from the table. Comparing whole files would not work: the
    page stamps the time it was generated, so a byte comparison calls every
    page stale the moment the clock moves. Hashing the *data* asks the only
    question that matters -- does the picture still show this plan.
    """
    canon = json.dumps(rows, sort_keys=True, ensure_ascii=False, separators=(",", ":"))
    return hashlib.sha256(canon.encode("utf-8")).hexdigest()[:16]


DIGEST_RE = re.compile(r'<meta name="milestones-digest" content="([0-9a-f]+)"')


def page_digest(page: pathlib.Path) -> str | None:
    if not page.is_file():
        return None
    m = DIGEST_RE.search(page.read_text(encoding="utf-8", errors="replace"))
    return m.group(1) if m else None


def project_name(project: pathlib.Path) -> str:
    """The project's name, not the directory the command happened to run in.

    Every session works in `.worktrees/<task>`, so the directory basename there
    is the BRANCH name -- generating from a worktree titled three projects'
    pages "milestone-page — milestones". git knows the difference: the first
    entry of `worktree list` is always the main checkout, whatever worktree the
    question is asked from.
    """
    try:
        out = subprocess.run(["git", "-C", str(project), "worktree", "list", "--porcelain"],
                             capture_output=True, text=True, timeout=10)
        for line in out.stdout.splitlines():
            if line.startswith("worktree "):
                return pathlib.Path(line.split(" ", 1)[1]).name
    except Exception:
        pass
    return project.name


def build(project: pathlib.Path, rows) -> str:
    when = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    return (PAGE
            .replace("__NAME__", html.escape(project_name(project)))
            .replace("__WHEN__", when)
            .replace("__SRC__", "CLAUDE-checklist.md")
            .replace("__DIGEST__", digest(rows))
            .replace("__DATA__", json.dumps(rows, ensure_ascii=False))
            .replace("__LABELS__", json.dumps(STATE_LABEL)))


def check_one(project: pathlib.Path) -> int:
    """Is the generated page present, and does it still show this plan?"""
    checklist = project / "CLAUDE-checklist.md"
    if not checklist.is_file():
        return 2
    rows = parse(checklist)
    if not rows:
        # 2, not 1. A project with no usable `## Milestones` table has no
        # picture to be stale, and `bin/milestonecheck` already refuses it in
        # its own words. Returning 1 here made `land` refuse a second time with
        # an empty message -- the page gate reporting the plan gate's finding,
        # badly. This gate only speaks when there is a plan to draw.
        return 2
    page = project / "docs" / "milestones.html"
    want, have = digest(rows), page_digest(page)
    if have is None:
        print(f"milestones: {project_name(project)} has a milestone plan but no docs/milestones.html "
              f"-- run `common-rules/bin/milestones`", file=sys.stderr)
        return 1
    if have != want:
        print(f"milestones: {project_name(project)}'s docs/milestones.html is stale -- it shows "
              f"{have}, the plan is {want}. Run `common-rules/bin/milestones`.", file=sys.stderr)
        return 1
    return 0


def one(project: pathlib.Path, to_stdout=False) -> int:
    checklist = project / "CLAUDE-checklist.md"
    if not checklist.is_file():
        print(f"milestones: no CLAUDE-checklist.md under {project}", file=sys.stderr)
        return 2
    rows = parse(checklist)
    if not rows:
        print(f"milestones: {project_name(project)} has no usable `## Milestones` table -- "
              f"run bin/milestonecheck for the detail", file=sys.stderr)
        return 1
    page = build(project, rows)
    if to_stdout:
        sys.stdout.write(page)
        return 0
    out = project / "docs" / "milestones.html"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(page, encoding="utf-8")
    deliver = sum(1 for r in rows if r["deliver"])
    print(f"milestones: {project_name(project)} -- {len(rows)} milestones "
          f"({deliver} hand something over) -> {out}")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="milestones")
    ap.add_argument("--project", default=None)
    ap.add_argument("--all", action="store_true",
                    help="every project under apps/ that carries a milestone plan")
    ap.add_argument("--stdout", action="store_true")
    ap.add_argument("--check", action="store_true",
                    help="exit 1 if docs/milestones.html is missing or stale; write nothing")
    a = ap.parse_args()
    if a.all:
        worst = 0
        for d in sorted(p for p in APPS.iterdir() if p.is_dir()):
            if not (d / "CLAUDE-checklist.md").is_file():
                continue
            if parse(d / "CLAUDE-checklist.md") is None:
                continue
            worst = max(worst, check_one(d) if a.check else one(d))
        return worst
    start = pathlib.Path(a.project).resolve() if a.project else pathlib.Path.cwd()
    for d in [start, *start.parents]:
        if (d / "CLAUDE-checklist.md").is_file():
            return check_one(d) if a.check else one(d, a.stdout)
    print(f"milestones: no CLAUDE-checklist.md at or above {start}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
