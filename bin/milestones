#!/usr/bin/env python3
"""milestones -- render a project's milestone plan as a live page with a graph.

  milestones [--project DIR] [--all] [--stdout]

WHY A GENERATOR AND NOT A HAND-WRITTEN PAGE. `CLAUDE-workflow.md` says the
milestone plan "is a live document, kept current until the feature is done",
and that "a milestone plan that is not maintained is worse than none, because
it asserts an order of work that has stopped being true and nobody can tell
which rows still hold." A second hand-maintained copy of the plan is exactly
that failure with extra steps: the table and the picture drift, and the
picture is the one people look at.

So this reads the `## Milestones` table in CLAUDE-checklist.md -- the same
table `bin/milestonecheck` validates -- and renders from it. The page cannot
disagree with the plan, because it has no data of its own. Same argument as
`bin/tower` reading the feature register and `bin/pulse` deriving everything
from ground truth rather than from a file somebody remembers to update.

WHAT THE TABLE CANNOT SAY, AND IS NOT INVENTED HERE. The rule's five columns
are #, Milestone, Proves, You get, State. There is no date column and no
narrative, so this page has no "when" axis and no per-row commentary -- it
draws order, state, and where something reaches the sponsor's hands. Adding
columns to carry more would change a rule that landed today; if the plan
should say when, that is a change to the rule, not a flag here.

"You get" drives the deliverable marker. A row whose You-get is "nothing to
hold" (or any of the phrasings below) is a step that proves something without
handing anything over -- drawn as a plain node. Anything else raises a marker
above the rule, because "when do I get something" is the question the column
was added to answer.

Exit codes: 0 rendered. 1 the plan is missing or malformed (run
`bin/milestonecheck` for the detail). 2 nothing to check.
"""
from __future__ import annotations

import argparse
import datetime
import hashlib
import html
import json
import pathlib
import re
import subprocess
import sys

RULES = pathlib.Path(__file__).resolve().parent.parent
# Named, not derived as RULES.parent. From a task worktree that expression is
# `.worktrees/`, so `--all` silently finds nothing and reports success -- the
# same resolution trap that let tests/test_rulecheck.py's real-project subtests
# skip everywhere they were actually run (#113). bin/pulse names it for the
# same reason.
APPS = pathlib.Path("/Users/the-sponsor/apps")

# The register's vocabulary, mapped to what the drawing does with each. Order
# is the plan's order, never sorted -- a milestone plan reordered by state
# stops being a plan.
STATE_CLASS = {
    "done": "done", "built": "built", "in flight": "now",
    "next": "next", "later": "later", "blocked": "blocked",
}
STATE_LABEL = {
    "done": "done", "built": "built, not closed", "now": "in flight",
    "next": "next", "later": "later", "blocked": "blocked",
}

# A You-get that means "nothing, and that is fine". The rule requires the
# column be written rather than left blank precisely so this can be said out
# loud, so it must be recognised rather than treated as a deliverable.
NOTHING = re.compile(r"^(nothing( to hold| yet)?|none|no|n/?a|—|-)$", re.I)


def split_row(line: str) -> list[str]:
    return [c.strip() for c in line.strip().strip("|").split("|")]


def parse(checklist: pathlib.Path):
    text = checklist.read_text(encoding="utf-8", errors="replace")
    lines = text.splitlines()
    start = next((i for i, ln in enumerate(lines)
                  if re.match(r"^##\s+Milestones\b", ln.strip(), re.I)), None)
    if start is None:
        return None
    body = []
    for ln in lines[start + 1:]:
        if ln.strip().startswith("## "):
            break
        body.append(ln)
    rows = [ln for ln in body if ln.strip().startswith("|")]
    if len(rows) < 2:
        return None
    header = [c.lower() for c in split_row(rows[0])]
    idx = {}
    for i, c in enumerate(header):
        if re.search(r"\bprove", c): idx["pv"] = i
        elif re.search(r"\b(you\s*get|sponsor\s*gets?|deliver)", c): idx["gt"] = i
        elif re.search(r"\bstate\b", c): idx["st"] = i
        elif re.search(r"\bmilestone\b", c): idx["t"] = i
        elif re.search(r"\b(track|lane|stream|workstream)\b", c): idx["tr"] = i
    if not {"pv", "gt", "t"} <= set(idx):
        return None
    out = []
    for r in rows[1:]:
        if set(r.replace("|", "").strip()) <= {"-", ":", " "}:
            continue
        c = split_row(r)
        def cell(k, default=""):
            i = idx.get(k)
            return c[i] if i is not None and i < len(c) else default
        raw_state = (cell("st") or (c[-1] if c else "")).strip().strip("*").lower()
        # `cell("st")` is found by header. Falling back to the last cell only
        # when there is no State column at all -- positional reading breaks the
        # moment an optional column (Track) is added to the right of it.
        cls = next((v for k, v in STATE_CLASS.items() if k in raw_state), "next")
        gt = cell("gt")
        out.append({
            "t": cell("t"), "pv": cell("pv"), "gt": gt, "tr": cell("tr").strip("*") or "",
            "s": cls, "deliver": bool(gt) and not NOTHING.match(gt.strip().strip("*")),
        })
    return out or None


PAGE = r"""<!doctype html>
