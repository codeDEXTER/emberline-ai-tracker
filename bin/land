#!/usr/bin/env bash
# land -- take a finished task branch to main without waiting for a human.
#
#   land                    land the current branch
#   land --check            say what would happen, change nothing
#   land --all              land every branch in this project that is ready
#   land --advance-staging  run the merge gate on staging, fast-forward main
#                           on a green verdict (only when staging_branch is
#                           declared -- see below)
#
# Branches that are green and past the gate merge themselves. Nothing sits in
# a queue waiting to be noticed. On 2026-08-05 five finished branches sat for
# hours and two of them collided on the same file while they waited -- the
# collision existed only because the branches lived long enough to collide.
#
# O-08: a project can declare "staging_branch": "<name>" in .common-rules.json
# (tools/project.py documents the key). When it does, `land` merges a
# reviewed branch onto that branch instead of main -- creating it from main
# first if it doesn't exist yet -- running the same gate it always has. main
# only ever moves through `land --advance-staging`, which runs the gate again
# on staging itself and fast-forwards main to staging's tip on a green
# verdict only. It refuses -- never guesses -- when the gate is red, when
# staging is behind main (a commit reached main some other way), or when the
# verdict cannot be read (no test suite declared, or a broken gate
# declaration). No test is deleted by any of this: staging_branch reduces how
# often the full suite runs against main, not what it covers -- a smaller
# suite would have been just as green and just as wrong (finance-tracker:
# 1,753 green tests sitting over 16 wrong-money defects). A project that
# never declares staging_branch is unaffected: `land` goes straight to main,
# exactly as before this key existed.
#
# It refuses to land, and says why, when:
#   - the working tree is dirty
#   - the test suite is not green
#   - the branch has no commits main doesn't have
#   - the merge into main would conflict
#   - the branch touches a path the user reserved (see RESERVED below)
#   - the project is not aligned with the current common-rules (see below)
#   - the branch changes code and touches no test (see below)
#
# The test suite it runs is the one the project declares, in this order:
# gates.merge in .common-rules.json (tools/project.py documents the file),
# then .common-rules-test (first non-blank, non-comment line), then a guess:
# tests/*.py -> unittest, package.json -> npm test. A .common-rules.json that
# is not valid JSON, or declares a gate that is not a non-empty string,
# refuses -- it never falls back to the next source.
#   - a proposal asked numbered decisions or claims partial completion and
#     recorded neither (see below)
#   - a commit names a ledger item whose row did not move (see below)
#
# main is protected on some remotes, so it lands through a PR when one is
# needed and by fast-forward when it is not.
#
# Three escape hatches exist, each an env var someone had to type -- never a
# silent default -- and each recorded in the PR either way:
#   LAND_ALLOW_UNTESTED=1               land code that has no test
#   LAND_ALLOW_STALE_RULES=1            land from a project behind on common-rules
#   LAND_ALLOW_UNRECORDED_DECISIONS=1   land a proposal missing its answers
#   LAND_ALLOW_NO_MILESTONES=1          land a project with no milestone plan
#   LAND_ALLOW_STALE_MILESTONE_PAGE=1   land with docs/milestones.html out of date
#   LAND_ALLOW_UNLOGGED_ITEM=1          land a commit naming an item whose ledger row did not move
set -euo pipefail

GIT=git; command -v git >/dev/null 2>&1 || GIT=/Library/Developer/CommandLineTools/usr/bin/git
CHECK_ONLY=0; ALL=0; ADVANCE=0
for a in "$@"; do
    case "$a" in
        --check)            CHECK_ONLY=1 ;;
        --all)               ALL=1 ;;
        --advance-staging)   ADVANCE=1 ;;
        *) echo "unknown flag: $a" >&2; exit 2 ;;
    esac
done

# Paths the user reserved for themselves. A branch touching one of these is
# never landed automatically -- it is reported and left alone.
RESERVED='^(common-rules/|CLAUDE\.md|\.github/|finance_data/|auth\.json|\.env)'

TOP="$($GIT rev-parse --show-toplevel)"
cd "$TOP"

# The shared rules are the user's to merge, always. Landing them automatically
# would let the AI change the rules it operates under without anyone saying yes.
# --git-common-dir, not --show-toplevel: inside a worktree the toplevel is the
# worktree path, which does not end in the repo's name.
REPO_ROOT="$(cd "$($GIT rev-parse --git-common-dir)/.." && pwd)"
case "$REPO_ROOT" in
    */common-rules)
        echo "land: this is common-rules -- merging a rule change is reserved" >&2
        echo "      for the user. Push the branch and open a PR instead." >&2
        exit 3 ;;
esac

# The common-rules install this copy of `land` lives in -- resolved from its
# own path, the same way `derecord` finds itself. By this point REPO_ROOT is
# known not to be common-rules (the case above already exited), so this is
# only ever the *other* repo's rules, never a project blocking on itself.
RULES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

say() { printf '%s\n' "$*"; }
refuse() { say "  not landing: $*"; return 1; }

test_cmd() {
    # A declared gate wins, in this order:
    #   1. `.common-rules.json` gates.merge (proposal 20, D9; tools/project.py
    #      documents the file);
    #   2. `.common-rules-test` at the project root, beside
    #      `.common-rules-version`: the first line that is neither blank nor a
    #      comment is the command;
    # then a guess from the tree. Guessing ran the wrong gate for the
    # PhotoVault engine, whose tests are pytest with markers -- found in
    # proposal 19's pilot, 13 Sep, and named as a gap in proposal 18 B.
    # tools/project.py's test_command() is this function's twin, and bin/warmup
    # reports it; tests/test_warmup.py pins them equal.
    #
    # A `.common-rules.json` that cannot be read refuses the landing, and so
    # does a declared gate land cannot use -- "gates" that is not an object,
    # or a "merge" or "quick" that is not a non-empty string (lead ruling on
    # V-00, 14 Sep), is not valid UTF-8, or is not one line (review round 2:
    # "false\ntrue" was eval'd as two commands and read green). Falling back
    # to .common-rules-test or the guess would silently run a gate nobody
    # declared. It is read by python's json, run as `python3 -I` so a
    # project's own json.py cannot shadow the standard library, and the shell
    # never parses a declared value; the command itself is the project's own,
    # and runs as written. Every declared command is printed with printf,
    # never echo, which would swallow a command such as `-n`.
    #
    # Tests extract this function with sed up to the first line that starts
    # with a closing brace, so no line inside it may start with one.
    if [ -f .common-rules.json ]; then
        local fromjson
        if ! fromjson="$(python3 -I -c '
import json, sys
def refuse(why):
    print("false  # .common-rules.json " + why)
    sys.exit(0)
try:
    d = json.loads(open(".common-rules.json", "rb").read())
except (OSError, ValueError):
    refuse("is not valid JSON")
if not isinstance(d, dict):
    refuse("is not a JSON object")
g = d.get("gates", {})
if not isinstance(g, dict):
    refuse("gates is not an object")
for name in ("merge", "quick"):
    if name not in g:
        continue
    v = g[name]
    if not (isinstance(v, str) and v.strip()):
        refuse("gates." + name + " is not a string")
    try:
        v.encode("utf-8")
    except UnicodeEncodeError:
        refuse("gates." + name + " is not valid UTF-8")
    if any(ord(c) < 32 or 127 <= ord(c) < 160 for c in v.strip()):
        refuse("gates." + name + " must be one line")
if "merge" in g:
    print(g["merge"].strip())
' 2>/dev/null)"; then
            fromjson="false  # python3 could not read .common-rules.json"
        fi
        if [ -n "$fromjson" ]; then
            printf '%s\n' "$fromjson"
            return
        fi
    fi
    if [ -f .common-rules-test ]; then
        local declared
        declared="$(grep -v '^[[:space:]]*#' .common-rules-test | grep -v '^[[:space:]]*$' | head -1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' || true)"
        if [ -n "$declared" ]; then
            printf '%s\n' "$declared"
            return
        fi
    fi
    if [ -d tests ] && ls tests/*.py >/dev/null 2>&1; then
        echo "python3 -m unittest discover -s tests -q"
    elif [ -f package.json ] && grep -q '"test"' package.json; then
        echo "npm test --silent"
    else
        echo ""
    fi
}

# O-08: the integration branch a reviewed branch lands on instead of main --
# .common-rules.json's staging_branch, tools/project.py's staging_target()
# is this function's python twin (same reason test_command() is test_cmd()'s:
# tests need a way to check the two agree). Prints the branch name, or
# nothing when it is not declared or not usable -- in which case land_one
# below falls back to "main", exactly as it always has.
#
# Same validation as a declared gate (project.py's staging_branch check):
# a non-empty, one-line, valid-UTF-8 string. Unlike a gate, an unusable
# declaration here is not a refusal -- it is silently equivalent to not
# declaring one, because there is no unsafe action a bad value could cause
# land to take (it only ever chooses a branch NAME land itself creates and
# merges onto, never a command land evaluates).
staging_branch() {
    if [ -f .common-rules.json ]; then
        python3 -I -c '
import json, sys
try:
    d = json.loads(open(".common-rules.json", "rb").read())
except (OSError, ValueError):
    sys.exit(0)
if not isinstance(d, dict):
    sys.exit(0)
v = d.get("staging_branch")
if not isinstance(v, str):
    sys.exit(0)
v = v.strip()
if not v or "\n" in v:
    sys.exit(0)
try:
    v.encode("utf-8")
except UnicodeEncodeError:
    sys.exit(0)
if any(ord(c) < 32 or 127 <= ord(c) < 160 for c in v):
    sys.exit(0)
print(v)
' 2>/dev/null || true
    fi
}

# "Closes #N" lines for the issues this branch's commits name, or nothing.
#
# A PR that finishes an issue has to say "Closes #N" in its *body* or the
# issue silently outlives its fix -- finance-tracker's CLAUDE.md has carried
# that rule for a while, but the body written below was a fixed string, so
# every branch landed here left its issue open for a human to notice. On
# 2026-08-10 that put issue #362 in exactly that state: fixed, merged, still
# open.
#
# It matches only an explicit intent word before the number. A bare "(#N)"
# is deliberately NOT matched: as common-rules 149 measured on this very
# repo's consumers, a trailing "(#N)" is usually the *PR* number, and PR
# numbers overlap the range issues live in -- so keying on it would close
# an unrelated issue roughly six times out of seven. Same principle as
# bin/tower's worktree_issue(): no match means unlinked, not guessed.
# NO MATCH IS AN ANSWER, NOT A FAILURE -- and `|| true` below is load-bearing.
# `grep` exits 1 when it matches nothing, which is the *common* case: most
# commits name no issue. Under `set -euo pipefail` (line 22) that made the
# pipeline fail, which made the `closes=$(...)` assignment fail, which killed
# land outright -- silently, after printing "tests green" and before pushing
# anything. Every branch with a plain descriptive commit message hit it.
#
# Reported 2026-08-16 as being line 173's `[ -n "$closes" ] && ...` test. It is
# not: bash exempts a failing command in a && list from `set -e`, and a minimal
# repro of that line exits 0. The death is the assignment above it. The
# difference matters -- the reported fix would have left the bug in place and
# looked like it had worked.
# `issue`/`issues` is deliberately NOT a keyword here, though it was until
# 2026-08-30. GitHub's own closing-keyword list has never included it, and
# treating it as one meant any prose reference closed the ticket it named:
# "unlike issue #700", "this does NOT fix issue #800", "see issue #123 for
# the real fix" all emitted a Closes trailer. The `issue_here` filter below
# does not catch this -- it only checks the number exists in this repo, not
# that closing it was intended. It bit twice in one day: a document-only
# proposal branch whose body read "issues #821-#826" closed the live bug
# #821 on merge, and the reopen that followed left a landed fix showing as
# open. Say `closes`/`fixes`/`resolves` when you mean it.
closes_trailer() {
    local subjects="$1"
    printf '%s\n' "$subjects" \
        | grep -oiE '(closes?d?|fix(es|ed)?|resolves?d?)[[:space:]]+#[0-9]+' \
        | grep -oE '#[0-9]+' \
        | sort -u -t'#' -k2 -n \
        | sed 's/^/Closes /' \
        || true
}

# Does issue #N exist in THIS repo? The trailer is filtered through this
# before it is written, because a commit legitimately cites another repo's
# issue. This very change's own commit explains itself by naming
# finance-tracker's issue #362 -- and unfiltered, landing it here would have
# closed common-rules #362, a different and unrelated issue. Found by running
# the new code against its own branch. Without `gh` there is no way to check,
# so nothing is claimed.
issue_here() {
    command -v gh >/dev/null 2>&1 || return 1
    gh issue view "$1" --json number >/dev/null 2>&1
}

land_one() {
    local branch="$1"
    say "── $branch"

    [ -z "$($GIT status --porcelain)" ] || { refuse "working tree is dirty"; return 1; }

    # O-08: a declared staging_branch is where this branch actually lands.
    # main is untouched here either way -- it only ever moves through
    # `land --advance-staging`, below. Created from main on first use, so a
    # project that declares one for the first time doesn't have to make it
    # by hand. `--check` says what would happen without creating anything --
    # a not-yet-created staging branch is identical to main until it exists,
    # so the diffs below compare against main in that case, same result.
    local target want_target
    want_target="$(staging_branch)"
    target="${want_target:-main}"
    local creating_target=0
    if [ -n "$want_target" ] && ! $GIT rev-parse --verify -q "refs/heads/$want_target" >/dev/null; then
        creating_target=1
        if [ "$CHECK_ONLY" = 1 ]; then
            say "  would create $want_target from main"
            target="main"
        else
            say "  creating $want_target from main"
            $GIT branch "$want_target" main
        fi
    fi
    [ -n "$want_target" ] && say "  landing onto $want_target, not main"

    local ahead
    ahead=$($GIT rev-list --count "$target..$branch")
    [ "$ahead" -gt 0 ] || { refuse "nothing $target doesn't already have"; return 1; }

    # Say what is actually about to land, not just how much.
    #
    # A branch cut from a local `main` that was ahead of `origin` carries the
    # unpushed commits too, and a squash merge collapses the lot under this
    # branch's title. It happened twice on 2026-08-07: a PR described as a
    # one-line docs change landed 25 files and 1,109 insertions of another
    # session's work, and published a real corpus identifier doing it.
    #
    # The cheapest guard is to print the subjects. If a line here is not
    # yours, stop -- `git fetch && git rebase origin/main` before landing.
    # `-n 12`, never `| head -12`: this file runs under `set -euo pipefail`
    # (line 62), and when `head` closes the pipe early `git log` takes SIGPIPE
    # and the whole pipeline fails, which under `set -e` ends land right here
    # -- silently, mid-run, with the guard below never printed. Whether git is
    # killed or finishes into the pipe buffer first is a race, so it failed
    # intermittently and only under load. `land died silently` is already in
    # this file's history once (#103); the pipe is how it happens.
    $GIT log "$target..$branch" --pretty='      %h %s' -n 12
    [ "$ahead" -gt 12 ] && say "      … and $((ahead - 12)) more" || true

    # --- aligned with common-rules -----------------------------------------
    #
    # Merging work produced under rules nobody read is the actual harm, and
    # this is the last point before it happens. The signal already existed --
    # `rulecheck` has exited 1 for a stale project all along -- but nothing
    # consumed it: a SessionStart hook's exit status does not stop the
    # session, so every session in a stale project got the failure and kept
    # going anyway. This is what makes it a gate instead of a suggestion.
    #
    # Only a project that opted in is checked. `.common-rules-version` is the
    # explicit act of opting in -- `rulecheck --align`, once, on purpose --
    # so a project that has never run it (even one whose CLAUDE.md points at
    # CLAUDE-workflow.md) is not blocked here. It never made the claim this
    # gate is enforcing.
    local stamp_file="$TOP/.common-rules-version"
    if [ -f "$stamp_file" ] && [ -x "$RULES_DIR/bin/rulecheck" ]; then
        if ! "$RULES_DIR/bin/rulecheck" --project "$TOP" --quiet >/dev/null 2>&1; then
            if [ "${LAND_ALLOW_STALE_RULES:-0}" != 1 ]; then
                local was cur msg
                was="$(tr -d '[:space:]' < "$stamp_file")"
                cur="$("$RULES_DIR/bin/rulecheck" --version 2>/dev/null || echo "unknown")"
                # One `refuse` call with the whole message as a single argument --
                # `refuse` returns 1, and under `set -e` a plain (non-&&/||/if-
                # guarded) command returning non-zero ends the script right there,
                # so anything meant to reach the user has to be said before or
                # inside that one call, never after it.
                msg="not aligned with common-rules -- on $was, current is $cur
      Read $RULES_DIR/CLAUDE-workflow.md for what changed since $was, then:
        $RULES_DIR/bin/rulecheck --align   # writes .common-rules-version -- does NOT commit it
        git add .common-rules-version && git commit -m 'align with common-rules'
      If this branch genuinely must land before that, re-run with
      LAND_ALLOW_STALE_RULES=1 -- it is recorded in the PR either way."
                refuse "$msg"
                return 1
            fi
        fi
    fi

    # --- proposals recorded their decisions --------------------------------
    #
    # `bin/proposalcheck` landed in #106 (common-rules 156-8b1cce3) and
    # nothing consumed its exit code -- `rulecheck`'s stale-project signal sat
    # unconsumed the same way until the alignment gate above made it
    # load-bearing, and it took a session actually hitting it to notice. This
    # is that fix applied to the sibling check before the same gap gets found
    # the same way twice.
    #
    # Same opt-in guard as the alignment gate above, and for the same reason:
    # a project that never ran `rulecheck --align` never claimed to be
    # governed by these rules at all, so it is not held to a rule that lives
    # inside them.
    if [ -f "$stamp_file" ] && [ -x "$RULES_DIR/bin/proposalcheck" ]; then
        # Captured rather than tested with `!`, because the exit codes are
        # not a pass/fail pair here. `proposalcheck` follows rulecheck's 0/1/2
        # shape on paper, but its 2 means something different in practice:
        # rulecheck's 2 is "could not check" (run from the wrong place, rules
        # unreadable) -- an error. proposalcheck's 2 is "no docs/proposals/
        # under this project" (see its own docstring/exit-codes section) --
        # an ordinary, common project shape, not an error. The
        # `.common-rules-version` guard above already excludes the
        # non-adopting projects that would make rulecheck's 2 fire, so the two
        # checkers' 2s cannot collide here; the only thing this branch would
        # still see is a genuinely proposal-less adopting project, which has
        # nothing to be gated on. Collapsing it into "nonzero -> refuse" the
        # way the alignment gate does would block every such project on a
        # gate that had nothing to say. Only exit 1 -- an actual violation --
        # refuses. `pc_rc=$?` on the right of `||` is the same rescue used
        # throughout this file: under `set -e` a failing command that is the
        # last thing in a plain assignment ends the script right there unless
        # something catches it first.
        local pc_out pc_rc=0
        pc_out="$("$RULES_DIR/bin/proposalcheck" --project "$TOP" 2>&1)" || pc_rc=$?
        if [ "$pc_rc" = 1 ] && [ "${LAND_ALLOW_UNRECORDED_DECISIONS:-0}" != 1 ]; then
            local msg
            msg="proposal(s) asked numbered decisions, or claim partial completion, and record neither -- $pc_out
      Read $RULES_DIR/CLAUDE-workflow.md, \"A proposal that asked numbered decisions must record the answers\".
      Add the missing id=\"decided\" block (and id=\"exceptions\" for completed in part) to the proposal(s) named above.
      If this branch genuinely must land before that, re-run with
      LAND_ALLOW_UNRECORDED_DECISIONS=1 -- it is recorded in the PR either way."
            refuse "$msg"
            return 1
        fi
    fi

    # --- the milestone plan exists, and is well-formed ----------------------
    #
    # `CLAUDE-workflow.md`, "And every project keeps a milestone plan". Wired
    # in the same PR that added `bin/milestonecheck` rather than a day later,
    # which is the whole lesson of the two gates above: #106 shipped
    # `proposalcheck` with nothing calling it and #107 had to come back and
    # connect it, and `rulecheck --quiet` sat in a SessionStart hook whose
    # exit status stops nothing until the 2026-08-18 alignment gate. A checker
    # with no caller is a suggestion wearing the shape of a rule.
    #
    # Same opt-in guard as both gates above, same reason: a project that never
    # ran `rulecheck --align` never claimed to be governed by these rules.
    #
    # Exit codes follow proposalcheck's reading, not rulecheck's: only 1 (an
    # actual violation) refuses. milestonecheck's 2 is "no CLAUDE-checklist.md
    # under this project" -- for an adopting project that is a malformed
    # project rather than a milestone problem, and it is the checklist rule's
    # business to say so, not this gate's. Folding 2 into "refuse" here would
    # have this gate reporting someone else's violation in its own words.
    if [ -f "$stamp_file" ] && [ -x "$RULES_DIR/bin/milestonecheck" ]; then
        local mc_out mc_rc=0
        mc_out="$("$RULES_DIR/bin/milestonecheck" --project "$TOP" 2>&1)" || mc_rc=$?
        if [ "$mc_rc" = 1 ] && [ "${LAND_ALLOW_NO_MILESTONES:-0}" != 1 ]; then
            local msg
            msg="this project's milestone plan is missing or malformed -- $mc_out
      Read $RULES_DIR/CLAUDE-workflow.md, \"And every project keeps a milestone plan\".
      Add a \`## Milestones\` table to CLAUDE-checklist.md. Every row states what the
      step *proves* and what you *get* -- 'nothing to hold' is a valid answer, a blank is not.
      If this branch genuinely must land before that, re-run with
      LAND_ALLOW_NO_MILESTONES=1 -- it is recorded in the PR either way."
            refuse "$msg"
            return 1
        fi
    fi

    # --- the milestone plan's picture is current ---------------------------
    #
    # `CLAUDE-workflow.md`: "the plan has a picture, generated". The page is
    # rendered from the same table the gate above validates, so this asks only
    # one thing -- has the table moved since the page was last generated.
    #
    # Separate from the gate above rather than folded into it, and separately
    # overridable, because they fail for different reasons and are fixed by
    # different actions: one wants the plan written, this one wants a command
    # run. A single refusal covering both would name the wrong fix half the
    # time.
    #
    # `milestones --check` follows the same 0/1/2 reading as its siblings, and
    # exits 2 for a project with no checklist -- the checklist rule's business,
    # not this gate's.
    if [ -f "$stamp_file" ] && [ -x "$RULES_DIR/bin/milestones" ]; then
        local mp_out mp_rc=0
        mp_out="$("$RULES_DIR/bin/milestones" --check --project "$TOP" 2>&1)" || mp_rc=$?
        if [ "$mp_rc" = 1 ] && [ "${LAND_ALLOW_STALE_MILESTONE_PAGE:-0}" != 1 ]; then
            local msg
            msg="the milestone plan's page is missing or out of date -- $mp_out
      Read $RULES_DIR/CLAUDE-workflow.md, \"And the plan has a picture, generated\".
      Fix it by running it, not by editing the page:  $RULES_DIR/bin/milestones
      Then commit docs/milestones.html alongside the plan change that moved it.
      If this branch genuinely must land before that, re-run with
      LAND_ALLOW_STALE_MILESTONE_PAGE=1 -- it is recorded in the PR either way."
            refuse "$msg"
            return 1
        fi
    fi

    # --- the ledger moved with the code --------------------------------------
    #
    # Proposal 19 (W-03). A branch whose commits name a ledger item -- "W-01
    # the templates", "E1-10 flutter-read locations" -- must also move that
    # item's row in docs/proposals/NN-*.json. The PhotoVault engine kept this
    # as prose and kept it on its best day (58 ledger commits on 13 September);
    # prose rules measured 1-in-7 compliance here. `tracker check` reads
    # "moved" from git -- the item's JSON differs between the merge-base and
    # the branch tip -- never from a timestamp an agent typed.
    #
    # Wired in the same change that added the checker, for the reason the
    # milestone gate above gives: a checker with no caller is a suggestion.
    # Same opt-in guard as every gate above. Only exit 1 refuses; 2 is "could
    # not check", and a project with no ledger exits 0.
    if [ -f "$stamp_file" ] && [ -x "$RULES_DIR/bin/tracker" ]; then
        local tk_out tk_rc=0
        tk_out="$("$RULES_DIR/bin/tracker" check --project "$TOP" --base main --head "$branch" 2>&1)" || tk_rc=$?
        if [ "$tk_rc" = 1 ] && [ "${LAND_ALLOW_UNLOGGED_ITEM:-0}" != 1 ]; then
            local msg
            msg="a commit names a ledger item and its ledger row did not move --
$tk_out
      The ledger is the record: add the log entry (and status) for each item
      named above to its docs/proposals/NN-*.json on this branch, then land.
      If this branch genuinely must land before that, re-run with
      LAND_ALLOW_UNLOGGED_ITEM=1 -- it is recorded in the PR either way."
            refuse "$msg"
            return 1
        fi
    fi

    local touched
    touched=$($GIT diff --name-only "$target...$branch" | grep -E "$RESERVED" || true)
    if [ -n "$touched" ]; then
        refuse "touches paths reserved for the user:"
        printf '%s\n' "$touched" | sed 's/^/      /'
        return 1
    fi

    # Would the merge conflict? Ask git without touching the working tree.
    local base
    base=$($GIT merge-base "$target" "$branch")
    if ! $GIT merge-tree --write-tree "$target" "$branch" >/dev/null 2>&1; then
        if $GIT merge-tree "$base" "$target" "$branch" 2>/dev/null | grep -q '^<<<<<<<'; then
            refuse "would conflict with $target -- merge $target in and resolve first"
            return 1
        fi
    fi

    # --- a change to code arrives with a test ------------------------------
    #
    # Measured 2026-08-10: 29% of every Bash call a session makes is a one-off
    # verification probe -- an inline script that proves something and then dies
    # with the session. 3,873 of them in the transcripts, against 106 from the
    # agent roles. The proving already happens; it just is not kept.
    #
    # So this does not ask for more testing. It asks for the test that was
    # already written by hand to land in tests/ instead of a chat message.
    # Docs, HTML and config changes are not code and do not trip it.
    local code_touched tests_touched
    code_touched=$($GIT diff --name-only "$target...$branch" \
        | grep -vE '^tests/' | grep -E '\.(py|sh|swift|js|ts|rb|go)$|^bin/' || true)
    tests_touched=$($GIT diff --name-only "$target...$branch" | grep -E '^tests/' || true)
    if [ -n "$code_touched" ] && [ -z "$tests_touched" ] && [ "${LAND_ALLOW_UNTESTED:-0}" != 1 ]; then
        refuse "changes code but no test -- the probe you ran belongs in tests/"
        printf '%s\n' "$code_touched" | sed 's/^/      /'
        say "      if this genuinely cannot be tested, say why and re-run with"
        say "      LAND_ALLOW_UNTESTED=1 -- it is recorded in the PR either way."
        return 1
    fi

    local tc; tc="$(test_cmd)"
    if [ -n "$tc" ]; then
        say "  running: $tc"
        if ! eval "$tc" >/tmp/land-tests.$$ 2>&1; then
            refuse "tests are not green"
            tail -15 /tmp/land-tests.$$ | sed 's/^/      /'
            rm -f /tmp/land-tests.$$
            return 1
        fi
        say "  tests green ($(grep -oE 'Ran [0-9]+ tests?' /tmp/land-tests.$$ | tail -1))"
        rm -f /tmp/land-tests.$$
    else
        say "  no test suite found -- landing on the gate alone"
    fi

    if [ "$CHECK_ONLY" = 1 ]; then say "  READY (check only, nothing done)"; return 0; fi

    # A freshly created staging branch is local-only so far (the branch
    # creation above is a plain `git branch`); it has to exist on the remote
    # before a PR can target it. Best-effort, same as everything else in this
    # function that talks to origin -- a project with no remote configured
    # (every land test's throwaway repo, deliberately) just carries on local.
    if [ "$creating_target" = 1 ] && [ "$target" != "main" ]; then
        $GIT push -q -u origin "$target" 2>/dev/null || true
    fi

    local body closes
    body="Landed by \`common-rules/bin/land\`: $ahead commit(s), tests green, no reserved paths touched."
    closes="$(closes_trailer "$($GIT log "main..$branch" --pretty='%s%n%b')" \
              | while read -r line; do issue_here "${line##*#}" && printf '%s\n' "$line"; done)"
    [ -n "$closes" ] && body="$body"$'\n\n'"$closes"

    if $GIT push -q origin "$branch" 2>/dev/null && command -v gh >/dev/null 2>&1; then
        local url
        url=$(gh pr create --base "$target" --head "$branch" \
              --title "$($GIT log -1 --format=%s "$branch")" \
              --body "$body" \
              2>/dev/null || gh pr view "$branch" --json url -q .url 2>/dev/null)
        if [ -n "${url:-}" ]; then
            say "  PR: $url"
            # Branch deletion is NOT part of "did it merge". `gh pr merge
            # --delete-branch` exits non-zero when a worktree still holds the
            # branch -- which is the normal case here, since every task runs in
            # one. Coupling the two made land report "merge blocked" on a PR
            # that had merged seconds earlier: a false negative that tells a
            # session to retry or escalate work that is already done.
            gh pr merge "$url" --squash >/dev/null 2>&1 || true

            # Ask the remote what actually happened, rather than trusting an
            # exit code that conflates merging with cleanup.
            local state
            state=$(gh pr view "$url" --json state -q .state 2>/dev/null || echo "")
            if [ "$state" = "MERGED" ]; then
                say "  LANDED${target:+ on $target}"
                # Best-effort tidy-up; a branch held by a worktree stays, and
                # that is fine -- it is deleted when the worktree is removed.
                gh api -X DELETE "repos/{owner}/{repo}/git/refs/heads/$branch" >/dev/null 2>&1 || true
                return 0
            fi
            say "  PR open, not merged (state: ${state:-unknown}) -- protected"
            say "  branch, a required check, or a review is pending"
            return 0
        fi
    fi

    # No remote path (no gh, or nothing to push to): merging locally onto
    # main would be exactly the silent, ungated merge this whole script
    # exists to avoid, so this always stays a no-op there -- but a *local*
    # staging branch is nobody's protected branch and nothing downstream
    # trusts it the way main is trusted, so merging onto it here is safe:
    # `--advance-staging` is the only path that ever moves main, and it does
    # its own gate, its own ancestor check, and its own fast-forward-only
    # merge regardless of how the commits got onto staging.
    if [ "$target" != "main" ]; then
        # Plumbing, not `git checkout && git merge`: this function never
        # switches the working tree away from the branch it was invoked on
        # (the conflict check above already proved this merge is clean, with
        # the same `merge-tree --write-tree`, so there is nothing left to
        # resolve here).
        local mtree mcommit
        mtree=$($GIT merge-tree --write-tree "$target" "$branch")
        mcommit=$($GIT commit-tree "$mtree" -p "$target" -p "$branch" \
                   -m "Merge $branch into $target")
        $GIT update-ref "refs/heads/$target" "$mcommit"
        say "  LANDED on $target (local merge; no remote path available)"
        return 0
    fi

    say "  no remote path available; leaving the branch pushed"
    return 0
}

# O-08: the only path that ever moves main once a project declares
# staging_branch. Runs the merge gate on staging itself (accumulated commits
# from however many branches landed there since the last advance) and
# fast-forwards main to it -- never anything else: not a merge commit, not a
# reset, so main's history stays a straight line through what staging proved
# green. "I could not tell" is a refusal here, same as a red gate -- never
# treated as a pass.
advance_staging() {
    local target
    target="$(staging_branch)"
    if [ -z "$target" ]; then
        refuse "no staging branch declared in .common-rules.json -- nothing to advance"
        return 1
    fi
    say "── advance main to $target"

    if ! $GIT rev-parse --verify -q "refs/heads/$target" >/dev/null; then
        refuse "no $target branch here yet -- nothing has landed on it"
        return 1
    fi
    [ -z "$($GIT status --porcelain)" ] || { refuse "working tree is dirty"; return 1; }

    # staging must still contain every commit on main. It only ever
    # shouldn't when something reached main some other way -- a hotfix
    # pushed straight to main, or main advanced from a *different* staging
    # state. Either way, guessing which commits to keep is exactly the wrong
    # instinct; ask the person to reconcile it.
    if ! $GIT merge-base --is-ancestor main "$target" 2>/dev/null; then
        refuse "staging is behind main -- a commit reached main some other way; merge main into $target and resolve first"
        return 1
    fi

    local ahead
    ahead=$($GIT rev-list --count "main..$target")
    [ "$ahead" -gt 0 ] || { refuse "$target has nothing main doesn't already have"; return 1; }
    say "  $ahead commit(s) to advance"

    local original
    original="$($GIT rev-parse --abbrev-ref HEAD)"
    restore_original() {
        [ "$original" = "HEAD" ] && return 0
        $GIT checkout -q "$original" >/dev/null 2>&1 || true
    }

    $GIT checkout -q "$target"

    local tc; tc="$(test_cmd)"
    case "$tc" in
        ""|"false  #"*)
            restore_original
            refuse "the verdict cannot be read -- ${tc:-no test suite declared for this project}"
            return 1 ;;
    esac

    # This gate now guards main, not just a branch review -- so it is held
    # to the same rule `bin/commit-if-green` already holds itself to, and
    # `bin/land`'s own gate at land_one() (still exit-code-only; logged as a
    # finding, its own item) does not yet: docs/OPERATING-RULES.md S3, `grep
    # ... && git commit` once shipped a failing test because grep exits 0 on
    # a line containing "FAILED". `eval`ing $tc directly and trusting its
    # exit code has that identical shape. `bin/quiet` exists precisely to
    # read the runner's own summary line, not just its exit code, so route
    # through it rather than repeating that parsing here.
    #
    # `bash -c "$tc"`, not a split argv: $tc is a single string this whole
    # file already `eval`s (test_cmd()'s contract -- a project's declared
    # gate command, which may contain a pipe, a quoted argument or `&&`),
    # and quiet execs its CMD directly with no shell of its own. Splitting
    # $tc into words here would silently mis-parse or drop exactly that.
    if [ ! -x "$RULES_DIR/bin/quiet" ]; then
        restore_original
        refuse "the verdict cannot be read -- $RULES_DIR/bin/quiet is missing or not executable"
        return 1
    fi

    say "  running: $RULES_DIR/bin/quiet -- $tc"
    local quiet_out quiet_rc=0
    quiet_out="$("$RULES_DIR/bin/quiet" --label land-staging -- bash -c "$tc")" || quiet_rc=$?
    if [ "$quiet_rc" = 0 ] && [[ "$quiet_out" == "quiet: OK"* ]]; then
        say "  staging gate green -- $quiet_out"
    else
        restore_original
        refuse "staging's gate did not say OK -- main stays where it is
      ${quiet_out:-quiet printed no verdict line} (quiet exit $quiet_rc)"
        return 1
    fi

    if [ "$CHECK_ONLY" = 1 ]; then
        restore_original
        say "  READY (check only, main not advanced)"
        return 0
    fi

    $GIT checkout -q main
    $GIT merge -q --ff-only "$target"
    say "  main advanced to $target ($ahead commit(s)) locally"

    # A silent push failure here is worse than a silent push failure
    # anywhere else in this file: main is commonly protected (this file's
    # own header), so "cannot push to main" is the expected failure mode,
    # not a rare one -- and "main advanced" printed over a push that never
    # happened would tell every caller main is published when it is not.
    local push_err
    if push_err="$($GIT push origin main 2>&1)"; then
        say "  pushed"
        restore_original
        return 0
    fi
    say "  main moved locally but the push to origin failed -- main is NOT published:"
    printf '%s\n' "$push_err" | sed 's/^/      /'
    say "  push it yourself once this is resolved (main is a straight fast-forward, so a plain"
    say "  \`git push origin main\` from here will do it -- nothing needs re-testing)."
    restore_original
    return 1
}

if [ "$ADVANCE" = 1 ]; then
    advance_staging
elif [ "$ALL" = 1 ]; then
    for w in $($GIT worktree list --porcelain | awk '/^branch /{print $2}' | sed 's#refs/heads/##'); do
        [ "$w" = "main" ] && continue
        ( cd "$($GIT worktree list --porcelain | grep -B2 "refs/heads/$w\$" | awk '/^worktree /{print $2}' | tail -1)" \
          && land_one "$w" ) || true
    done
else
    land_one "$($GIT rev-parse --abbrev-ref HEAD)"
fi
