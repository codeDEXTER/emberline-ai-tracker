#!/usr/bin/env python3
"""spend -- what a task cost, and where the money goes.

    spend report              cost per task for this project
    spend report --by-agent   which roles are expensive
    spend agentlog [--write]  regenerate AGENT-LOG.md from the transcripts
    spend today               everything spent today, across all projects
    spend log <task>          append one AGENT-LOG entry (legacy, see below)

The numbers come from the session transcripts under ~/.claude/projects, which
record token usage per request. Output tokens are the effort proxy throughout:
transcript wall-clock spans include idle time and would be misleading.

Written 2026-08-05, when measuring four days of sessions showed two thirds of
all spend went to management chats rather than to worktrees doing the work.

Rewritten the same day, because `report` was reading the wrong thing. It parsed
AGENT-LOG.md for a `session output tokens:` line that only `spend log` ever
wrote -- and the rules told sessions to keep that file by hand, so of ten
entries in finance-tracker, none carried it. The command reported 0 for every
row for a week and nobody noticed, because nothing tested it.

Both faults are now fixed at the root: `report` and `agentlog` read the
transcripts directly, and `tests/test_spend.py` fails if a report over a
transcript with real usage ever comes back zero. `log` is kept for anyone who
wants a hand-written note, but nothing reads its numbers any more.
"""
from __future__ import annotations

import collections
import datetime
import glob
import json
import os
import subprocess
import sys

PROJECTS = os.path.expanduser("~/.claude/projects")
LOG = "AGENT-LOG.md"
MANAGEMENT = "(management)"


def _sessions():
    """Yield (project_dir_name, path) for every transcript on this machine."""
    for path in glob.glob(os.path.join(PROJECTS, "*", "*.jsonl")):
        yield os.path.basename(os.path.dirname(path)), path


def _read(path):
    """Output tokens, agent calls and day-buckets for one transcript."""
    out = 0
    agents = collections.Counter()
    days = collections.Counter()
    with open(path, errors="replace") as fh:
        lines = fh.readlines()
    for line in lines:
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        msg = rec.get("message") or {}
        tokens = (msg.get("usage") or {}).get("output_tokens", 0)
        out += tokens
        if tokens and rec.get("timestamp"):
            days[rec["timestamp"][:10]] += tokens
        content = msg.get("content")
        if isinstance(content, list):
            for block in content:
                if isinstance(block, dict) and block.get("type") == "tool_use" \
                        and block.get("name") == "Agent":
                    agents[(block.get("input") or {}).get("subagent_type", "?")] += 1
    return out, agents, days


def _scan(path):
    """Everything one transcript knows about itself, including where it ran.

    `_read` above answers "how much"; this answers "how much, and for what
    task" -- which is what `report` needs and what it used to ask a
    hand-written file for.
    """
    out, agents, days = _read(path)
    cwds = []
    first = last = ""
    with open(path, errors="replace") as fh:
        lines = fh.readlines()
    for line in lines:
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        c = rec.get("cwd") or ""
        if c:
            cwds.append(c)
        ts = rec.get("timestamp") or ""
        if ts:
            if not first or ts < first:
                first = ts
            if not last or ts > last:
                last = ts
    return {"path": path, "out": out, "agents": agents, "days": days,
            "cwd": cwds[0] if cwds else "", "cwds": cwds,
            "home": _dominant(cwds),
            "first": first, "last": last}


def _dominant(cwds):
    """Where a session actually lived, not where it was launched.

    The most-recorded cwd, which is the session's real home. Using any cwd it
    ever touched counts a one-line `cd` in a bash command as a whole session's
    work -- measured 2026-08-07, that inflated finance-tracker eight-fold and
    attributed the same session to two projects at once.
    """
    if not cwds:
        return ""
    counts = {}
    for c in cwds:
        counts[c] = counts.get(c, 0) + 1
    return max(counts, key=lambda k: counts[k])


def _repo_root():
    """The project this command was run in -- the shared dir if in a worktree."""
    common = _git("rev-parse", "--path-format=absolute", "--git-common-dir")
    if common:
        return os.path.abspath(os.path.join(common, os.pardir))
    return _git("rev-parse", "--show-toplevel") or os.getcwd()


def _task_of(cwds, root):
    """Which task a transcript belongs to, from everywhere it ran.

    Three outcomes. A session that spent all its time in exactly one worktree
    was doing that task. One that never left the main checkout is
    `(main checkout)`, as before. One that moved between worktrees, or between
    a worktree and main, was orchestrating -- it is `(management)`, not charged
    to whichever task it happened to visit first.

    That split exists because attributing by the *first* recorded cwd dropped
    every management session: they launch from `apps/` and enter a project only
    later, via EnterWorktree. Measured 2026-08-07, that hid 88% of all spend --
    pockets reported zero tasks on a day it had spent 836k output tokens across
    four agents, and finance-tracker reported 4M against a real 24M.

    Charging a management session to a single task was tried and rejected: one
    of them legitimately spans ten worktrees, so any single label either
    over-claims one task or silently collapses nine others.

    Both sides are realpath'd: on macOS `/var` is a symlink to `/private/var`,
    so a session's recorded cwd and git's toplevel can name one directory two
    ways, and a plain string compare silently drops the task.
    """
    if isinstance(cwds, str):
        cwds = [cwds]
    root = os.path.realpath(root)
    marker = os.sep + ".claude" + os.sep + "worktrees" + os.sep
    worktrees, saw_main = [], False
    for cwd in cwds or []:
        cwd = os.path.realpath(cwd or "")
        if cwd != root and not cwd.startswith(root + os.sep):
            continue
        if marker in cwd:
            name = cwd.split(marker, 1)[1].split(os.sep)[0]
            if name not in worktrees:
                worktrees.append(name)
        else:
            saw_main = True
    if not worktrees and not saw_main:
        return None
    if len(worktrees) == 1 and not saw_main:
        return worktrees[0]
    if not worktrees:
        return "(main checkout)"
    return MANAGEMENT


def _commits_in(cwd):
    """Commits ahead of main in that worktree, or None if it cannot be told."""
    if not os.path.isdir(cwd):
        return None
    n = _git("-C", cwd, "rev-list", "--count", "main..HEAD")
    return int(n) if n.isdigit() else None


def _tasks_here():
    """Every task in this project, measured from the transcripts themselves."""
    root = _repo_root()
    tasks = {}
    for _, path in _sessions():
        info = _scan(path)
        if not info["out"]:
            continue
        task = _task_of(info.get("cwds") or info["cwd"], root)
        if task is None:
            continue
        t = tasks.setdefault(task, {"task": task, "out": 0, "sessions": 0,
                                    "agents": collections.Counter(),
                                    "first": "", "last": "", "cwd": info["cwd"]})
        t["out"] += info["out"]
        t["sessions"] += 1
        t["agents"] += info["agents"]
        for key, better in (("first", min), ("last", max)):
            if info[key]:
                t[key] = better(t[key], info[key]) if t[key] else info[key]
    return root, sorted(tasks.values(), key=lambda t: -t["out"])


def _this_session():
    """The transcript for the session calling this, if it can be identified."""
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not sid:
        return None
    for _, path in _sessions():
        if os.path.basename(path).startswith(sid[:8]):
            return path
    return None


def _git(*args):
    git = "/Library/Developer/CommandLineTools/usr/bin/git"
    if not os.path.exists(git):
        git = "git"
    try:
        return subprocess.run([git, *args], capture_output=True, text=True,
                              check=False).stdout.strip()
    except OSError:
        return ""


def cmd_log(task):
    """Append exactly one entry for this task. One per task, never per step."""
    path = _this_session()
    if not path:
        print("spend: CLAUDE_CODE_SESSION_ID not set -- cannot measure this "
              "session; writing the entry without token figures.",
              file=sys.stderr)
        out, agents = 0, collections.Counter()
    else:
        out, agents, _ = _read(path)

    branch = _git("rev-parse", "--abbrev-ref", "HEAD") or "?"
    landed = _git("rev-list", "--count", "main..HEAD") or "0"
    today = datetime.date.today().isoformat()

    roles = ", ".join(f"{k}×{v}" for k, v in agents.most_common()) or "none"
    entry = (
        f"\n## {today} · {task}\n"
        f"- branch: `{branch}` · commits landed: {landed}\n"
        f"- agents invoked: {roles}\n"
        f"- session output tokens: {out:,}\n"
    )
    with open(LOG, "a") as fh:
        fh.write(entry)
    print(f"AGENT-LOG.md: entry for {task} ({out:,} output tokens, {landed} commits)")


def _parse_log():
    """Entries already recorded in this project's AGENT-LOG.md."""
    if not os.path.exists(LOG):
        return []
    entries, cur = [], None
    with open(LOG, errors="replace") as fh:
        log_lines = fh.readlines()
    for line in log_lines:
        if line.startswith("## "):
            head = line[3:].strip()
            date, _, task = head.partition(" · ")
            cur = {"date": date, "task": task or head, "tokens": 0, "commits": 0,
                   "agents": ""}
            entries.append(cur)
        elif cur is not None:
            if "output tokens:" in line:
                cur["tokens"] = int(line.split(":")[-1].strip().replace(",", "") or 0)
            elif "commits landed:" in line:
                tail = line.rsplit(":", 1)[-1].strip()
                cur["commits"] = int(tail) if tail.isdigit() else 0
            elif "agents invoked:" in line:
                cur["agents"] = line.split(":", 1)[-1].strip()
    return entries


def cmd_report(by_agent=False):
    """Cost per task, measured from the transcripts -- never from prose.

    This used to parse AGENT-LOG.md for a `session output tokens:` line that
    only `spend log` ever wrote. Because the rules told sessions to keep that
    file by hand, finance-tracker had ten entries and none of them carried the
    field, so this command reported 0 for every row for a week. A number that
    can only be right if somebody remembered to type it is not a measurement.
    """
    root, tasks = _tasks_here()
    if not tasks:
        print(f"no sessions recorded under {root} yet.")
        return

    if by_agent:
        roles = collections.Counter()
        for t in tasks:
            roles += t["agents"]
        if not roles:
            print("no agent dispatches recorded in this project.")
            return
        print(f"{'role':24} {'calls':>6}")
        for name, n in roles.most_common():
            print(f"{name:24} {n:>6}")
        print(f"{'TOTAL':24} {sum(roles.values()):>6}")
        return

    total_t = total_c = 0
    print(f"{'started':11} {'task':34} {'tokens':>10} {'agents':>7} "
          f"{'commits':>8} {'per commit':>11}")
    for t in tasks:
        commits = _commits_in(t["cwd"])
        per = f"{t['out'] // commits:,}" if commits else "—"
        print(f"{t['first'][:10]:11} {t['task'][:34]:34} {t['out']:>10,} "
              f"{sum(t['agents'].values()):>7} "
              f"{(commits if commits is not None else '—'):>8} {per:>11}")
        total_t += t["out"]
        total_c += commits or 0
    per = f"{total_t // total_c:,}" if total_c else "—"
    print(f"{'':11} {'TOTAL':34} {total_t:>10,} "
          f"{sum(sum(t['agents'].values()) for t in tasks):>7} "
          f"{total_c:>8} {per:>11}")


def cmd_agentlog(write=False):
    """Generate AGENT-LOG.md from the transcripts instead of writing it by hand.

    Every fact the hand-written log held is already in the session records.
    Generating it removes the file from the merge surface -- and every merge
    conflict on 5 Aug 2026 was in a record file the framework itself invented.
    """
    root, tasks = _tasks_here()
    project = os.path.basename(root)
    lines = [
        f"# Agent log — {project}",
        "",
        "**Generated by `spend agentlog`. Do not edit by hand — regenerate.**",
        "",
        "Which agents ran on a task, what it cost, and over what span. Measured",
        "from the session transcripts, so it cannot disagree with what happened.",
        "",
        f"Tasks: {len(tasks)} · total output tokens: "
        f"{sum(t['out'] for t in tasks):,}",
        "",
        "| task | started | ended | output tokens | sessions | agents |",
        "|---|---|---|---:|---:|---|",
    ]
    for t in tasks:
        roles = ", ".join(f"{k}×{v}" for k, v in t["agents"].most_common()) or "—"
        lines.append(f"| {t['task']} | {t['first'][:10]} | {t['last'][:10]} | "
                     f"{t['out']:,} | {t['sessions']} | {roles} |")
    text = "\n".join(lines) + "\n"
    if write:
        with open(os.path.join(root, LOG), "w") as fh:
            fh.write(text)
        print(f"wrote {os.path.join(root, LOG)} — {len(tasks)} tasks")
    else:
        print(text, end="")


def cmd_today():
    day = datetime.date.today().isoformat()
    buckets = collections.Counter()
    for proj, path in _sessions():
        if "common-rules" in proj:
            b = "common-rules"
        elif "worktrees" in proj:
            b = "worktrees (doing the work)"
        elif "pockets" in proj:
            b = "pockets"
        else:
            b = "management chats"
        _, _, days = _read(path)
        buckets[b] += days.get(day, 0)

    total = sum(buckets.values())
    print(f"output tokens spent today ({day})")
    for name, n in buckets.most_common():
        share = 100 * n / total if total else 0
        bar = "█" * int(share / 2.5)
        print(f"  {name:28} {n:>9,}  {share:5.1f}%  {bar}")
    print(f"  {'TOTAL':28} {total:>9,}")


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == "log":
        if not rest:
            print("spend log <task-name>", file=sys.stderr)
            return 2
        cmd_log(" ".join(rest))
    elif cmd == "report":
        cmd_report(by_agent="--by-agent" in rest)
    elif cmd == "agentlog":
        cmd_agentlog(write="--write" in rest)
    elif cmd == "today":
        cmd_today()
    else:
        print(f"unknown command: {cmd}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
