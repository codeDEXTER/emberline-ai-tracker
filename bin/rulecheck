#!/usr/bin/env python3
"""rulecheck — is this project working against the current shared rules?

The rules change several times a day. A session that read them last week is
following a version that no longer exists, and nothing tells it so — the user
has to notice and say "check common rules" again. This answers that question
before any work starts, and shows *what* changed rather than only that
something did.

  rulecheck                 # compare this project against current, list what changed
  rulecheck --mandatory     # only the Standard change entries since the stamp (proposal 21, S-09)
  rulecheck --align         # record the current version, after reading the changes
  rulecheck --version       # print the current rules version and exit
  rulecheck --quiet         # print nothing when aligned (for hooks)

Exit codes: 0 aligned · 1 not aligned (behind, never aligned, a stamp that
cannot be resolved, or a stamp ahead of this rules checkout) · 2 could not
check at all -- run inside common-rules itself, a project that does not adopt
the rules, or the rules repo or its CHANGELOG unreadable. 2 is deliberately
its own status, distinct from both 0 and 1: it used to share exit 0 with
"aligned", so a session running this from inside common-rules got a friendly
sentence and an exit code that looked exactly like a pass, and had verified
nothing.

The version is `<commit-count>-<short-sha>` of common-rules — the count orders
it, the sha identifies it exactly. A project records the one it last aligned
with in `.common-rules-version` at its root, committed like any other record.
A stamp whose sha is the current HEAD's -- the short sha, the full sha or any
prefix between, in either case -- is aligned.

Not every folder under apps/ adopts these rules. `idea-lab` deliberately does
not — it is v2, governing what happens *before* anything is agreed, and its own
rules say "no gates, no worktrees, no issues here". This tool used to treat any
directory as an adopter and report it as never aligned, which left a permanent
false alarm that every session had to re-derive and dismiss; the one action it
offered would have stamped the project with a claim that is not true. So
adoption is now read rather than assumed, from the pointer README.md already
prescribes: a project adopts by referencing CLAUDE-workflow.md in its own
CLAUDE.md. Deriving it from that pointer means there is no second list to drift
out of date — the declaration and the check are the same fact.

MANDATORY STANDARD CHANGES (proposal 21, S-09; the sponsor's ruling A-03). A
CHANGELOG entry that changes the standard carries a requirement paragraph
beginning `**Standard change (mandatory):**`, and every adopting project
implements it before its stamp moves past it. `--mandatory` lists the entries
whose requirement paragraph gained a line since the stamp -- the same
`<stamp sha>..HEAD` delta the plain report quotes -- each under its `## `
heading. Exit 0 nothing to do (aligned, behind only on information, or ahead of
this rules checkout), 1 entries pending, 2 could not check (the rules repo or
its CHANGELOG cannot be read, or the project does not adopt). With no stamp,
every mandatory entry in the CHANGELOG counts. A stamp that cannot be resolved
-- not a sha, or a commit this rules repo does not have (a force-push removed
it) -- counts every one too, and always exits 1: it used to read "could not
check" and let a project past the gate. `mandatory_pending()` is the same
answer for bin/warmup's card and bin/conformance. `--align` now refuses by
itself when a mandatory Standard change is pending (state "behind" or "no
stamp" with entries): it writes nothing, lists each pending entry's title, and
says to rerun with `--align --implemented` once they are done. That declares
the entries implemented and moves the stamp, printing what was acknowledged so
the declaration is on record in the session output. `--align` with no
mandatory entry pending (aligned, ahead, or behind on information only) needs
no flag and behaves as before. A stamp that is "unresolvable" or that "could
not check" refuses too -- `--implemented` does not override either, since
rulecheck cannot tell what is actually pending in those states.

A stamp is a committed file in the project, not something this tool wrote, so
its sha part reaches git only when it is a hex sha (lowercased). It used to go
into `git diff <sha>..HEAD` unchecked: a stamp of `1---output=<path>` made this
read-only check create a file.
"""
from __future__ import annotations

import argparse
import bisect
import os
import re
import subprocess
import sys
from collections import Counter
from pathlib import Path
from typing import NamedTuple

# Self-located, not a hardcoded path. The default used to be
# "/Users/aashish/apps/common-rules" -- correct on exactly one machine, and
# absent on every CI runner, where `git -C <missing>` fails, current_version()
# returns None and `--version` exits 2. That errored 11 gate tests on every CI
# run and was invisible for weeks, because the only place the fallback is ever
# exercised is a machine where the hardcoded path happens to exist.
#
# A script always knows where it lives. COMMON_RULES_DIR still wins when set,
# which is how the tests point it at a fixture repo.
RULES = Path(os.environ.get("COMMON_RULES_DIR",
                            str(Path(__file__).resolve().parent.parent)))
STAMP = ".common-rules-version"
# Command Line Tools git, because a pending Xcode licence breaks plain `git`.
GIT = next((g for g in ("/Library/Developer/CommandLineTools/usr/bin/git",
                        "/usr/bin/git") if Path(g).exists()), "git")

MARKER = "**Standard change (mandatory):**"
NO_HEADING = "(before the first ## heading)"
_SHA = re.compile(r"[0-9a-f]{4,40}")
_HUNK = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@")
# A dated CHANGELOG entry heading: a fence never spans one (S-09 final review).
_ENTRY_HEADING = re.compile(r"^## \d{4}-\d{2}-\d{2}")
_FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")


def git(*args, cwd=RULES):
    # errors="replace": a CHANGELOG that is not UTF-8 is a malformed record,
    # not a reason for a traceback.
    r = subprocess.run([GIT, "-C", str(cwd), *args], capture_output=True, text=True, errors="replace")
    return r.stdout.strip() if r.returncode == 0 else None


def _run(cwd, *args):
    """(returncode, git's stdout exactly -- unstripped, so line numbers still
    line up), or (None, None) when git cannot be run."""
    try:
        r = subprocess.run([GIT, "-C", str(cwd), *args], capture_output=True, check=False)
    except OSError:
        return None, None
    return r.returncode, r.stdout.decode("utf-8", errors="replace")


def _read(cwd, *args):
    rc, out = _run(cwd, *args)
    return out if rc == 0 else None


def current_version(cwd=RULES):
    count, sha = git("rev-list", "--count", "HEAD", cwd=cwd), git("rev-parse", "--short", "HEAD", cwd=cwd)
    return f"{count}-{sha}" if count and sha else None


# Bidi controls and invisible characters; see shown().
_REORDER_OR_HIDE = frozenset([0x061C, 0x200B, 0x200E, 0x200F, *range(0x202A, 0x202F),
                              *range(0x2060, 0x2065), *range(0x2066, 0x206A), 0xFEFF])


def shown(value) -> str:
    """A value from a CHANGELOG or a stamp, safe to print on one line.

    The same escaping as bin/warmup's shown(), which the card uses, and pinned
    equal to it by tests/test_rulecheck.py. Copied rather than imported:
    rulecheck is imported by warmup, and it must stay loadable on its own.
    C0, DEL and C1 become visible escapes, a lone surrogate becomes U+FFFD,
    bidi controls and invisible characters become \\uXXXX, None becomes ""."""
    if value is None:
        return ""
    out = []
    for ch in str(value):
        cp = ord(ch)
        if 0xD800 <= cp <= 0xDFFF:
            out.append("�")
        elif ch == "\n":
            out.append("\\n")
        elif ch == "\r":
            out.append("\\r")
        elif ch == "\t":
            out.append("\\t")
        elif cp < 0x20 or cp == 0x7F or 0x80 <= cp <= 0x9F:
            out.append(f"\\x{cp:02x}")
        elif cp in _REORDER_OR_HIDE:
            out.append(f"\\u{cp:04x}")
        else:
            out.append(ch)
    return "".join(out)


def find_project(start):
    """Nearest ancestor holding a stamp, a CLAUDE.md, or a .git — in that order.

    Worktrees live at <project>/.claude/worktrees/<name>/, so the answer must be
    the worktree itself (it has its own CLAUDE.md checkout), not the parent repo.
    """
    p = Path(start).resolve()
    for d in (p, *p.parents):
        if (d / STAMP).exists() or (d / "CLAUDE.md").exists() or (d / ".git").exists():
            return d
    return p


def adopts_rules(proj, rules=RULES):
    """Does this project declare that it follows the shared rules?

    README.md, "How a project adopts this": add a short pointer near the top of
    the project's own CLAUDE.md. That pointer is the declaration, so it is also
    the check — no separate roster to fall out of date. (CLAUDE-workflow.md's
    own "Adopted:" line had done exactly that: it still named two projects after
    four had adopted.)

    An existing stamp also counts. A project that has aligned before has already
    declared itself, and a check should never un-adopt a project because someone
    reworded its CLAUDE.md.
    """
    if proj == rules or Path(proj).resolve() == Path(rules).resolve():
        return False            # the rules do not adopt themselves
    if (proj / STAMP).exists():
        return True
    claude_md = proj / "CLAUDE.md"
    if not claude_md.exists():
        return False
    try:
        return "CLAUDE-workflow.md" in claude_md.read_text(errors="replace")
    except OSError:
        return False


def stamp_sha(stamp_value):
    """The sha a stamp's `<count>-<sha>` names, lowercased, or None when the sha
    part is not a hex sha. Checked before it reaches git as an argument: a stamp
    of `1---output=<path>` otherwise becomes `git diff --output=<path>..HEAD`.
    Lowercased so `2-1B412F1` is the same commit as `2-1b412f1`."""
    if stamp_value is None:
        return None
    sha = str(stamp_value).split("-", 1)[-1].lower()
    return sha if _SHA.fullmatch(sha) else None


def stamp_is_current(sha, rules=RULES):
    """Is `sha` (from stamp_sha) the rules HEAD? A prefix match in both
    directions: the stamp's sha starts with HEAD's short sha, and HEAD's full
    sha starts with the stamp's. So the short sha, the full sha and any prefix
    between them all match; a prefix shorter than the short sha does not."""
    if not sha:
        return False
    full, short = git("rev-parse", "HEAD", cwd=rules), git("rev-parse", "--short", "HEAD", cwd=rules)
    return bool(full and short) and sha.startswith(short.lower()) and full.lower().startswith(sha)


def resolve_commit(sha, rules=RULES):
    """The full sha of the commit `sha` names in the rules repo, or None: not a
    hex sha, ambiguous, not a commit, or not in this repo (a force-push)."""
    if not sha or not _SHA.fullmatch(sha):
        return None
    out = _read(rules, "rev-parse", "--verify", "--quiet", f"{sha}^{{commit}}")
    full = out.strip().lower() if out else ""
    return full if re.fullmatch(r"[0-9a-f]{40}", full) else None


def changes_since(old_sha):
    """Lines added to CHANGELOG.md since that commit — the actual delta."""
    if not old_sha or not _SHA.fullmatch(old_sha):
        return None
    diff = git("diff", f"{old_sha}..HEAD", "--", "CHANGELOG.md")
    if diff is None:
        return None
    out = []
    for line in diff.splitlines():
        if line.startswith("+") and not line.startswith("+++"):
            text = line[1:].rstrip()
            if text.strip():
                out.append(text)
    return out


class Entry(NamedTuple):
    """One CHANGELOG entry carrying a Standard change: its `## ` heading (without
    the `## `) and, for every requirement paragraph in it that counted, that
    paragraph joined onto one line, in file order. Raw: escape with shown()."""
    heading: str
    lines: tuple

    @property
    def line(self) -> str:
        return self.lines[0]


class Pending(NamedTuple):
    """mandatory_pending()'s answer.

    state    aligned · behind · ahead · unresolvable · no stamp · not adopting ·
             could not check
    stamp    the stamp as written (None with no stamp, or one that cannot be read)
    current  the rules version (None when the rules repo cannot be read)
    entries  behind: the entries whose requirement changed since the stamp;
             no stamp and unresolvable: every entry in the CHANGELOG;
             otherwise empty. Topmost (newest) first.
    why      for could not check and unresolvable, what could not be read"""
    state: str
    stamp: str | None
    current: str | None
    entries: tuple
    why: str = ""


class _Paragraph(NamedTuple):
    heading_at: int     # line number of its `## ` heading, 0 for none
    heading: str
    start: int          # 1-based, the marker line
    end: int            # 1-based, inclusive
    lines: tuple        # the raw lines, "\r" removed


def _fenced(lines):
    """Indexes (0-based) of every line inside a closed fenced code block, the
    fences included. A fence is ``` or ~~~ (three or more, up to three spaces
    in), closed by a line of at least as many of the same character and nothing
    else. A fence that never closes opens nothing: an unbalanced ``` fails
    closed, so it cannot hide every Standard change after it. A fence never
    spans a dated entry heading (`## YYYY-MM-DD`): an unclosed fence in a new
    entry used to pair with an older entry's fence and hide the new entry's
    own requirement (S-09 final review). A `## ` line that is not a dated
    heading can still sit inside a fence."""
    closers: dict[str, list[tuple[int, int]]] = {"`": [], "~": []}
    for i, line in enumerate(lines):
        m = _FENCE.match(line)
        if m and not m.group(2).strip(" \t"):
            closers[m.group(1)[0]].append((i, len(m.group(1))))
    index = {ch: [i for i, _ in c] for ch, c in closers.items()}
    entry_headings = [i for i, line in enumerate(lines) if _ENTRY_HEADING.match(line)]
    inside, i = set(), 0
    while i < len(lines):
        m = _FENCE.match(lines[i])
        if not m or (m.group(1)[0] == "`" and "`" in m.group(2)):
            i += 1
            continue
        ch, length = m.group(1)[0], len(m.group(1))
        c = closers[ch]
        after = bisect.bisect_right(entry_headings, i)
        limit = entry_headings[after] if after < len(entry_headings) else len(lines)
        close = next((j for j, n in c[bisect.bisect_right(index[ch], i):] if n >= length and j < limit), None)
        if close is None:
            i += 1
            continue
        inside.update(range(i, close + 1))
        i = close + 1
    return inside


def _paragraphs(text):
    """Every requirement paragraph in CHANGELOG text, in file order.

    A requirement paragraph is a line starting MARKER at column 0, outside a
    fenced code block, and the lines after it up to a blank line, a `## `
    heading, another marker line or a fenced block. An indented, quoted,
    mid-line or fenced mention is prose about the convention, not an instance
    of it; a `## ` line inside a fence is not a heading. Lines are split on
    "\\n" only, the way git numbers them: str.splitlines() also splits on \\x0b,
    \\x0c, \\x85 and U+2028, which would shift every line number after one."""
    if text is None:
        return []
    lines = [raw[:-1] if raw.endswith("\r") else raw for raw in text.split("\n")]
    fenced = _fenced(lines)
    out, heading_at, heading = [], 0, NO_HEADING
    for i, line in enumerate(lines):
        if i in fenced:
            continue
        if line.startswith("## "):
            # strip(" \t") only: str.strip() would also eat a trailing \x85 or
            # \x0c, and those must reach shown() to be escaped, not vanish.
            heading_at, heading = i + 1, (line[3:].strip(" \t") or "(untitled heading)")
            continue
        if line.startswith(MARKER):
            j = i + 1
            while (j < len(lines) and j not in fenced and lines[j].strip(" \t")
                   and not lines[j].startswith("## ") and not lines[j].startswith(MARKER)):
                j += 1
            out.append(_Paragraph(heading_at, heading, i + 1, j, tuple(lines[i:j])))
    return out


def _group(paragraphs):
    """Entries from paragraphs, one per heading, topmost first. Each paragraph
    is quoted on one line: the CHANGELOG wraps at 80 columns, and the first
    physical line alone cut off what the project must do."""
    found: dict[int, tuple[str, list[str]]] = {}
    for p in paragraphs:
        quote = " ".join([p.lines[0].rstrip(" \t"), *(l.strip(" \t") for l in p.lines[1:])])
        found.setdefault(p.heading_at, (p.heading, []))[1].append(quote)
    return tuple(Entry(h, tuple(q)) for _, (h, q) in sorted(found.items()))


def _entries(text):
    return _group(_paragraphs(text))


def _added_line_numbers(diff):
    """1-based line numbers, in the new file, of every line a -U0 diff adds --
    and, for a hunk that only deletes (`+c,0`), the lines either side of where
    the deletion was, so deleting a line of what a Standard change asks counts
    (S-09 final review). An untouched paragraph next to a deletion is still not
    pending: mandatory_since() finds it unchanged at the stamp."""
    added, n = set(), None
    for line in diff.split("\n"):
        m = _HUNK.match(line)
        if m:
            n = int(m.group(1))
            if m.group(2) == "0":
                added.update({max(n, 1), n + 1})
            continue
        if n is None:
            continue
        if line.startswith("+"):
            added.add(n)
            n += 1
        elif line.startswith(" "):
            n += 1
        elif line.startswith("-") or line.startswith("\\"):
            pass
        else:
            n = None            # a file header: not hunk content
    return added


def mandatory_in_changelog(rules=RULES):
    """Every Standard change entry in the rules CHANGELOG at HEAD, or None when
    it cannot be read."""
    head = _read(rules, "show", "--no-textconv", "HEAD:CHANGELOG.md")
    return None if head is None else _entries(head)


def mandatory_since(sha, rules=RULES):
    """The Standard change entries whose requirement changed since `sha`, or
    None when that cannot be told (not a sha, not a commit here, no CHANGELOG
    at HEAD).

    An entry is pending when any line the `<sha>..HEAD` diff of CHANGELOG.md
    adds -- the delta changes_since() quotes -- falls inside one of its
    requirement paragraphs (the span _paragraphs() quotes), unless that exact
    paragraph under that exact heading was already in the CHANGELOG at `sha`.
    So:
      * a new entry, or a marker added inside an older entry, is pending;
      * rewording, adding or deleting any line of what a Standard change asks
        is pending, and so is re-wrapping it -- the lines are compared as
        written;
      * an entry moved above or below another, otherwise unchanged, is not:
        a diff cannot tell a move from an addition, and the paragraph was
        already there at the stamp;
      * a line added elsewhere in the entry (its reasons, a note after the
        paragraph) is not;
      * a marker inside a fenced code block is not a Standard change at all.
    --text, because a NUL byte would otherwise make git print "Binary files
    differ" and hide every line. A CHANGELOG absent at `sha` has no
    paragraphs, so every one touched since counts."""
    full = resolve_commit(sha, rules)
    if full is None:
        return None
    head = _read(rules, "show", "--no-textconv", "HEAD:CHANGELOG.md")
    if head is None:
        return None
    diff = _read(rules, "diff", "--no-color", "--no-ext-diff", "--no-textconv", "--text", "-U0",
                 f"{full}..HEAD", "--", "CHANGELOG.md")
    if diff is None:
        return None
    added = _added_line_numbers(diff)
    before = Counter((p.heading, p.lines)
                     for p in _paragraphs(_read(rules, "show", "--no-textconv", f"{full}:CHANGELOG.md")))
    paragraphs = _paragraphs(head)
    touched = [any(n in added for n in range(p.start, p.end + 1)) for p in paragraphs]
    # Paragraphs nobody touched account for their own copies first, so a new
    # duplicate of an unchanged paragraph is not mistaken for a moved one.
    for p, t in zip(paragraphs, touched):
        if not t and before[(p.heading, p.lines)] > 0:
            before[(p.heading, p.lines)] -= 1
    pending = []
    for p, t in zip(paragraphs, touched):
        if not t:
            continue
        if before[(p.heading, p.lines)] > 0:
            before[(p.heading, p.lines)] -= 1       # moved, not changed
        else:
            pending.append(p)
    return _group(pending)


def mandatory_pending(project, rules=None) -> Pending:
    """What `project` must implement before its stamp may move. Reads only."""
    rules = Path(rules) if rules is not None else RULES
    proj = Path(project).resolve()
    cur = current_version(rules)
    if not cur:
        return Pending("could not check", None, None, (), f"cannot read the rules repo at {rules}")
    if not adopts_rules(proj, rules):
        return Pending("not adopting", None, cur, ())
    stamp = proj / STAMP

    def whole(state, was, why=""):
        entries = mandatory_in_changelog(rules)
        if entries is None:
            return Pending("could not check", was, cur, (), "the rules CHANGELOG.md cannot be read")
        return Pending(state, was, cur, entries, why)

    if not stamp.exists():
        return whole("no stamp", None)
    try:
        was = stamp.read_text(errors="replace").strip()
    except OSError:
        return whole("unresolvable", None, f"{STAMP} cannot be read")
    sha = stamp_sha(was)
    if was == cur or stamp_is_current(sha, rules):
        return Pending("aligned", was, cur, ())
    full = resolve_commit(sha, rules)
    if full is None:
        return whole("unresolvable", was, f"{STAMP} names no commit in the rules repo")
    rc, _ = _run(rules, "merge-base", "--is-ancestor", full, "HEAD")
    if rc == 1:
        # Not an ancestor of HEAD: truly ahead (HEAD is an ancestor of the
        # stamp), or diverged -- a side branch, or a commit rebased away whose
        # object is still present. Diverged is compared tree to tree, like a
        # stamp behind; calling it "ahead" hid what main added since (S-09
        # final review).
        back, _ = _run(rules, "merge-base", "--is-ancestor", "HEAD", full)
        if back == 0:
            return Pending("ahead", was, cur, ())
        if back != 1:
            return Pending("could not check", was, cur, (), "cannot tell whether the stamp is behind the rules HEAD")
    elif rc != 0:
        return Pending("could not check", was, cur, (), "cannot tell whether the stamp is behind the rules HEAD")
    since = mandatory_since(full, rules)
    if since is None:
        return Pending("could not check", was, cur, (), "the rules CHANGELOG.md cannot be read")
    return Pending("behind", was, cur, since)


def unresolvable_line(stamp) -> str:
    shown_stamp = "(unreadable)" if stamp is None else shown(stamp)
    return f"stamp {shown_stamp} cannot be resolved -- every mandatory Standard change counts"


def report_mandatory(proj, quiet):
    p = mandatory_pending(proj)
    name = shown(proj.name)
    if p.state == "could not check":
        print(f"{name}: could not check for mandatory Standard changes -- {shown(p.why)}. "
              f"Not guessing: re-read the rules in full.")
        return 2
    if p.state == "not adopting":
        if not quiet:
            if proj == RULES:
                print(f"common-rules is the rules themselves — nothing to align against. "
                      f"Current version: {p.current}.")
            else:
                print(f"{name} does not adopt the shared rules — nothing to check.")
        return 2
    if p.state == "aligned":
        if not quiet:
            print(f"{name} is aligned with common-rules {p.current} -- no mandatory Standard change pending.")
        return 0
    if p.state == "ahead":
        if not quiet:
            print(f"{name} is on common-rules {shown(p.stamp)}; current is {p.current}: "
                  f"ahead of this rules checkout -- update common-rules.")
        return 0
    n = len(p.entries)
    if p.state == "unresolvable":
        print(f"{name}: {unresolvable_line(p.stamp)} (current: {p.current}).")
        if not n:
            print("The rules CHANGELOG carries no mandatory Standard change -- re-read the rules, "
                  "then `rulecheck --align`.")
            return 1
        print(f"{n} mandatory Standard change(s) in the rules CHANGELOG -- implement each first, "
              f"then `rulecheck --align`:")
    elif not n:
        if not quiet:
            if p.state == "no stamp":
                print(f"{name} has never recorded a rules version (current: {p.current}); the rules "
                      f"CHANGELOG carries no mandatory Standard change.")
            else:
                print(f"{name} is on common-rules {shown(p.stamp)}; current is {p.current}: no mandatory "
                      f"Standard change since the stamp -- what changed is information. Read it "
                      f"(`rulecheck`), then `rulecheck --align`.")
        return 0
    elif p.state == "no stamp":
        print(f"{name} has never recorded a rules version (current: {p.current}). The rules CHANGELOG "
              f"carries {n} mandatory Standard change(s) -- implement each first, then `rulecheck --align`:")
    else:
        print(f"{name} is on common-rules {shown(p.stamp)}; current is {p.current}. {n} mandatory "
              f"Standard change(s) since the stamp -- implement each first, then `rulecheck --align`:")
    for e in p.entries:
        print(f"  {shown(e.heading)}")
        for line in e.lines:
            print(f"    {shown(line)}")
    return 1


def main():
    ap = argparse.ArgumentParser(prog="rulecheck", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--project", default=None, help="default: nearest project above cwd")
    ap.add_argument("--align", action="store_true", help="record the current version")
    ap.add_argument("--implemented", action="store_true",
                    help="with --align: declare pending mandatory Standard change(s) implemented")
    ap.add_argument("--mandatory", action="store_true",
                    help="list the Standard change entries since the stamp; exit 1 while any is pending")
    ap.add_argument("--version", action="store_true", help="print current version, exit")
    ap.add_argument("--quiet", action="store_true", help="say nothing when aligned")
    a = ap.parse_args()
    if a.align and a.mandatory:
        ap.error("--mandatory reads; --align writes. Run them separately.")
    if a.implemented and not a.align:
        ap.error("--implemented only means something with --align.")

    cur = current_version()
    if not cur:
        print(f"cannot read the rules repo at {RULES} — not checking, not guessing.",
              file=sys.stderr)
        return 2
    if a.version:
        print(cur)
        return 0

    proj = Path(a.project).resolve() if a.project else find_project(os.getcwd())
    stamp = proj / STAMP

    if a.mandatory:
        return report_mandatory(proj, a.quiet)

    if not adopts_rules(proj):
        if proj == RULES:
            # Running inside common-rules itself, which is the usual way this is
            # hit: the rules are the thing being versioned, not a follower of it.
            # Exit 2, not 0 -- nothing was actually verified here, and a session
            # that reads exit 0 as "checked, and fine" learns nothing from a run
            # that checked nothing. That is exactly the mistake this exists to
            # stop: a vacuous run inside common-rules itself, treated as a pass.
            if not a.quiet:
                print("common-rules is the rules themselves — nothing to align "
                      f"against. Current version: {cur}.")
            return 2
        if a.align:
            # Refusing is the point. The stamp is a claim that a session read
            # these rules and that this project follows them; writing one into a
            # project that does not is a false record, and the next session
            # inherits it and skips the check.
            print(f"{proj.name} does not adopt the shared rules — not stamping it.",
                  file=sys.stderr)
            print(f"Nothing in {proj.name}/CLAUDE.md points at CLAUDE-workflow.md. "
                  f"If it should adopt them, add that pointer first (README.md, "
                  f"'How a project adopts this'), then align.", file=sys.stderr)
            return 2
        if not a.quiet:
            print(f"{proj.name} does not adopt the shared rules — nothing to check.")
        # Same reasoning as the common-rules case above: this checked nothing,
        # so it must not read as 0 (aligned) or 1 (stale) -- both would claim a
        # verification that never happened.
        return 2

    if a.align:
        pending = mandatory_pending(proj)
        if pending.state == "could not check":
            print(f"{proj.name}: could not check for mandatory Standard changes -- {shown(pending.why)}. "
                  f"Not aligning: not guessing whether one is pending.", file=sys.stderr)
            return 2
        if pending.state == "unresolvable":
            print(f"{proj.name}: {unresolvable_line(pending.stamp)}. Not aligning.", file=sys.stderr)
            if pending.entries:
                print(f"{len(pending.entries)} mandatory Standard change(s) in the rules CHANGELOG -- "
                      f"implement each, then re-read the rules in full and `rulecheck --align`:",
                      file=sys.stderr)
                for e in pending.entries:
                    print(f"  {shown(e.heading)}", file=sys.stderr)
            return 1
        if pending.entries and not a.implemented:
            print(f"{proj.name}: {len(pending.entries)} mandatory Standard change(s) pending -- "
                  f"implement these, then rerun with `rulecheck --align --implemented`:")
            for e in pending.entries:
                print(f"  {shown(e.heading)}")
            return 1
        stamp.write_text(cur + "\n")
        if pending.entries and a.implemented:
            titles = "; ".join(shown(e.heading) for e in pending.entries)
            print(f"aligned {proj.name} with common-rules {cur} -- aligned past {len(pending.entries)} "
                  f"mandatory change(s), declared implemented: {titles}")
        else:
            print(f"aligned {proj.name} with common-rules {cur}")
        return 0

    if not stamp.exists():
        print(f"{proj.name} has NEVER recorded a rules version (current: {cur}).")
        print(f"Read {RULES}/CLAUDE-workflow.md, then `rulecheck --align`.")
        return 1

    was = stamp.read_text().strip()
    sha = stamp_sha(was)
    if was == cur or stamp_is_current(sha):
        if not a.quiet:
            print(f"{proj.name} is aligned with common-rules {cur}.")
        return 0

    print(f"{proj.name} is on common-rules {shown(was)}; current is {cur}.")
    full = resolve_commit(sha)
    if full is None:
        # Not "could not check" (2): that let a project whose stamp names no
        # commit here -- a force-push, a typo -- past every gate reading 2.
        print(f"{unresolvable_line(was)}. Re-read the rules in full (`rulecheck --mandatory` "
              f"lists what they require), then `rulecheck --align`.")
        return 1
    if (_run(RULES, "merge-base", "--is-ancestor", full, "HEAD")[0] == 1
            and _run(RULES, "merge-base", "--is-ancestor", "HEAD", full)[0] == 0):
        # Truly ahead is not a problem: bin/land's advice to align would move
        # the stamp backwards. A diverged stamp falls through and reads behind.
        print("ahead of this rules checkout -- update common-rules, then check again.")
        return 0
    added = changes_since(full)
    if added is None:
        print(f"Cannot diff from {shown(was)} — the rules CHANGELOG.md cannot be read. "
              f"Re-read the rules in full rather than trusting the stamp.")
        return 2
    if added:
        print(f"\nWhat changed since ({len(added)} changelog lines):\n")
        for line in added:
            print("  " + line)
    else:
        print("\nNo changelog lines added — a change that did not document itself, "
              "which is itself worth a look.")
    print(f"\nRead the sections these touch before starting. Then `rulecheck --align`.")
    return 1


if __name__ == "__main__":
    sys.exit(main())
