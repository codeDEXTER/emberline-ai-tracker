def e(s):
    return html.escape(str(s))


def unavailable(label):
    return f'<p class="na">{e(label)} · unavailable</p>'


def region(title, sub, body, err=None, label=None):
    """One region. A failed collector renders this region empty with a note —
    never a 500 for the whole page, same contract as before."""
    out = [f'<div class="rgn"><p class="ht">{title}</p>']
    if sub:
        out.append(f'<p class="sub">{sub}</p>')
    out.append(body)
    if err:
        out.append(unavailable(label or "region"))
    out.append("</div>")
    return "\n".join(out)


def render_sessions(worktrees, contested, hulls, needs_input):
    if not worktrees:
        return unavailable("no worktrees found")

    # One note per contested pair, naming one file — unchanged from the SVG
    # version. What changed is that it is attached to the cards it concerns
    # rather than drawn as a 470px diagonal with a caption floating at its
    # midpoint over empty grid. Issue #51 promotes these to the "needs you"
    # band; until then the information stays where it can be read.
    cont_note, seen = {}, set()
    for a, b, f in contested:
        key = frozenset((a, b))
        if key in seen:
            continue
        seen.add(key)
        for n in (a, b):
            cont_note.setdefault(n, f)

    def card(w):
        age_s = (time.time() - w["session"]) if w["session"] else None
        is_you = w["name"] in needs_input
        is_cont = w["name"] in cont_note
        # Priority unchanged: needs-you outranks contested, which outranks
        # plain freshness.
        if is_you:
            cls = "you"
        elif is_cont:
            cls = "cont"
        elif age_s is not None and age_s < 180:
            cls = "live"
        elif age_s is not None and age_s < 1800:
            cls = "act"
        else:
            cls = ""
        title = w.get("issue_title") or w["short"]
        # title="" carries the untruncated string even when CSS clamps the box.
        parts = [f'<div class="node {cls}">',
                 f'<p class="ttl clamp2" title="{e(title)}">{e(title)}</p>']
        meta = []
        if w.get("issue_title"):
            # Only worth a second line when the heading is the issue title —
            # with no mapped issue the heading already *is* the worktree name,
            # and repeating it reads as two different facts about the card.
            meta.append(f'{e(project_tag(w["project"]))} #{e(w["issue"])}')
            meta.append(e(w["short"]))
        if age_s is not None:
            meta.append(e(ago(w["session"])))
        if meta:
            parts.append(f'<p class="meta clamp1">{" · ".join(meta)}</p>')
        if is_you:
            parts.append('<p class="flag you">needs you</p>')
        if is_cont:
            parts.append(f'<p class="flag cont clamp1">contested · '
                         f'{e(cont_note[w["name"]])}</p>')
        parts.append("</div>")
        return "".join(parts)

    by_name = {w["name"]: w for w in worktrees}
    grouped, out = set(), []
    for hull in hulls:
        members = [by_name[n] for n in hull["members"] if n in by_name]
        if not members:
            continue
        grouped.update(w["name"] for w in members)
        label = (f'FEATURE · {hull["prefix"].upper()} · {hull["total"]} tickets, 1 active'
                 if hull["single"] else
                 f'FEATURE · {hull["prefix"].upper()} · {hull["total"]} TICKETS')
        out.append(f'<div class="feat"><p class="flabel">{e(label)}</p>'
                   f'<div class="nodes">{"".join(card(w) for w in members)}</div></div>')
    loose = [w for w in worktrees if w["name"] not in grouped]
    if loose:
        out.append(f'<div class="nodes" style="margin-top:var(--gap-2)">'
                   f'{"".join(card(w) for w in loose)}</div>')
    return "\n".join(out)


def issue_label(row, title):
    """`finance #41 the Ticket Rail` — the project tag is not decoration: with
    six repos on one screen a bare "#22" names two different tickets."""
    tag = project_tag(row.get("project", "")) if row.get("project") else ""
    return f'{tag} #{row["number"]} {title}'.strip()


def chip(label, cls=""):
    return (f'<div class="chip {cls} clamp1" title="{e(label)}">{e(label)}</div>')


def strip_prefix(title):
    return title.split(":", 1)[-1].strip() if ":" in title else title


def render_pipeline(pipeline, wall):
    out = []
    if pipeline is None:
        out.append(unavailable("pipeline"))
    else:
        n_flight = len(pipeline["in_flight"]) + len(pipeline["in_flight_worktrees"])
        out.append(f'<p class="psec">IN FLIGHT · {n_flight}</p>')
        if n_flight:
            for r in pipeline["in_flight"]:
                out.append(chip(issue_label(r, strip_prefix(r["title"])), "done"))
            # Ahead-of-main worktrees with no mapped issue — worktree-named,
            # never an invented issue chip. Issue #51 collapses these behind a
            # disclosure so the in-flight count stops overstating the work.
            for w in pipeline["in_flight_worktrees"]:
                out.append(chip(f'{w["short"]} · {w["ahead"]} ahead'))
        else:
            out.append('<p class="sub">none</p>')

        out.append(f'<p class="psec">QUEUED · '
                   f'{len(pipeline["queued"]) + pipeline["queued_more"]}</p>')
        for r in pipeline["queued"]:
            out.append(chip(issue_label(r, strip_prefix(r["title"]))))
        if pipeline["queued_more"]:
            out.append(f'<p class="sub">+{pipeline["queued_more"]} more</p>')

        out.append(f'<p class="psec">MERGED TODAY · {len(pipeline["merged"])}</p>')
        if pipeline["merged"]:
            for r in pipeline["merged"]:
                out.append(chip(issue_label(r, r["title"])))
        else:
            out.append('<p class="sub">none yet</p>')

    out.append('<p class="psec" style="color:var(--purple)">'
               'AT THE WALL · YOURS · likely waiting (heuristic)</p>')
    if wall:
        for item in wall:
            out.append(chip(f'{item["worktree"]} · waiting ~{item["age"]}', "wall"))
    else:
        out.append('<p class="sub">nothing waiting</p>')
    return "\n".join(out)


MAX_PACKAGES_SHOWN = 4


def render_burnup(burnup):
    """APPS & WORK PACKAGES — how much of each app's declared scope is done
    (issue #38, proposal 08 step 1b).

    Reads what the projects already write. No ETA column: that needs the
    logbook, which was proposed and not accepted, and a forecast drawn from
    four active days would be a slope through noise.
    """
    if burnup is None:
        return unavailable("work packages")
    rows = ['<div class="pkgs">']
    for row in burnup["apps"]:
        pct = row["done"] / row["total"]
        rows.append(
            f'<div class="nm clamp1">{e(row["name"])}</div>'
            f'<div class="bar"><i style="width:{round(pct * 100)}%"></i></div>'
            f'<div class="fig">{round(pct * 100)}%</div>'
            f'<div class="note">{row["done"]} / {row["total"]} items · '
            f'{len(row["packages"])} packages</div>')
        shown = sorted(row["packages"], key=lambda p: -p["total"])[:MAX_PACKAGES_SHOWN]
        for p in shown:
            frac = p["done"] / p["total"]
            # amber under a third: the eye should find the stalled package
            # without reading the numbers, and green-for-everything hides it.
            cls = "soft" if frac >= 0.34 else "warn"
            rows.append(
                f'<div class="nm sub2 clamp1" title="{e(p["name"])}">{e(p["name"])}</div>'
                f'<div class="bar thin"><i class="{cls}" style="width:{round(frac * 100)}%"></i></div>'
                f'<div class="fig">{p["done"]}/{p["total"]}</div>'
                f'<div class="note">{round(frac * 100)}%</div>')
        rest = len(row["packages"]) - len(shown)
        if rest > 0:
            rows.append(f'<div class="nm sub2">+ {rest} more package(s)</div>'
                        f'<div></div><div></div><div></div>')
    rows.append("</div>")
    if burnup["undeclared"]:
        rows.append(f'<p class="sub">{e(" · ".join(burnup["undeclared"]))} — no '
                    f'checklist file, so no declared scope to measure (not 0%)</p>')
    if burnup["unparsed"]:
        # Never let a line vanish into a lower denominator — see
        # PULSE.checklist_progress and proposal 08's load-bearing-prose limit.
        rows.append(f'<p class="sub" style="color:var(--amber)">{burnup["unparsed"]} '
                    f'line(s) look like items but could not be parsed, and are '
                    f'not counted above</p>')
    return "\n".join(rows)


def render_handovers(rows):
    """HANDOVERS — who told what to whom, and when (issue #22).

    Concept 07 drew these as edges between session nodes. They are a list
    instead, and that is a finding rather than a shortcut: measured over the
    real corpus, no message had a drawn node at *both* ends, so edges would
    have rendered almost never. See message_edges() for the numbers.
    """
    if rows is None:
        return unavailable("handovers")
    if not rows:
        return '<p class="sub">no messages between sessions yet</p>'
    out = []
    for r in rows[:MAX_HANDOVERS]:
        when = r["ts"][11:16] if len(r["ts"]) > 15 else ""
        arrow = f'{r["sender"]}  →  {r["to_label"]}'
        out.append(
            f'<a class="hand" href="/session/{e(r["to_session"])}">'
            f'<span class="top"><span class="who clamp1" title="{e(arrow)}">{e(arrow)}</span>'
            f'<span class="when">{e(when)}</span></span>'
            f'<span class="smry clamp2">{e(r["summary"])}</span></a>')
    rest = len(rows) - MAX_HANDOVERS
    if rest > 0:
        out.append(f'<p class="sub">+{rest} older</p>')
    return "\n".join(out)


def render_ticker(ticker):
    if not ticker:
        return unavailable("ticker")
    out = []
    for ts, repo, sha, subj in ticker:
        t = datetime.datetime.fromtimestamp(ts).strftime("%H:%M")
        out.append(f'<div class="tick"><span class="t">{e(t)}</span>'
                   f'<span class="repo">{e(repo)}</span>'
                   f'<span class="clamp1" title="{e(subj)}">{e(subj)}</span></div>')
    return "\n".join(out)


def render_header(header, wall_count):
    if header:
        behind = [c for c in header["chips"] if c["state"] != "aligned"]
        aligned = len(header["chips"]) - len(behind)
        bits = [f'rules {e(header["rules"])}']
        if aligned:
            bits.append(f'<span style="color:var(--green)">●</span> {aligned} aligned')
        if behind:
            # Every project named inline overran the header once discovery
            # found six of them. The signal is which ones are *not* aligned, so
            # those keep their names (up to three) and the rest is a count.
            named = ", ".join(c["name"] for c in behind[:3])
            rest = len(behind) - 3
            bits.append(f'<span style="color:var(--amber)">△</span> {len(behind)} '
                        f'behind: {e(named)}{f" +{rest}" if rest > 0 else ""}')
        line1 = " ".join(bits)
    else:
        line1 = "rules unavailable"
    return (f'<div class="hdr-r"><p>{line1}</p>'
            f'<p><span class="wall-hd">THE WALL</span> · '
            f'{wall_count} item(s) waiting</p></div>')


def render_page():
    data = collect()
    now = datetime.datetime.now()

    graph_err = (data["worktrees_err"] or data["contested_err"]
                 or data["hulls_err"] or data["gate_err"])

    sessions = region(
        "LIVE GRAPH · SESSIONS",
        '<span style="color:var(--green)">green</span> active · '
        '<span style="color:var(--dim)">grey</span> idle · '
        '<span style="color:var(--amber)">amber</span> contested · '
        '<span style="color:var(--purple)">purple</span> needs you',
        render_sessions(data["worktrees"], data["contested"],
                        data["hulls"], data["needs_input"]),
        graph_err, "live graph")

    pipeline = region("PIPELINE", None,
                      render_pipeline(data["pipeline"], data["wall"]),
                      data["pipeline_err"] or data["wall_err"], "pipeline")

    burnup = region("APPS &amp; WORK PACKAGES",
                    "degree of completion · ticked over declared items, "
                    "not guessed size",
                    render_burnup(data["burnup"]), data["burnup_err"],
                    "work packages")

    hand_sub = None
    if data["handovers"]:
        hand_sub = (f'{len(data["handovers"])} recorded · newest first · '
                    f'click a row to open the receiving session')
    handovers = region("HANDOVERS · WHO TOLD WHAT TO WHOM", hand_sub,
                       render_handovers(data["handovers"]),
                       data["handovers_err"], "handovers")

    ticker = region("EVENT TICKER", None, render_ticker(data["ticker"]),
                    data["ticker_err"], "ticker")

    return f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="refresh" content="10">
<title>TOWER · apps autopilot, live</title>
<style>{CSS}</style>
</head>
<body>
<div class="tower">
  <header class="hdr">
    <div>
      <h1>TOWER · APPS AUTOPILOT · LIVE</h1>
      <p class="stamp">{e(now.strftime("%Y-%m-%d %H:%M:%S"))} · updates every {CACHE_TTL}s</p>
    </div>
    {render_header(data["header"], len(data["wall"]))}
  </header>
  <main class="grid">
    <!-- Work packages sits under the sessions rather than full-width below
         both columns. The pipeline column is roughly 1.7x the height of the
         sessions column on a live tree, and a two-column row is only as short
         as its taller cell — so full-width-below left ~600px of empty column
         beside the pipeline. Stacking two regions there balances the row and
         the band closes. -->
    <div class="cell">{sessions}{burnup}</div>
    <div class="cell">{pipeline}</div>
    <div class="cell wide">{handovers}</div>
    <div class="cell wide">{ticker}</div>
  </main>
  <p class="foot">tower · loopback only · recollects every {CACHE_TTL}s ·
    <a href="/pulse">/pulse</a> for the plain-page view</p>
</div>
</body>
</html>
"""


def render_session_page(session_id):
    """The click-through panel: what a session last said, and what was handed
    to it. A page, not a dialog — the Tower is a served document, and a link
    is the only interaction an SVG screen gets for free."""
    d = session_digest(session_id)
    if not d:
        return ("<body style='background:#0B0E13;color:#DFE3EA;font-family:ui-monospace,monospace;"
                "padding:40px'><p>No transcript for that session.</p>"
                "<p><a style='color:#5FA985' href='/'>&larr; back to the Tower</a></p></body>")
    cwd = resolve_cwd(d["cwd"])
    received = "".join(
        f'<div style="border-left:2px solid #39434F;padding:6px 0 6px 12px;margin:10px 0">'
        f'<div style="color:#7C8594;font-size:12px">{e(m["ts"][11:16])} · from {e(m["sender"])}</div>'
        f'<div>{e(m["summary"])}</div></div>'
        for m in d["received"]) or '<p style="color:#7C8594">nothing was handed to this session</p>'
    return f"""<body style="background:#0B0E13;color:#DFE3EA;
      font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13px;
      line-height:1.6;margin:0;padding:40px;max-width:1000px">
  <p><a style="color:#5FA985;text-decoration:none" href="/">&larr; back to the Tower</a></p>
  <h2 style="font-size:15px;letter-spacing:.1em;color:#7C8594;font-weight:600">SESSION</h2>
  <p style="color:#DFE3EA">{e(session_id)}</p>
  <p style="color:#7C8594">working in {e(cwd)}</p>
  <h2 style="font-size:15px;letter-spacing:.1em;color:#7C8594;font-weight:600;margin-top:30px">
    HANDED TO THIS SESSION</h2>
  {received}
  <h2 style="font-size:15px;letter-spacing:.1em;color:#7C8594;font-weight:600;margin-top:30px">
    LAST DIGEST</h2>
  <pre style="white-space:pre-wrap;background:#131820;border:1px solid #26303C;
    border-radius:8px;padding:16px;color:#DFE3EA">{e(d["digest"]) or "(nothing said yet)"}</pre>
</body>"""


def render_pulse_page():
    # write=False: a GET here must not write the repo — pulse builds and
    # returns the HTML string, docs/pulse.html is untouched.
    body = PULSE.render(write=False)
    body = body.replace("<title>", '<meta http-equiv="refresh" content="10"><title>', 1)
    return body


# --- apprun self-registration (best-effort; never fatal) ---

def register_apprun(port):
    """Register this instance so 'leave nothing running' has something to
    check — a --demo proto copy, since it's started for the user to look
    at, not owned by any one task. Registration needs an owning session
    (apprun refuses ownerless entries by design); a plain-terminal run has
    none, so it's skipped, said out loud, and nothing else changes."""
    if not os.environ.get("CLAUDE_CODE_SESSION_ID"):
        print("apprun: registration skipped — CLAUDE_CODE_SESSION_ID is unset "
              "(not running inside an agent session), and apprun refuses to "
              "register an entry with no owner, by design.")
        return
    apprun = RULES / "bin" / "apprun"
    try:
        r = subprocess.run(
            [str(apprun), "start", "--project", "tower", "--phase", "proto",
             "--port", str(port), "--pid", str(os.getpid()),
             "--url", f"http://127.0.0.1:{port}/", "--demo"],
            capture_output=True, text=True, timeout=15)
        if r.returncode == 0:
            print(f"apprun: {r.stdout.strip()}")
        else:
            print(f"apprun: registration failed (non-fatal): {r.stderr.strip()}")
    except Exception as exc:
        print(f"apprun: registration failed (non-fatal): {exc}")


_deregistering = False  # reentrancy guard — see deregister_apprun


def deregister_apprun(port):
    # subprocess.run(), not Popen — deliberately blocking. `apprun stop`'s
    # own open_entries() drops any pid that's already dead *before it ever
    # calls terminate()*, so a fire-and-forget spawn races this process's
    # own exit: if we return control and the interpreter tears down before
    # the child's first registry read, the entry is skipped as already-gone
    # and left permanently "open" — worse than slow, silently wrong. Blocking
    # keeps this process alive (mid-call) until apprun's terminate() sees it,
    # so the close is guaranteed. The cost is apprun's own terminate() sending
    # *this* pid a redundant self-targeted SIGTERM as its first action.
    #
    # That redundant SIGTERM is exactly what makes the guard below load-
    # bearing, not defensive dressing: a signal handler in Python is not
    # blocked during its own execution, so that self-inflicted SIGTERM
    # re-enters _on_sigterm *while still blocked inside this very call*,
    # which spawns a second `apprun stop`, whose terminate() sends a third
    # SIGTERM, which spawns a third — found empirically as an unbounded
    # recursive subprocess spawn (confirmed via a 164KB traceback of nested
    # `_on_sigterm -> deregister_apprun -> subprocess.run -> _on_sigterm`
    # frames) that never let the registry write happen at all. One flag,
    # checked and set before the blocking call, makes every self-inflicted
    # repeat a no-op instead of a new spawn.
    global _deregistering
    if _deregistering:
        return
    _deregistering = True
    apprun = RULES / "bin" / "apprun"
    try:
        subprocess.run([str(apprun), "stop", "--port", str(port), "--include-demo"],
                       capture_output=True, text=True, timeout=15)
    except Exception:
        pass  # best-effort on the way out; never block shutdown forever on this


# --- server ---

def serve(port):
    import http.server

    register_apprun(port)
    atexit.register(deregister_apprun, port)

    def _on_sigterm(signum, frame):
        # Ignore SIGTERM from here on, *before* doing anything blocking:
        # deregister_apprun's own spawned `apprun stop` sends this exact pid
        # a redundant self-targeted SIGTERM as its first move. Left handled,
        # that re-enters this function while it's still blocked inside the
        # first call, which spawns a second `apprun stop`, which sends a
        # third SIGTERM, recursing without bound — confirmed empirically as
        # runaway nested subprocess spawns that never let the registry write
        # land. Ignoring means that redundant signal is silently dropped at
        # the OS level; apprun's terminate() still ends this process via
        # SIGKILL at its own 8s timeout if we haven't exited by then, and
        # SIGKILL cannot be ignored, so shutdown is still guaranteed.
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        deregister_apprun(port)
        sys.exit(0)  # triggers the atexit handler above too; deregister is idempotent

    signal.signal(signal.SIGTERM, _on_sigterm)

    class H(http.server.BaseHTTPRequestHandler):
        def _send(self, body, ctype="text/html; charset=utf-8"):
            data = body.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            if self.path.startswith("/pulse"):
                try:
                    self._send(render_pulse_page())
                except Exception as exc:
                    self._send(f"<pre>pulse unavailable: {html.escape(str(exc))}</pre>")
                return
            if self.path.startswith("/session/"):
                sid = self.path[len("/session/"):].split("?")[0]
                try:
                    self._send(render_session_page(sid))
                except Exception as exc:
                    self._send(f"<pre>session view failed: {html.escape(str(exc))}</pre>")
                return
            if self.path == "/" or self.path.startswith("/?"):
                try:
                    self._send(render_page())
                except Exception as exc:
                    self._send(f"<pre>tower render failed: {html.escape(str(exc))}</pre>")
                return
            self.send_response(404)
            self.end_headers()

        def log_message(self, *a):
            pass

    # loopback only: the screen renders private session data, same rule as pulse --serve
    httpd = http.server.HTTPServer(("127.0.0.1", port), H)
    print(f"tower: http://127.0.0.1:{port}/  (and /pulse)")
    httpd.serve_forever()


if __name__ == "__main__":
    port = DEFAULT_PORT
    if "--port" in sys.argv:
        port = int(sys.argv[sys.argv.index("--port") + 1])
    serve(port)
