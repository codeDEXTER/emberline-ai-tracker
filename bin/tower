#!/usr/bin/env python3
"""tower — the autopilot, live on one screen.

Step 2 of concept 07 (`docs/proposals/07-concept-tower.html`, accepted
2026-08-05): the drawn screen, not just pulse re-rendered behind a port.
One window, four regions — header, needs-you band, pipeline, work packages,
sessions strip — built from the same ground truth `pulse` already reads, plus
worktree file lists (for contested surfaces) and transcript tails (for the wall).

  tower                # serve on 127.0.0.1:8890
  tower --port N       # serve on a different port

Loopback only, always — the page renders private session data, same rule
as `pulse --serve`. Data is recollected at most every 5 seconds and cached
between requests; the page itself auto-refreshes every 10 seconds. Every
region is collected independently: one collector failing renders an empty
region with a small "unavailable" note in place of that region, never a
500 for the whole page.

Registers itself with `apprun` on start (a `--demo` proto copy, so
`stop --all` leaves it up until said done) and deregisters on shutdown,
when run inside an agent session; a plain-terminal run prints one line
saying registration was skipped, since apprun refuses an ownerless entry
by design.

HANDOVERS and the EVENT TICKER were removed by issue #64 (proposal 10): two
AI sessions coordinating, and commit subjects, are plumbing rather than
anything the sponsor needs at a glance. `/session/<id>` survives them — it is
reached from the sessions strip now, and still shows what a session last said
and what was handed to it, which is why the cross-session-message parsing
below is still here.
"""

import atexit
import concurrent.futures
import datetime
import html
import importlib.machinery
import importlib.util
import json
import os
import re
import signal
import string
import subprocess
import sys
import urllib.parse
import threading
import time
from pathlib import Path

RULES = Path(__file__).resolve().parent.parent
GIT = next((g for g in ("/Library/Developer/CommandLineTools/usr/bin/git",
                        "/usr/bin/git") if Path(g).exists()), "git")
TRANSCRIPTS = Path.home() / ".claude" / "projects"
CACHE_TTL = 5
STALE_TTL = 600      # the staleness check fetches; it must not ride the 5s cadence
DEFAULT_PORT = 8890

# --- reuse pulse's collectors rather than re-deriving the same ground truth ---


def load_pulse():
    path = RULES / "bin" / "pulse"
    loader = importlib.machinery.SourceFileLoader("tower_pulse", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


PULSE = load_pulse()


def projects():
    """Every app checkout, discovered by pulse from ~/apps rather than listed.
    A function, not a module constant: a project added while the Tower is up
    appears within pulse's discovery TTL, with no restart."""
    return PULSE.projects()


def fan_out(fn, items, workers=8):
    """Map fn over items concurrently. The per-project collectors below are
    each a handful of `gh` round-trips; run serially across six projects they
    would overrun the 5s collect cadence, and they are independent."""
    if not items:
        return []
    with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as ex:
        return list(ex.map(fn, items))


def run(cmd, cwd=None):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, cwd=cwd, timeout=30)
        return r.stdout.strip() if r.returncode == 0 else None
    except Exception:
        return None


def ago(ts):
    if not ts:
        return None
    s = int(time.time() - ts)
    if s < 90:
        return "now"
    m = s // 60
    if m < 60:
        return f"{m}m"
    h = m // 60
    if h < 48:
        return f"{h}h"
    return f"{h // 24}d"


def short_name(name):
    """adoring-euler-ba942f -> adoring-euler; strips a trailing hash suffix."""
    m = re.match(r"^(.+)-[0-9a-f]{4,8}$", name)
    return m.group(1) if m else name


def touched_files(path):
    # NOT run(): that helper .strip()s the whole blob, which eats the leading
    # space off " M file" porcelain lines and truncates the filename by one
    # character. whoelse's git() avoids exactly this with rstrip("\n") only.
    try:
        r = subprocess.run([GIT, "-C", str(path), "status", "--porcelain"],
                           capture_output=True, text=True, timeout=30)
        out = r.stdout.rstrip("\n") if r.returncode == 0 else ""
    except Exception:
        out = ""
    files = []
    for line in out.splitlines():
        f = line[3:].strip()
        if " -> " in f:
            f = f.split(" -> ", 1)[1]
        if f:
            files.append(f.strip('"'))
    return files


def tail_lines(path, n):
    """Last n lines of a (possibly large) file, without reading it whole."""
    with open(path, "rb") as f:
        f.seek(0, 2)
        size = f.tell()
        block = 8192
        data = b""
        pos = size
        while pos > 0 and data.count(b"\n") <= n:
            step = min(block, pos)
            pos -= step
            f.seek(pos)
            data = f.read(step) + data
        return data.decode("utf-8", errors="replace").splitlines()[-n:]


def newest_transcript(worktree_path):
    slug = str(worktree_path).replace("/", "-").replace(".", "-")
    tdir = TRANSCRIPTS / slug
    if not tdir.exists():
        return None
    files = list(tdir.glob("*.jsonl"))
    if not files:
        return None
    return max(files, key=lambda f: f.stat().st_mtime)


def worktree_issue(path):
    """First "#<digits>" found in this worktree's ahead-of-main commit
    subjects — the honest mapping: no match means ungrouped, not guessed."""
    out = run([GIT, "-C", str(path), "log", "main..HEAD", "--pretty=%s"])
    if not out:
        return None
    m = re.search(r"#(\d+)", out)
    return int(m.group(1)) if m else None


# --- cross-session messages: read only by the /session/<id> page now.
# The HANDOVERS region that used to list them came off the screen in #64;
# session_digest() still reports what was handed to one named session. ---

_XSM = re.compile(r'<cross-session-message\s+from="([^"]*)"\s+name="([^"]*)"[^>]*>', re.S)


def _first_sentence(body, limit=96):
    """The first non-empty line of a message, trimmed to one readable clause.
    Messages open with their point — the rest is detail for the session that
    received it, not for a screen."""
    for line in body.splitlines():
        line = line.strip()
        if not line:
            continue
        # Strip only LEADING markdown markers. Stripping [*_`#>] everywhere
        # ate the characters that carry the meaning: "issue #35" became
        # "issue 35" and "nicegui_app" became "niceguiapp" — the two things a
        # handover is most likely to be about.
        line = re.sub(r"^\s*(?:[-*+]\s+|#{1,6}\s+|>\s*)+", "", line).strip()
        line = line.replace("**", "")
        if not line:
            continue
        return line if len(line) <= limit else line[:limit - 1].rstrip(" ,;:.-") + "…"
    return ""


def resolve_cwd(slug):
    """Recover a real path from a transcript directory name.

    The directory is the session's cwd with "/" and "." flattened to "-", which
    is lossy: hyphens already in the name are indistinguishable from separators.
    Naively replacing "-" with "/" produced
    `~/apps/idea/lab//claude/worktrees/unruffled/chatterjee/b447a6` for a real
    directory called `idea-lab`. So this matches the slug against paths that
    actually exist, and when nothing matches it returns the slug verbatim
    rather than a confident wrong answer.
    """
    for proj in projects():
        base = Path(proj["path"])
        for cand in [base, *base.glob(".claude/worktrees/*"), *base.glob(".worktrees/*")]:
            if str(cand).replace("/", "-").replace(".", "-") == slug:
                return str(cand).replace(str(Path.home()), "~")
    return slug


def session_digest(session_id, max_chars=1400):
    """The last thing a session said, for the click-through panel. Reads only
    the transcript named by the id — never the whole corpus."""
    if not re.fullmatch(r"[0-9a-fA-F-]{8,64}", session_id or ""):
        return None                      # not an id; refuse rather than glob
    for d in TRANSCRIPTS.iterdir() if TRANSCRIPTS.is_dir() else []:
        f = d / f"{session_id}.jsonl"
        if not f.exists():
            continue
        last, received = None, []
        try:
            lines = f.read_text(errors="replace").splitlines()
        except OSError:
            return None
        for line in lines:
            try:
                rec = json.loads(line)
            except json.JSONDecodeError:
                continue
            if "cross-session-message" in line and isinstance(rec.get("content"), str):
                m = _XSM.search(rec["content"])
                if m:
                    received.append({"ts": rec.get("timestamp") or "",
                                     "sender": m.group(2) or "(untitled)",
                                     "summary": _first_sentence(rec["content"][m.end():].strip(), 160)})
            msg = rec.get("message")
            if rec.get("type") == "assistant" and isinstance(msg, dict):
                parts = msg.get("content")
                if isinstance(parts, list):
                    text = " ".join(p.get("text", "") for p in parts
                                    if isinstance(p, dict) and p.get("type") == "text").strip()
                    if text:
                        last = text
        return {"id": session_id, "cwd": d.name, "digest": (last or "")[:max_chars],
                "received": received[-6:]}
    return None


# --- worktree graph (nodes, contested surfaces) ---

def project_worktrees(proj):
    """Every worktree of proj except the main checkout, with everything the
    graph and pipeline need: branch, ahead, uncommitted files, session mtime."""
    out = run([GIT, "-C", proj["path"], "worktree", "list", "--porcelain"])
    if not out:
        return []
    trees, cur = [], {}
    for line in out.splitlines():
        if line.startswith("worktree "):
            if cur:
                trees.append(cur)
            cur = {"path": line[9:]}
        elif line.startswith("branch "):
            cur["branch"] = line[7:].replace("refs/heads/", "")
    if cur:
        trees.append(cur)

    result = []
    for t in trees:
        p = Path(t["path"])
        if str(p) == proj["path"]:
            continue  # skip the main checkout itself
        # A worktree outside the project directory is not a session's work.
        # Tower.app keeps its own pinned checkout (see build_towerapp.sh) so
        # the installed app never depends on which branch a shared checkout
        # happens to be parked on; it is registered like any other worktree and
        # would otherwise draw itself as a node on its own screen.
        if not str(p).startswith(proj["path"] + os.sep):
            continue
        files = touched_files(p)
        ahead = run([GIT, "-C", str(p), "rev-list", "--count", "main..HEAD"])
        newest = newest_transcript(p)
        session = newest.stat().st_mtime if newest else None
        result.append({
            "project": proj["name"], "path": p, "name": p.name,
            "short": short_name(p.name), "branch": t.get("branch", "?"),
            "files": files, "ahead": int(ahead) if (ahead or "").isdigit() else 0,
            "session": session, "newest_transcript": newest,
            "issue": worktree_issue(p),
        })
    return result


# Merge drivers that RESOLVE a file rather than conflicting on it. `union`
# keeps both sides, `ours` keeps one -- either way git produces no conflict, so
# two sessions holding such a file is not a collision (issue #74).
RESOLVING_DRIVERS = {"union", "ours"}


def driver_resolved(project_path, paths):
    """Which of `paths` have a merge driver that resolves them, per git itself.

    `git check-attr` rather than reading .gitattributes by hand: the patterns
    are globs (`*.md merge=union` is as valid as a literal filename), and using
    git's answer means this agrees with what git will actually do at merge
    time -- which is the whole point of the check.

    Asks the project's own installed file, never the shared template: #57
    landed precisely because four projects had drifted on this rule, so
    assuming the template is what is installed would reintroduce that bug.
    """
    if not paths:
        return set()
    try:
        r = subprocess.run([GIT, "-C", str(project_path), "check-attr", "merge", "-z", "--"]
                           + sorted(paths), capture_output=True, text=True, timeout=30)
        if r.returncode != 0:
            return set()
        # -z gives NUL-separated triples: path, attr, value
        fields = r.stdout.split("\0")
        out = set()
        for i in range(0, len(fields) - 2, 3):
            if fields[i + 2] in RESOLVING_DRIVERS:
                out.add(fields[i])
        return out
    except Exception:
        # Over-warning is recoverable; under-warning hides a real collision.
        # So a failure here degrades to the old behaviour, not to silence.
        return set()


def contested_pairs(worktrees):
    """Pairs of worktrees (same project) holding an overlapping uncommitted
    file — bin/whoelse's logic, scoped per project since paths are repo-relative.

    Files whose merge driver resolves them are excluded (#74). Measured on the
    live tree before this: 3 of 5 pairs were AGENT-LOG.md, which carries
    merge=ours, so they could not conflict by construction. Three in five is
    enough to teach a person to ignore amber, which costs the two that are real.
    """
    by_project = {}
    for w in worktrees:
        by_project.setdefault(w["project"], []).append(w)
    pairs = []
    for _, group in by_project.items():
        owners = {}
        for w in group:
            for f in w["files"]:
                owners.setdefault(f, []).append(w["name"])
        shared = {f for f, names in owners.items() if len(names) > 1}
        if not shared:
            continue
        # run inside a worktree of the project: it has the same .gitattributes
        # checked out, and w["path"] is a real working directory
        resolved = driver_resolved(group[0]["path"], shared)
        for f in shared:
            if f in resolved:
                continue
            names = owners[f]
            for i in range(len(names)):
                for j in range(i + 1, len(names)):
                    pairs.append((names[i], names[j], f))
    return pairs


def wall_items(worktrees):
    """Sessions whose newest transcript's tail looks like a pending question,
    stale enough (>5m) that it's plausibly still waiting on the user. A
    heuristic, not a certainty — labelled as one everywhere it's shown."""
    items = []
    for w in worktrees:
        nt = w["newest_transcript"]
        if not nt:
            continue
        try:
            mtime = nt.stat().st_mtime
            age_s = time.time() - mtime
            if age_s < 300:
                continue
            lines = tail_lines(nt, 30)
        except OSError:
            continue
        if any('"name":"AskUserQuestion"' in line for line in lines):
            items.append({"worktree": w["short"], "project": w["project"],
                          "age": ago(mtime) or "?"})
    return items


# --- pipeline (gh issues + worktree state) ---

def project_tag(name):
    """A short, stable label for a project on a 44-character chip: the first
    hyphen-separated segment ("finance-tracker" -> "finance"), which is
    distinct across every app on this machine today."""
    return name.split("-", 1)[0]


def issue_key(project, number):
    """Issue numbers are unique within a repo, not across the machine:
    common-rules #22 and finance-tracker #22 are different tickets. Every
    lookup below is keyed on the pair, never on the bare number."""
    return (project, number)


def project_pipeline(proj):
    """One project's open issues and today's closures. Runs in a worker thread
    (see fan_out), so it touches no shared state and swallows its own errors —
    a project whose `gh` call fails contributes nothing rather than taking the
    whole region down."""
    try:
        rows = PULSE.issues_for(proj["repo"])
    except Exception:
        rows = []
    for r in rows:
        r["project"] = proj["name"]
    groups, _singles = PULSE.feature_groups(rows)

    today = datetime.date.today().isoformat()
    out = run(["gh", "issue", "list", "-R", proj["repo"], "--state", "closed",
               "--search", f"closed:>={today}", "--json", "number,title", "--limit", "20"])
    try:
        closed = json.loads(out) if out else []
    except json.JSONDecodeError:
        closed = []
    for r in closed:
        r["project"] = proj["name"]
    return {"project": proj["name"], "rows": rows, "groups": groups, "merged": closed}


def pipeline_data(worktrees):
    """The pipeline across every discovered project with a remote (issue #35).

    Was: the first project carrying a repo, full stop — one project's issues on
    screen and five apps' silently absent, the Tower's own four included.
    """
    projs = [p for p in projects() if p.get("repo")]
    if not projs:
        return {"in_flight": [], "in_flight_worktrees": [],
                "queued": [], "queued_more": 0, "merged": [],
                "issues_by_key": {}, "issue_to_prefix": {}}

    all_issues, issue_to_prefix, merged = [], {}, []
    for res in fan_out(project_pipeline, projs):
        name = res["project"]
        all_issues.extend(res["rows"])
        merged.extend(res["merged"])
        for prefix, members in res["groups"]:
            for m in members:
                issue_to_prefix[issue_key(name, m["number"])] = prefix
    all_issues.sort(key=lambda r: (r["project"], r["number"]))
    merged.sort(key=lambda r: (r["project"], r["number"]))

    keys = {issue_key(r["project"], r["number"]) for r in all_issues}
    # worktree_issue() (first "#<digits>" in ahead-of-main commit subjects) is
    # the single mapping. No branch-name digit
    # matching: "stage2"/"v5"/hex worktree suffixes read as #2/#5/etc under
    # that approach, a false-match bug found on the live screen (issue #24).
    # The worktree's own project now scopes that match too, so a worktree in
    # one repo cannot claim a same-numbered issue belonging to another.
    in_flight_keys = {issue_key(w["project"], w["issue"]) for w in worktrees
                      if issue_key(w["project"], w.get("issue")) in keys}

    in_flight = [r for r in all_issues
                 if issue_key(r["project"], r["number"]) in in_flight_keys]
    # A worktree genuinely ahead of main but with no mapped issue is still
    # in-flight work — shown as its own dim, worktree-named row, never
    # invented as an issue chip it doesn't actually correspond to.
    in_flight_worktrees = [w for w in worktrees
                           if w["ahead"] > 0
                           and issue_key(w["project"], w.get("issue")) not in keys]

    queued = [r for r in all_issues
              if issue_key(r["project"], r["number"]) not in in_flight_keys]
    queued_shown, queued_more = queued[:8], max(0, len(queued) - 8)

    # Issue titles by key, for labelling. issue_to_prefix survives only to
    # strip a redundant "Prefix: " off a title for display — it is NOT a
    # feature source any more; #65 made the declared register the only one.
    issues_by_key = {issue_key(r["project"], r["number"]): r for r in all_issues}

    return {"in_flight": in_flight,
            "in_flight_worktrees": in_flight_worktrees,
            "queued": queued_shown, "queued_more": queued_more,
            "merged": merged[:4],
            "issues_by_key": issues_by_key, "issue_to_prefix": issue_to_prefix}


# A project this far behind has stopped being a header count and become
# something the sponsor has to act on (#75). Named, not inline: it will need
# tuning once it has been lived with, and a magic number in a conditional is
# where tuning goes to die.
DRIFT_ESCALATES_AT = 7          # rules versions
DRIFT_ROWS_SHOWN = 2            # the rest is a count -- see render_needs_you


def decision_queue(projs):
    """Every open non-draft PR across every project, with how long the oldest
    has waited (#75).

    NOT derived from worktree mapping, which is what `open_gate_branches` does
    and why the band under-reports: a PR opened from a branch with no mapped
    issue is invisible to it. Three were open during the session that found
    this, one of them from an unrelated session.

    The age is the point. Four things waiting ten minutes is a working
    autopilot; four waiting two days is a stalled one, and a bare count cannot
    tell them apart.
    """
    def for_project(proj):
        out = run(["gh", "pr", "list", "-R", proj["repo"], "--state", "open",
                   "--json", "number,title,isDraft,createdAt", "--limit", "50"])
        try:
            rows = json.loads(out) if out else []
        except json.JSONDecodeError:
            return []
        return [{"project": proj["name"], "number": r["number"], "title": r["title"],
                 "created": r["createdAt"]}
                for r in rows if not r.get("isDraft")]

    prs = [r for rows in fan_out(for_project, [p for p in projs if p.get("repo")])
           for r in rows]
    if not prs:
        return None
    oldest = min(_epoch_iso(r["created"]) for r in prs if r["created"])
    return {"count": len(prs), "oldest": oldest,
            "projects": sorted({r["project"] for r in prs}),
            "numbers": sorted(r["number"] for r in prs)}


def _epoch_iso(ts):
    try:
        return datetime.datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
    except Exception:
        return time.time()


def rules_drift(projs):
    """Projects far enough behind the shared rules to need the sponsor.

    The header has carried `5 behind: …` unchanged through a whole working day
    — a permanent warning at constant volume is indistinguishable from
    decoration. Eleven versions behind is not the same fact as two, and the
    screen rendered them identically, so the signal has to be able to escalate
    or it gets tuned out again within a week.
    """
    current = PULSE.rules_state(RULES)[0]
    try:
        current_n = int(str(current).split("-")[0])
    except (ValueError, IndexError):
        return []
    out = []
    for proj in projs:
        if (Path(proj["path"]) / "CLAUDE-workflow.md").exists():
            continue                      # the rules repo is not behind itself
        stamped = PULSE.rules_state(proj["path"])[1]
        if not stamped:
            # never stamped is its own case, not "0 behind"
            out.append({"project": proj["name"], "behind": None})
            continue
        try:
            n = int(str(stamped).split("-")[0])
        except (ValueError, IndexError):
            continue
        if current_n - n >= DRIFT_ESCALATES_AT:
            out.append({"project": proj["name"], "behind": current_n - n,
                        "stamped": n, "current": current_n})
    return out


def open_gate_branches(projs):
    """(project, branch) pairs with an open, non-draft PR — awaiting a human
    merge decision by definition of what an open PR is. No separate "at the
    gate" state is invented beyond that; a draft PR is explicitly not yet
    asking for one.

    Paired with the project, not a bare branch name: two repos routinely carry
    a branch of the same name, and an unpaired set would mark the wrong
    worktree as needing input."""
    def for_project(proj):
        out = run(["gh", "pr", "list", "-R", proj["repo"], "--state", "open",
                   "--json", "number,headRefName,isDraft", "--limit", "50"])
        if not out:
            return set()
        try:
            rows = json.loads(out)
        except json.JSONDecodeError:
            return set()
        return {(proj["name"], r["headRefName"]) for r in rows if not r.get("isDraft")}

    pairs = set()
    for s in fan_out(for_project, [p for p in projs if p.get("repo")]):
        pairs |= s
    return pairs


# --- the features register: what the product is made of ---
#
# Proposal 10. The Tower used to infer "features" from issue title prefixes
# (`title.split(":")[0]`), which made two issues share a feature only if
# somebody typed the same words before a colon, and it labelled sessions with
# worktree directory names. Neither is a fact about the product. Features are
# already first-class in CLAUDE-workflow.md -- "the user owns features, the AI
# owns issues" -- and a project declares them in a `## Features` table. That
# table is the source now; nothing is inferred.

FEATURE_ROW = re.compile(r"^\|\s*\[?#(\d+)\]?[^|]*\|\s*([^|]+?)\s*\|\s*([^|]*?)\s*\|")
# "issue #1" / "issues #1, #2" -- an issue that IMPLEMENTS the feature.
IMPLEMENTS = re.compile(r"issues?\s+((?:#\d+[,\s]*)+)")
# "blocked by #2, #3" -- a dependency. Counting these as implementing issues
# would make every blocked feature inherit its blocker's progress, which is
# the opposite of true, so the two patterns are read separately and only the
# first ever reaches a percentage.
BLOCKED_BY = re.compile(r"blocked\s+by\s+((?:#\d+[,\s]*)+)")


def _refs(text):
    return [int(n) for n in re.findall(r"#(\d+)", text or "")]


def parse_features(md):
    """The `## Features` table of a CLAUDE-checklist.md, or [] if it has none.

    Reads only until the next `##`, so a `#123` in a later section cannot be
    mistaken for a feature row."""
    lines = md.splitlines()
    try:
        start = next(i for i, l in enumerate(lines)
                     if re.match(r"^##\s+Features\b", l))
    except StopIteration:
        return []
    out = []
    for line in lines[start + 1:]:
        if line.startswith("## "):
            break
        m = FEATURE_ROW.match(line)
        if not m:
            continue
        number, title, state = int(m.group(1)), m.group(2).strip(), m.group(3).strip()
        if title.lower() == "feature":          # the header row
            continue
        plain = re.sub(r"\*\*|\[|\]\([^)]*\)", "", state)
        impl = _refs(IMPLEMENTS.search(plain).group(1)) if IMPLEMENTS.search(plain) else []
        blocked = _refs(BLOCKED_BY.search(plain).group(1)) if BLOCKED_BY.search(plain) else []
        low = plain.lower()
        if "in flight" in low:
            kind = "in flight"
        elif blocked:
            kind = "blocked"
        elif "version 2" in low or "version 3" in low:
            kind = "later"
        elif "done" in low or "built" in low or "shipped" in low:
            kind = "done"
        else:
            kind = "declared"
        out.append({"number": number, "title": title, "state": plain,
                    "kind": kind, "implements": impl, "blocked_by": blocked})
    return out


def feature_data(projs):
    """Per project: its declared features, and -- only where a feature names the
    issues that implement it -- how many of those are closed.

    A project with no register reports `features: None`. It is NOT 0% and not an
    empty list: proposal 08's rule, that undeclared scope is reported as
    undeclared rather than as zero, and it matters more here because the whole
    point of the region is a completion figure the sponsor asked for by name.
    """
    out = []
    for proj in projs:
        md_path = Path(proj["path"]) / "CLAUDE-checklist.md"
        feats = parse_features(md_path.read_text(errors="replace")) if md_path.exists() else []
        row = {"project": proj["name"], "features": feats or None,
               "items": None, "unparsed": 0, "closed": {}}
        # The checklist's own tick count, kept as the honest fallback signal for
        # a project that has not declared features -- labelled as what it is.
        # PULSE.checklist_progress rather than a local regex, because it also
        # reports lines that LOOK like items and could not be parsed, and
        # proposal 08's rule is that such a line is named rather than allowed to
        # vanish into a smaller denominator.
        prog = PULSE.checklist_progress(proj["path"])
        if prog:
            row["items"] = (prog["done"], prog["total"])
            row["unparsed"] = prog.get("unparsed", 0)
        if feats and proj.get("repo"):
            wanted = sorted({n for f in feats for n in f["implements"]})
            if wanted:
                raw = run(["gh", "issue", "list", "-R", proj["repo"], "--state", "all",
                           "--json", "number,state", "--limit", "200"])
                try:
                    for r in json.loads(raw) if raw else []:
                        row["closed"][r["number"]] = r["state"] == "CLOSED"
                except json.JSONDecodeError:
                    pass
        out.append(row)
    return out


def feature_of_issue(features, issue):
    """The feature an issue implements, or None. Never guessed from a name."""
    if issue is None:
        return None
    for f in features or []:
        if issue in f["implements"]:
            return f
    return None


# --- history: what moved, and how fast (issues #66, #63) ---
#
# No new record file, and no revival of proposal 08's logbook, which was
# proposed and rejected. The history is already on disk and unread: the tick
# count at any past commit of CLAUDE-checklist.md is recoverable directly.
# Measured depth today: finance-tracker 20 revisions, pip 11, pockets 9,
# mac-explorer 5, spanning six days.

HISTORY_TTL = 900        # walks git log; must not ride the 5s cadence
HISTORY_REVISIONS = 30


def checklist_history(proj):
    """[(date, done, total)] oldest first, from the checklist's own git log."""
    path = proj["path"]
    shas = run([GIT, "-C", path, "log", "--follow", "--format=%h %cs",
                f"-{HISTORY_REVISIONS}", "--", "CLAUDE-checklist.md"])
    if not shas:
        return []
    out = []
    for line in reversed(shas.splitlines()):
        parts = line.split()
        if len(parts) != 2:
            continue
        sha, date = parts
        blob = run([GIT, "-C", path, "show", f"{sha}:CLAUDE-checklist.md"])
        if blob is None:
            continue
        done = len(re.findall(r"(?m)^- \[x\]", blob))
        total = len(re.findall(r"(?m)^- \[[ x]\]", blob))
        if total:
            out.append((date, done, total))
    return out


_hist_lock = threading.Lock()
_hist = {"ts": 0, "data": None}


def history_data(projs):
    """Per project history, cached hard: this is ~30 `git show` calls each."""
    with _hist_lock:
        if _hist["data"] is not None and time.time() - _hist["ts"] < HISTORY_TTL:
            return _hist["data"]
    out = []
    for proj in projs:
        h = checklist_history(proj)
        if len(h) >= 2:
            out.append({"project": proj["name"], "points": h})
    with _hist_lock:
        _hist["ts"] = time.time()
        _hist["data"] = out
    return out


def velocity(points, days=7):
    """Items completed over the last `days`, as a MEASUREMENT of what happened.

    Explicitly not a forecast. Proposal 08 refused an ETA on four active days
    and #63 held the same line on six; a rate is a fact about the past, a date
    is a claim about the future, and only the first is supportable here.
    """
    if len(points) < 2:
        return None
    cutoff = (datetime.date.today() - datetime.timedelta(days=days)).isoformat()
    window = [p for p in points if p[0] >= cutoff] or points[-2:]
    return window[-1][1] - window[0][1], days


def moved(points):
    """(done_from, done_to, total_from, total_to) for today, or None.

    Scope growth is reported alongside completion because the two together are
    the only honest summary: finance-tracker went 9/25 to 16/51, completing
    seven items while its percentage FELL from 36% to 31%.
    """
    if len(points) < 2:
        return None
    today = datetime.date.today().isoformat()
    todays = [p for p in points if p[0] == today]
    if not todays:
        return None
    before = [p for p in points if p[0] < today]
    base = before[-1] if before else points[0]
    last = todays[-1]
    if base[1] == last[1] and base[2] == last[2]:
        return None
    return base[1], last[1], base[2], last[2]


# NOTE: cost per feature (#76) is NOT implemented here, deliberately.
# `bin/spend` groups tasks via `_tasks_here()`, which derives the repo root from
# the *current working directory* and takes no path. Reaching it from a
# collector would mean chdir-ing inside a server that fans collectors out across
# threads, and a process-global chdir is exactly the kind of race that produces
# a wrong number occasionally rather than an obvious failure.
#
# #76 puts "changing bin/spend itself" out of scope and says it is its own
# issue, so that is where this stops. The join it needs already exists here --
# spend keys tasks by worktree name, and feature_of_issue() maps a worktree's
# issue to a feature -- so once spend exposes a path-taking entry point this is
# a small function, not a redesign.


# --- collect everything, cached ---

_cache_lock = threading.Lock()
_cache = {"ts": 0, "data": None}
_stale_lock = threading.Lock()
_stale = {"ts": 0, "data": None}


def staleness():
    """Is the code rendering this page behind origin/main? (issue #73)

    Tower.app runs bin/tower from a pinned checkout refreshed only by
    `build_towerapp.sh --install`, so it falls behind on every merge. Measured
    two hours after one rebuild: the app on 208c789, main on cd19f10. Before
    that it had been two days behind, serving the pre-proposal-09 screen while
    every session reported those problems fixed.

    A status screen that is confidently wrong with nothing hinting at it is the
    worst defect one can have, so this is a correction, not a feature.

    Cached separately and for far longer than everything else: it needs a
    `git fetch`, and the thing it measures changes on merge, not every 5s.
    Returns None when current, or when anything at all goes wrong — silence is
    the right failure mode for a check whose whole job is to be quiet until it
    is not.
    """
    with _stale_lock:
        if _stale["data"] is not None and time.time() - _stale["ts"] < STALE_TTL:
            return _stale["data"]
    out = None
    try:
        # RULES is the parent of the running bin/tower, so this measures the
        # checkout actually serving the page -- the app's pinned copy, or a
        # worktree if tower was started from one.
        subprocess.run([GIT, "-C", str(RULES), "fetch", "origin", "--quiet"],
                       capture_output=True, timeout=25)
        here = run([GIT, "-C", str(RULES), "rev-parse", "--short", "HEAD"])
        behind_ahead = run([GIT, "-C", str(RULES), "rev-list",
                            "--left-right", "--count", "HEAD...origin/main"])
        if here and behind_ahead:
            ahead, behind = (int(n) for n in behind_ahead.split())
            # Only "behind" is stale. A worktree ahead of main is a session
            # doing its job, and calling that stale would make the line noise
            # on precisely the screens most likely to be read.
            if behind > 0:
                out = {"here": here, "behind": behind}
    except Exception:
        out = None
    with _stale_lock:
        _stale["ts"] = time.time()
        _stale["data"] = out
    return out



def collect():
    with _cache_lock:
        if _cache["data"] is not None and time.time() - _cache["ts"] < CACHE_TTL:
            return _cache["data"]

    def safe(fn, *a):
        try:
            return fn(*a), None
        except Exception as e:
            return None, str(e)

    projs, projs_err = safe(projects)
    projs = projs or []

    worktrees, wt_err = safe(lambda: [w for proj in projs for w in project_worktrees(proj)])
    worktrees = worktrees or []
    wt_err = wt_err or projs_err

    def build_header():
        # rules_state()[0] ignores its argument (it reads RULES), so the
        # current version is asked for once instead of re-derived per project —
        # the old expression called it twice inside a per-project loop.
        current = PULSE.rules_state(RULES)[0]
        chips = []
        for p in projs:
            # The rules repo carries no .common-rules-version stamp because it
            # is the rules; measuring it against itself reported it "never
            # aligned", a false alarm the old two-project list never reached.
            if (Path(p["path"]) / "CLAUDE-workflow.md").exists():
                continue
            stamped = PULSE.rules_state(p["path"])[1]
            chips.append({"name": p["name"],
                          "state": ("aligned" if stamped == current
                                    else ("behind" if stamped else "never aligned"))})
        return {"now": datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                "rules": current, "chips": chips}

    header, header_err = safe(build_header)

    contested, contested_err = safe(contested_pairs, worktrees)
    wall, wall_err = safe(wall_items, worktrees)
    pipeline, pipeline_err = safe(pipeline_data, worktrees)
    features, features_err = safe(feature_data, projs)
    stale, _stale_err = safe(staleness)   # silence is the failure mode; err unused
    queue, queue_err = safe(decision_queue, projs)
    drift, drift_err = safe(rules_drift, projs)
    history, history_err = safe(history_data, projs)
    gate_branches, gate_err = safe(open_gate_branches, projs)

    # Node labels (issue title, prefix stripped) — shared lookup from the
    # pipeline, attached once here rather than re-derived at render time.
    issues_by_key = (pipeline or {}).get("issues_by_key", {})
    issue_to_prefix = (pipeline or {}).get("issue_to_prefix", {})
    for w in worktrees:
        key = issue_key(w["project"], w.get("issue"))
        issue = issues_by_key.get(key)
        if not issue:
            w["issue_title"] = None
            continue
        title = issue["title"]
        prefix = issue_to_prefix.get(key)
        if prefix and ":" in title and title.split(":", 1)[0].strip() == prefix:
            title = title.split(":", 1)[1].strip()
        # The full title, not a 22-character cut. This was the one truncation
        # living above the render layer: it existed because the label had to fit
        # inside a 25px-radius circle, and it cut "Tower: the screen fits its
        # window..." down to "the screen fits its…". The screen is HTML now, so
        # fitting is CSS's job — the card clamps visually and keeps the whole
        # string in its title attribute. Nothing about what is *collected*
        # changes (issue #50, decided with aashish 2026-08-07).
        w["issue_title"] = title

    # "Needs you": a wall item, or its mapped issue's branch has an open,
    # non-draft PR awaiting a merge decision — the two things issue #25 asks
    # this screen to surface at a glance.
    # A dict rather than a set: the *reason* was computed here and thrown
    # away, so the screen could only ever say "needs you" and never why or for
    # how long. The band in issue #51 has to say both. Same two conditions,
    # same inputs — nothing new is collected, the answer is just kept.
    wall_age = {item["worktree"]: item["age"] for item in (wall or [])}
    gate_set = gate_branches or set()
    needs_input = {}
    for w in worktrees:
        if w["short"] in wall_age:
            needs_input[w["name"]] = {"why": "waiting on you",
                                      "age": wall_age[w["short"]]}
        elif (w["project"], w["branch"]) in gate_set:
            needs_input[w["name"]] = {"why": "open PR, awaiting your merge",
                                      "age": ago(w["session"])}

    data = {
        "worktrees": worktrees, "worktrees_err": wt_err,
        "header": header, "header_err": header_err,
        "contested": contested or [], "contested_err": contested_err,
        "wall": wall or [], "wall_err": wall_err,
        "pipeline": pipeline, "pipeline_err": pipeline_err,
        "features": features or [], "features_err": features_err,
        "stale": stale,
        "queue": queue, "queue_err": queue_err,
        "drift": drift or [], "drift_err": drift_err,
        "history": history or [], "history_err": history_err,
        "needs_input": needs_input, "gate_err": gate_err,
    }
    with _cache_lock:
        _cache["ts"] = time.time()
        _cache["data"] = data
    return data


# --- rendering ---
#
# The page is HTML and CSS. It used to be one hand-positioned SVG: every
# render_* had the shape (data, x0, y0, width) -> (svg, bottom_y) and
# render_page threaded `bottom` forward to stack regions. That is a layout
# engine with no text measurement, no intrinsic sizing and no reflow, and all
# three absences were visible on the live screen (issue #50, proposal 09):
# eight hardcoded [:n] cuts existed only because SVG <text> cannot wrap;
# `main_bottom = max(graph_bottom, pipe_bottom)` padded the shorter column
# with 310px of nothing; and WIDTH was a Python constant, so the page could
# only ever be 1200px wide.
#
# The browser ships that engine and this page is already served into WebKit.
# So: CSS grid for the regions, CSS clamping for long strings, one spacing
# scale, no absolute coordinates anywhere.

PALETTE = dict(bg="#0B0E13", ink="#DFE3EA", dim="#7C8594", line="#222B38",
               green="#5FA985", amber="#D2A05A", purple="#A98FD6")

# Every length on the screen comes from here. The old renderers set spacing
# inline (cell_h=118, y0=116, +30, +10) and disagreed with themselves — 40px
# below the header rule, 20px below every other one.
CSS = string.Template("""
:root {
  --bg:$bg; --ink:$ink; --dim:$dim; --line:$line;
  --green:$green; --amber:$amber; --purple:$purple;
  --card:#131820; --card-2:#1A2230; --edge:#39434F; --trk:#222B38;
  --gap-1:6px; --gap-2:12px; --gap-3:20px; --gap-4:32px;
  --radius:10px;
  --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;
}
* { box-sizing:border-box; }
body { background:var(--bg); color:var(--ink); font-family:var(--sans);
       margin:0; padding:var(--gap-3); font-size:13px; line-height:1.45; }
.tower { max-width:1600px; margin:0 auto; }

/* --- header --- */
.hdr { display:flex; justify-content:space-between; align-items:flex-start;
       gap:var(--gap-3); flex-wrap:wrap;
       padding-bottom:var(--gap-2); border-bottom:1px solid var(--line); }
.hdr h1 { font-family:var(--mono); font-size:14px; font-weight:700;
          letter-spacing:.12em; color:var(--dim); margin:0; }
.hdr .stamp { font-family:var(--mono); font-size:10.5px; color:var(--dim);
              margin:var(--gap-1) 0 0; }
.hdr-r { font-family:var(--mono); font-size:11px; color:var(--dim);
         text-align:right; }
.hdr-r p { margin:0 0 var(--gap-1); }
.wall-hd { color:var(--purple); font-weight:700; letter-spacing:.1em; }
.stale { color:var(--amber); }   /* stale is not broken -- amber, not red */

/* --- the region grid: columns are a grid concern, so a short column can
   never be padded to a tall one. That padding was the 310px void. --- */
.grid { display:grid; grid-template-columns:3fr 2fr; gap:var(--gap-3);
        align-items:start; margin-top:var(--gap-3); }
.cell { min-width:0; }              /* lets children shrink instead of overflow */
.cell.wide { grid-column:1 / -1; }
@media (max-width:1000px) { .grid { grid-template-columns:1fr; } }

/* --- fit the window, whatever the tree does (issue #56) ---
   The page height was a function of how much work exists: it went 1,721 ->
   1,792px in half an hour purely because worktrees were added. Cutting lists
   to fit only moves that number, it does not stop it moving — measured, even
   deleting the whole pipeline left 1,196px against a 900px budget, because
   work packages and handovers set the floor. (Handovers came off in #64,
   which is why there is headroom now — the cap stays: the point was never
   those particular regions, it was that height tracked the size of the tree.)
   So the regions are capped and scroll inside themselves instead. The page
   fits by construction and stops tracking the size of the tree. Nothing is
   dropped and nothing is hidden behind a disclosure.
   Only above the single-column breakpoint: a narrow window is a browser being
   read, not the wall screen, and locking that to the viewport would squash it. */
@media (min-width:1001px) {
  html, body { height:100%; }
  body { overflow:hidden; }
  .tower { height:100%; display:flex; flex-direction:column; }
  /* The band is the most important thing on the screen and still must not own
     it: unbounded, three waiting items took 28% of the height and squeezed the
     pipeline to 165px. Capped, it scrolls like everything else. */
  .band { flex:0 0 auto; max-height:22vh; overflow-y:auto; }
  .grid { flex:1 1 auto; min-height:0;
          /* Two rows now, not three: #64 took handovers and the ticker off, and
             a template still declaring their row left the sessions strip in a
             1fr track it does not need (211px for 123px of dots) plus an empty
             third track. The work takes everything left over; the strip sizes
             to its content. */
          grid-template-rows:minmax(0,1fr) auto;
          /* stretch, not start: with align-items:start a grid item sizes to
             its content and simply overflows its track, so the cap never
             binds and the overflow lands back on the page. */
          align-items:stretch; }
  /* min-height:0 is the load-bearing half — without it a grid item refuses to
     shrink below its content and the overflow moves back onto the page. */
  .grid > .cell { overflow-y:auto; min-height:0; }
  .grid > .cell.wide { overflow:hidden; }   /* the strip row sizes to content */
  .foot { flex:0 0 auto; margin-top:var(--gap-2); }
  /* the region title stays put while its list scrolls under it */
  .cell > .rgn > .ht { position:sticky; top:0; z-index:1;
                       background:var(--bg); padding-bottom:var(--gap-1); }
}
