def e(s):
    return html.escape(str(s))


def unavailable(label):
    return f'<p class="na">{e(label)} · unavailable</p>'


def region(title, sub, body, err=None, label=None):
    """One region. A failed collector renders this region empty with a note —
    never a 500 for the whole page, same contract as before."""
    out = [f'<div class="rgn"><p class="ht">{title}</p>']
    if sub:
        out.append(f'<p class="sub">{sub}</p>')
    out.append(body)
    if err:
        out.append(unavailable(label or "region"))
    out.append("</div>")
    return "\n".join(out)


def contested_notes(contested):
    """One note per contested pair, naming one file — the concept's own limit.
    Returns {worktree_name: (other_name, file)}."""
    notes, seen = {}, set()
    for a, b, f in contested:
        key = frozenset((a, b))
        if key in seen:
            continue
        seen.add(key)
        notes.setdefault(a, (b, f))
        notes.setdefault(b, (a, f))
    return notes


def render_needs_you(worktrees, needs_input, contested, features=None):
    """The band, first and largest (issue #51).

    Of 23 session nodes on the live tree exactly two carried state, and they
    were the same size and weight as the 21 that did not. Everything that
    actually requires him is here instead, in words, above everything else —
    and when there is nothing, this collapses to one line and gives its height
    back rather than reserving empty space, which is the failure mode proposal
    09 is about in the first place.
    """
    by_name = {w["name"]: w for w in worktrees}
    rows = []

    for name, info in sorted(needs_input.items()):
        w = by_name.get(name)
        if not w:
            continue
        title = w.get("issue_title") or f'{project_tag(w["project"])} work'
        meta = [info["why"]]
        if w.get("issue_title"):
            meta.insert(0, f'{project_tag(w["project"])} #{w["issue"]}')
        # the feature it moves, where one is declared — never the worktree (#65)
        by_project = {r["project"]: r["features"] for r in (features or [])}
        feat = feature_of_issue(by_project.get(w["project"]), w.get("issue"))
        if feat:
            meta.insert(0, feat["title"])
        if info.get("age"):
            meta.append(f'{info["age"]}')
        rows.append(
            f'<div class="you-row"><p class="you-ttl clamp2" title="{e(title)}">'
            f'{e(title)}</p><p class="you-meta clamp1">'
            f'{" · ".join(e(m) for m in meta)}</p></div>')

    # A contested pair is an actionable collision — it belongs beside the other
    # things that need him, not drawn as a 470px diagonal across a node grid
    # with its caption floating unanchored at the midpoint (which is what it
    # was, and the only edge the "graph" ever rendered).
    for a, (b, f) in sorted(contested_notes(contested).items()):
        if a > b:
            continue  # one row per pair, not one per end
        rows.append(
            f'<div class="you-row cont"><p class="you-ttl clamp2" '
            f'title="{e(f)}">Contested · {e(f)}</p>'
            f'<p class="you-meta clamp1">two sessions are both holding the '
            f'same uncommitted file</p></div>')

    if not rows:
        return ('<p class="you-none">nothing needs you · '
                'the autopilot is unblocked</p>')
    return f'<div class="you-band">{"".join(rows)}</div>'


def session_id_of(w):
    """The transcript filename is the session id — already collected as
    `newest_transcript`, never previously used for anything but its mtime."""
    t = w.get("newest_transcript")
    return t.stem if t else None


def render_features(features):
    """FEATURES — what the product is made of, and how much of it is done.

    Read from each project's declared `## Features` register, never inferred.
    A project that has not declared any says so: proposal 08's rule that
    undeclared scope is reported as undeclared and never as 0%, which matters
    most here because a completion figure is the thing the sponsor asked for
    by name — a number over an invented denominator would be worse than none.
    """
    if features is None:
        return unavailable("features")
    out, any_declared = [], False
    for row in features:
        proj = row["project"]
        feats = row["features"]
        if not feats:
            # the honest fallback: ticks are real, but they are ticks against no
            # product definition, and the label has to say exactly that
            items = row.get("items")
            tail = (f' — {items[0]}/{items[1]} checklist items ticked, against no '
                    f'product definition' if items else "")
            out.append(f'<p class="f-none"><b>{e(proj)}</b> · '
                       f'<span class="warn">no features declared</span>{e(tail)}</p>')
            if row.get("unparsed"):
                out.append(f'<p class="sub" style="color:var(--amber)">'
                           f'{row["unparsed"]} line(s) in {e(proj)} look like items '
                           f'but could not be parsed, and are not counted</p>')
            continue
        any_declared = True
        out.append(f'<p class="f-proj">{e(proj)} · {len(feats)} declared</p>')
        out.append('<div class="feats">')
        for f in feats:
            impl, closed = f["implements"], row["closed"]
            # A percentage only where the feature names the issues that
            # implement it. "blocked by #2" is a dependency, not progress, and
            # is never counted -- see BLOCKED_BY.
            if impl and closed:
                done = sum(1 for n in impl if closed.get(n))
                pct = round(done / len(impl) * 100)
                if pct == 100 and f["kind"] != "done":
                    # proposal 05: the sponsor closes features. All tickets shut
                    # is not the same as him having seen it work.
                    figure = f'<span class="await">100% · awaiting your close</span>'
                else:
                    figure = f'{pct}%'
                bar = (f'<div class="bar"><i style="width:{pct}%"></i></div>')
                note = f'{done}/{len(impl)} issues'
            else:
                figure, bar, note = "", '<div class="bar"></div>', e(f["state"] or "")
            out.append(
                f'<div class="f-nm clamp1" title="{e(f["title"])}">{e(f["title"])}</div>'
                f'{bar}<div class="f-fig">{figure}</div>'
                f'<div class="f-note clamp1" title="{e(note)}">{note}</div>')
        out.append("</div>")
    if not any_declared:
        out.append('<p class="sub">no project has declared its features yet, so there '
                   'is no whole-product figure to report</p>')
    return "\n".join(out)


def render_strip(worktrees, needs_input, contested, features):
    """SESSIONS, grouped by the feature each one is moving (#65).

    Two things changed from #52. It groups by *declared feature* rather than
    showing one flat row -- the grouping concept 07 drew as dashed hulls, which
    #52 dropped and nothing replaced. And **no worktree or branch name appears
    anywhere**, including in the hover: a folder on disk is not a fact about the
    product, and naming one was the whole of the sponsor's complaint.
    """
    if not worktrees:
        return unavailable("no worktrees found")
    cont = contested_notes(contested)
    by_project = {r["project"]: r["features"] for r in (features or [])}

    groups, counts = {}, {"active": 0, "needs you": 0, "contested": 0, "idle": 0}
    for w in sorted(worktrees, key=lambda x: (x["project"], x["short"])):
        age_s = (time.time() - w["session"]) if w["session"] else None
        # Every session lands in exactly one bucket. In #52 the contested branch
        # assigned a class and counted nothing, so the summary read
        # "22 · 0 active, 1 needs you, 4 idle" and 17 sessions vanished from
        # their own total.
        if w["name"] in needs_input:
            cls, bucket = "you", "needs you"
        elif w["name"] in cont:
            cls, bucket = "cont", "contested"
        elif age_s is not None and age_s < 1800:
            cls, bucket = "live", "active"
        else:
            cls, bucket = "idle", "idle"
        counts[bucket] += 1

        feat = feature_of_issue(by_project.get(w["project"]), w.get("issue"))
        key = (f'{project_tag(w["project"])} · {feat["title"]}' if feat
               else "no declared feature")
        # The hover names the feature and the issue. Never the worktree.
        bits = [key]
        if w.get("issue_title"):
            bits.append(f'{project_tag(w["project"])} #{w["issue"]}: {w["issue_title"]}')
        if age_s is not None:
            bits.append(f'last active {ago(w["session"])}')
        sid = session_id_of(w)
        tip = " — ".join(bits)
        dot = (f'<a class="dot {cls}" href="/session/{e(sid)}" title="{e(tip)}">'
               f'<span></span></a>' if sid else
               f'<span class="dot {cls}" title="{e(tip)}"><span></span></span>')
        groups.setdefault(key, []).append(dot)

    total = len(worktrees)
    parts = [f'{total} · ' + ", ".join(f'{n} {k}' for k, n in counts.items() if n)]
    out = [f'<p class="strip-count">{e(parts[0])}</p>']
    # declared features first, the unmapped remainder last: it is a gap, not a group
    for key in sorted(groups, key=lambda k: (k == "no declared feature", k)):
        dots = groups[key]
        out.append(f'<p class="strip-grp">{e(key)} · {len(dots)}</p>'
                   f'<div class="strip">{"".join(dots)}</div>')
    out.append('<p class="sub">hover a dot for the feature and issue · '
               'click to open the session</p>')
    return "\n".join(out)


def issue_label(row, title):
    """`finance #41 the Ticket Rail` — the project tag is not decoration: with
    six repos on one screen a bare "#22" names two different tickets."""
    tag = project_tag(row.get("project", "")) if row.get("project") else ""
    return f'{tag} #{row["number"]} {title}'.strip()


def chip(label, cls=""):
    return (f'<div class="chip {cls} clamp1" title="{e(label)}">{e(label)}</div>')


def strip_prefix(title):
    return title.split(":", 1)[-1].strip() if ":" in title else title


def render_pipeline(pipeline, wall):
    out = []
    if pipeline is None:
        out.append(unavailable("pipeline"))
    else:
        # In flight means a *mapped issue* (issue #51). The count used to add
        # the ahead-of-main worktrees to it and read "IN FLIGHT · 19" when one
        # of those nineteen was work and eighteen were git ahead-counts — an
        # 18x overstatement of the only number on this region anyone reads.
        mapped = pipeline["in_flight"]
        unmapped = pipeline["in_flight_worktrees"]
        out.append(f'<p class="psec">IN FLIGHT · {len(mapped)}</p>')
        if mapped:
            for r in mapped:
                out.append(chip(issue_label(r, strip_prefix(r["title"])), "done"))
        else:
            out.append('<p class="sub">none</p>')
        if unmapped:
            # Collapsed, not hidden: <details> expands in place, so nothing
            # becomes unreachable and no JavaScript is involved. Still never an
            # invented issue chip for a worktree that has no mapped issue —
            # the honest-mapping rule from #24 and #25.
            # No names in here any more (#65). A worktree with no mapped issue
            # has nothing to identify it *by* except its directory, and a
            # directory is not a fact about the product — so it is a count.
            # The SESSIONS strip still shows one dot per session.
            out.append(
                f'<p class="sub">{len(unmapped)} session(s) ahead of main on '
                f'work that maps to no issue</p>')

        out.append(f'<p class="psec">QUEUED · '
                   f'{len(pipeline["queued"]) + pipeline["queued_more"]}</p>')
        for r in pipeline["queued"]:
            out.append(chip(issue_label(r, strip_prefix(r["title"]))))
        if pipeline["queued_more"]:
            out.append(f'<p class="sub">+{pipeline["queued_more"]} more</p>')

        out.append(f'<p class="psec">MERGED TODAY · {len(pipeline["merged"])}</p>')
        if pipeline["merged"]:
            for r in pipeline["merged"]:
                out.append(chip(issue_label(r, r["title"])))
        else:
            out.append('<p class="sub">none yet</p>')

    # AT THE WALL was removed here by #65 (proposal 10, decision 3). It named
    # worktrees, and it said a second time what the NEEDS YOU band already says
    # first and larger — a wall item is exactly a thing waiting on the sponsor.
    return "\n".join(out)


def render_header(header, wall_count):
    if header:
        behind = [c for c in header["chips"] if c["state"] != "aligned"]
        aligned = len(header["chips"]) - len(behind)
        bits = [f'rules {e(header["rules"])}']
        if aligned:
            bits.append(f'<span style="color:var(--green)">●</span> {aligned} aligned')
        if behind:
            # Every project named inline overran the header once discovery
            # found six of them. The signal is which ones are *not* aligned, so
            # those keep their names (up to three) and the rest is a count.
            named = ", ".join(c["name"] for c in behind[:3])
            rest = len(behind) - 3
            bits.append(f'<span style="color:var(--amber)">△</span> {len(behind)} '
                        f'behind: {e(named)}{f" +{rest}" if rest > 0 else ""}')
        line1 = " ".join(bits)
    else:
        line1 = "rules unavailable"
    return (f'<div class="hdr-r"><p>{line1}</p>'
            f'<p><span class="wall-hd">THE WALL</span> · '
            f'{wall_count} item(s) waiting</p></div>')


def render_page():
    data = collect()
    now = datetime.datetime.now()

    # hulls_err used to be in here, so a failure inside compute_hulls blanked
    # both NEEDS YOU and SESSIONS for data neither of them showed (#65).
    graph_err = (data["worktrees_err"] or data["contested_err"]
                 or data["gate_err"])

    n_you = len(data["needs_input"]) + len(contested_notes(data["contested"])) // 2
    needs_you = region(
        f'NEEDS YOU · {n_you}' if n_you else "NEEDS YOU",
        None,
        render_needs_you(data["worktrees"], data["needs_input"],
                         data["contested"], data["features"]),
        graph_err, "needs you")

    sessions = region(
        "SESSIONS",
        '<span style="color:var(--green)">green</span> active · '
        '<span style="color:var(--dim)">grey</span> idle · '
        '<span style="color:var(--amber)">amber</span> contested · '
        '<span style="color:var(--purple)">purple</span> needs you',
        render_strip(data["worktrees"], data["needs_input"],
                     data["contested"], data["features"]),
        graph_err, "sessions")

    pipeline = region("PIPELINE", None,
                      render_pipeline(data["pipeline"], data["wall"]),
                      data["pipeline_err"] or data["wall_err"], "pipeline")

    # FEATURES replaces APPS & WORK PACKAGES (#65). The per-package bars
    # measured `##` headings, which in three of four projects are priority
    # buckets — "Now" is not a feature and never finishes. Depth inside a
    # feature is issue #63's burnup chart, not a bar per heading.
    features = region("FEATURES · WHAT THE PRODUCT IS MADE OF",
                      "declared by the sponsor · percentage only where a "
                      "feature names the issues that implement it",
                      render_features(data["features"]), data["features_err"],
                      "features")

    return f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="refresh" content="10">
<title>TOWER · apps autopilot, live</title>
<style>{CSS}</style>
</head>
<body>
<div class="tower">
  <header class="hdr">
    <div>
      <h1>TOWER · APPS AUTOPILOT · LIVE</h1>
      <p class="stamp">{e(now.strftime("%Y-%m-%d %H:%M:%S"))} · updates every {CACHE_TTL}s</p>
    </div>
    {render_header(data["header"], len(data["wall"]))}
  </header>
  <div class="band">{needs_you}</div>
  <!-- The order proposal 09's mockup locked: what needs him first and
       full-width, the work beside its progress, and the sessions demoted to a
       strip at the foot. The old page opened with 615px of session grid, so
       the two items that required him were below the fold of their own
       screen. -->
  <main class="grid">
    <div class="cell">{pipeline}</div>
    <div class="cell">{features}</div>
    <div class="cell wide">{sessions}</div>
  </main>
  <p class="foot">tower · loopback only · recollects every {CACHE_TTL}s ·
    <a href="/pulse">/pulse</a> for the plain-page view</p>
</div>
</body>
</html>
"""


def render_session_page(session_id):
    """The click-through panel: what a session last said, and what was handed
    to it. A page, not a dialog — the Tower is a served document, and a link
    is the only interaction an SVG screen gets for free."""
    d = session_digest(session_id)
    if not d:
        return ("<body style='background:#0B0E13;color:#DFE3EA;font-family:ui-monospace,monospace;"
                "padding:40px'><p>No transcript for that session.</p>"
                "<p><a style='color:#5FA985' href='/'>&larr; back to the Tower</a></p></body>")
    cwd = resolve_cwd(d["cwd"])
    received = "".join(
        f'<div style="border-left:2px solid #39434F;padding:6px 0 6px 12px;margin:10px 0">'
        f'<div style="color:#7C8594;font-size:12px">{e(m["ts"][11:16])} · from {e(m["sender"])}</div>'
        f'<div>{e(m["summary"])}</div></div>'
        for m in d["received"]) or '<p style="color:#7C8594">nothing was handed to this session</p>'
    return f"""<body style="background:#0B0E13;color:#DFE3EA;
      font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13px;
      line-height:1.6;margin:0;padding:40px;max-width:1000px">
  <p><a style="color:#5FA985;text-decoration:none" href="/">&larr; back to the Tower</a></p>
  <h2 style="font-size:15px;letter-spacing:.1em;color:#7C8594;font-weight:600">SESSION</h2>
  <p style="color:#DFE3EA">{e(session_id)}</p>
  <p style="color:#7C8594">working in {e(cwd)}</p>
  <h2 style="font-size:15px;letter-spacing:.1em;color:#7C8594;font-weight:600;margin-top:30px">
    HANDED TO THIS SESSION</h2>
  {received}
  <h2 style="font-size:15px;letter-spacing:.1em;color:#7C8594;font-weight:600;margin-top:30px">
    LAST DIGEST</h2>
  <pre style="white-space:pre-wrap;background:#131820;border:1px solid #26303C;
    border-radius:8px;padding:16px;color:#DFE3EA">{e(d["digest"]) or "(nothing said yet)"}</pre>
</body>"""


def render_pulse_page():
    # write=False: a GET here must not write the repo — pulse builds and
    # returns the HTML string, docs/pulse.html is untouched.
    body = PULSE.render(write=False)
    body = body.replace("<title>", '<meta http-equiv="refresh" content="10"><title>', 1)
    return body


# --- apprun self-registration (best-effort; never fatal) ---

def register_apprun(port):
    """Register this instance so 'leave nothing running' has something to
    check — a --demo proto copy, since it's started for the user to look
    at, not owned by any one task. Registration needs an owning session
    (apprun refuses ownerless entries by design); a plain-terminal run has
    none, so it's skipped, said out loud, and nothing else changes."""
    if not os.environ.get("CLAUDE_CODE_SESSION_ID"):
        print("apprun: registration skipped — CLAUDE_CODE_SESSION_ID is unset "
              "(not running inside an agent session), and apprun refuses to "
              "register an entry with no owner, by design.")
        return
    apprun = RULES / "bin" / "apprun"
    try:
        r = subprocess.run(
            [str(apprun), "start", "--project", "tower", "--phase", "proto",
             "--port", str(port), "--pid", str(os.getpid()),
             "--url", f"http://127.0.0.1:{port}/", "--demo"],
            capture_output=True, text=True, timeout=15)
        if r.returncode == 0:
            print(f"apprun: {r.stdout.strip()}")
        else:
            print(f"apprun: registration failed (non-fatal): {r.stderr.strip()}")
    except Exception as exc:
        print(f"apprun: registration failed (non-fatal): {exc}")


_deregistering = False  # reentrancy guard — see deregister_apprun


def deregister_apprun(port):
    # subprocess.run(), not Popen — deliberately blocking. `apprun stop`'s
    # own open_entries() drops any pid that's already dead *before it ever
    # calls terminate()*, so a fire-and-forget spawn races this process's
    # own exit: if we return control and the interpreter tears down before
    # the child's first registry read, the entry is skipped as already-gone
    # and left permanently "open" — worse than slow, silently wrong. Blocking
    # keeps this process alive (mid-call) until apprun's terminate() sees it,
    # so the close is guaranteed. The cost is apprun's own terminate() sending
    # *this* pid a redundant self-targeted SIGTERM as its first action.
    #
    # That redundant SIGTERM is exactly what makes the guard below load-
    # bearing, not defensive dressing: a signal handler in Python is not
    # blocked during its own execution, so that self-inflicted SIGTERM
    # re-enters _on_sigterm *while still blocked inside this very call*,
    # which spawns a second `apprun stop`, whose terminate() sends a third
    # SIGTERM, which spawns a third — found empirically as an unbounded
    # recursive subprocess spawn (confirmed via a 164KB traceback of nested
    # `_on_sigterm -> deregister_apprun -> subprocess.run -> _on_sigterm`
    # frames) that never let the registry write happen at all. One flag,
    # checked and set before the blocking call, makes every self-inflicted
    # repeat a no-op instead of a new spawn.
    global _deregistering
    if _deregistering:
        return
    _deregistering = True
    apprun = RULES / "bin" / "apprun"
    try:
        subprocess.run([str(apprun), "stop", "--port", str(port), "--include-demo"],
                       capture_output=True, text=True, timeout=15)
    except Exception:
        pass  # best-effort on the way out; never block shutdown forever on this


# --- server ---

def serve(port):
    import http.server

    register_apprun(port)
    atexit.register(deregister_apprun, port)

    def _on_sigterm(signum, frame):
        # Ignore SIGTERM from here on, *before* doing anything blocking:
        # deregister_apprun's own spawned `apprun stop` sends this exact pid
        # a redundant self-targeted SIGTERM as its first move. Left handled,
        # that re-enters this function while it's still blocked inside the
        # first call, which spawns a second `apprun stop`, which sends a
        # third SIGTERM, recursing without bound — confirmed empirically as
        # runaway nested subprocess spawns that never let the registry write
        # land. Ignoring means that redundant signal is silently dropped at
        # the OS level; apprun's terminate() still ends this process via
        # SIGKILL at its own 8s timeout if we haven't exited by then, and
        # SIGKILL cannot be ignored, so shutdown is still guaranteed.
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        deregister_apprun(port)
        sys.exit(0)  # triggers the atexit handler above too; deregister is idempotent

    signal.signal(signal.SIGTERM, _on_sigterm)

    class H(http.server.BaseHTTPRequestHandler):
        def _send(self, body, ctype="text/html; charset=utf-8"):
            data = body.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            if self.path.startswith("/pulse"):
                try:
                    self._send(render_pulse_page())
                except Exception as exc:
                    self._send(f"<pre>pulse unavailable: {html.escape(str(exc))}</pre>")
                return
            if self.path.startswith("/session/"):
                sid = self.path[len("/session/"):].split("?")[0]
                try:
                    self._send(render_session_page(sid))
                except Exception as exc:
                    self._send(f"<pre>session view failed: {html.escape(str(exc))}</pre>")
                return
            if self.path == "/" or self.path.startswith("/?"):
                try:
                    self._send(render_page())
                except Exception as exc:
                    self._send(f"<pre>tower render failed: {html.escape(str(exc))}</pre>")
                return
            self.send_response(404)
            self.end_headers()

        def log_message(self, *a):
            pass

    # loopback only: the screen renders private session data, same rule as pulse --serve
    httpd = http.server.HTTPServer(("127.0.0.1", port), H)
    print(f"tower: http://127.0.0.1:{port}/  (and /pulse)")
    httpd.serve_forever()


if __name__ == "__main__":
    port = DEFAULT_PORT
    if "--port" in sys.argv:
        port = int(sys.argv[sys.argv.index("--port") + 1])
    serve(port)
