        margin-top:var(--gap-4); padding-top:var(--gap-2);
        border-top:1px solid var(--line); }
a { color:var(--purple); }
""").substitute(**PALETTE)


def e(s):
    return html.escape(str(s))


def unavailable(label):
    return f'<p class="na">{e(label)} · unavailable</p>'


def region(title, sub, body, err=None, label=None):
    """One region. A failed collector renders this region empty with a note —
    never a 500 for the whole page, same contract as before."""
    out = [f'<div class="rgn"><p class="ht">{title}</p>']
    if sub:
        out.append(f'<p class="sub">{sub}</p>')
    out.append(body)
    if err:
        out.append(unavailable(label or "region"))
    out.append("</div>")
    return "\n".join(out)


def contested_notes(contested):
    """One note per contested pair, naming one file — the concept's own limit.
    Returns {worktree_name: (other_name, file)}."""
    notes, seen = {}, set()
    for a, b, f in contested:
        key = frozenset((a, b))
        if key in seen:
            continue
        seen.add(key)
        notes.setdefault(a, (b, f))
        notes.setdefault(b, (a, f))
    return notes


def render_needs_you(worktrees, needs_input, contested, features=None,
                     queue=None, drift=None):
    """The band, first and largest (issue #51).

    Of 23 session nodes on the live tree exactly two carried state, and they
    were the same size and weight as the 21 that did not. Everything that
    actually requires him is here instead, in words, above everything else —
    and when there is nothing, this collapses to one line and gives its height
    back rather than reserving empty space, which is the failure mode proposal
    09 is about in the first place.
    """
    by_name = {w["name"]: w for w in worktrees}
    rows = []

    for name, info in sorted(needs_input.items()):
        w = by_name.get(name)
        if not w:
            continue
        title = w.get("issue_title") or f'{project_tag(w["project"])} work'
        meta = [info["why"]]
        if w.get("issue_title"):
            meta.insert(0, f'{project_tag(w["project"])} #{w["issue"]}')
        # the feature it moves, where one is declared — never the worktree (#65)
        by_project = {r["project"]: r["features"] for r in (features or [])}
        feat = feature_of_issue(by_project.get(w["project"]), w.get("issue"))
        if feat:
            meta.insert(0, feat["title"])
        if info.get("age"):
            meta.append(f'{info["age"]}')
        rows.append(
            f'<div class="you-row"><p class="you-ttl clamp2" title="{e(title)}">'
            f'{e(title)}</p><p class="you-meta clamp1">'
            f'{" · ".join(e(m) for m in meta)}</p></div>')

    # A contested pair is an actionable collision — it belongs beside the other
    # things that need him, not drawn as a 470px diagonal across a node grid
    # with its caption floating unanchored at the midpoint (which is what it
    # was, and the only edge the "graph" ever rendered).
    for a, (b, f) in sorted(contested_notes(contested).items()):
        if a > b:
            continue  # one row per pair, not one per end
        rows.append(
            f'<div class="you-row cont"><p class="you-ttl clamp2" '
            f'title="{e(f)}">Contested · {e(f)}</p>'
            f'<p class="you-meta clamp1">two sessions are both holding the '
            f'same uncommitted file</p></div>')

    # Decisions waiting on him, counted from every open non-draft PR rather
    # than from worktree mapping -- a PR from an unmapped branch was invisible.
    if queue:
        nums = ", ".join(f'#{n}' for n in queue["numbers"][:6])
        more = f' +{len(queue["numbers"]) - 6}' if len(queue["numbers"]) > 6 else ""
        rows.insert(0,
            f'<div class="you-row"><p class="you-ttl clamp2">'
            f'{queue["count"]} decision(s) waiting</p>'
            f'<p class="you-meta clamp1">{e(nums)}{e(more)} · oldest waiting '
            f'{e(ago(queue["oldest"]) or "now")} · '
            f'{e(", ".join(queue["projects"]))}</p></div>')

    # Rules drift graduates out of the header once it is far enough behind to
    # be a thing to do rather than a thing to know.
    #
    # Capped, and the cap is the point. Measured on the live estate, every
    # project was 8-17 versions behind, so escalating all of them put five rows
    # in the band and recreated the wallpaper one level up -- the exact failure
    # this was meant to fix. The worst two earn rows; the rest is a count, so
    # the band stays scannable and the signal keeps its edge.
    #
    # Full project names here, not project_tag: the tag is built for compact
    # chips ("finance #41") and reads as a typo in a sentence ("idea has never
    # recorded a rules version").
    worst = sorted(drift or [], key=lambda d: -(d["behind"] or 10 ** 6))
    for d in worst[:DRIFT_ROWS_SHOWN]:
        if d["behind"] is None:
            head = f'{d["project"]} has never recorded a rules version'
            meta = "run rulecheck --align there · it is not the same as 0 behind"
        else:
            head = f'{d["project"]} is {d["behind"]} rules versions behind'
            meta = (f'stamped {d["stamped"]}, current is {d["current"]} · '
                    f'escalated past {DRIFT_ESCALATES_AT}')
        rows.append(f'<div class="you-row cont"><p class="you-ttl clamp2">{e(head)}</p>'
                    f'<p class="you-meta clamp1">{e(meta)}</p></div>')
    rest = len(worst) - DRIFT_ROWS_SHOWN
    if rest > 0:
        rows.append(f'<div class="you-row cont"><p class="you-ttl clamp2">'
                    f'+{rest} more project(s) behind the rules</p>'
                    f'<p class="you-meta clamp1">'
                    f'{e(", ".join(d["project"] for d in worst[DRIFT_ROWS_SHOWN:]))}'
                    f'</p></div>')

    if not rows:
        return ('<p class="you-none">nothing needs you · '
                'the autopilot is unblocked</p>')
    return f'<div class="you-band">{"".join(rows)}</div>'


def session_id_of(w):
    """The transcript filename is the session id — already collected as
    `newest_transcript`, never previously used for anything but its mtime."""
    t = w.get("newest_transcript")
    return t.stem if t else None


ALL = "all"     # the estate summary tab


def tab_projects(data):
    """Tab order: ALL first, then projects by how much is going on in them —
    a project with work in flight is the one being asked about."""
    counts = {}
    for w in data["worktrees"]:
        counts[w["project"]] = counts.get(w["project"], 0) + 1
    names = sorted({r["project"] for r in data["features"]} | set(counts),
                   key=lambda n: (-counts.get(n, 0), n))
    return [ALL] + names

STATE_ORDER = ("in flight", "next", "blocked", "later", "done")
BOARD_COLUMNS = (("in flight", "IN FLIGHT", "var(--green)"),
                 ("next", "NEXT", None),
                 ("blocked", "BLOCKED", "var(--amber)"),
                 ("done", "DONE", None))


def feature_pct(feature, closed):
    """(percent, note) for a feature, or (None, note) where no percentage is
    honest — which is most of them.

    A blocked feature gets no number and no bar. An empty track reads as 0%,
    and 0% is a claim about progress that nothing supports (#70).
    """
    impl = feature["implements"]
    if feature["kind"] == "blocked":
        by = ", ".join(f'#{n}' for n in feature["blocked_by"])
        return None, f'blocked by {by}' if by else "blocked"
    if not impl or not closed:
        return None, feature["state"] or ""
    done = sum(1 for n in impl if closed.get(n))
    return round(done / len(impl) * 100), f'{done}/{len(impl)} issues'


def undeclared_line(rows):
    """One grouped statement, not one apology per project (#70). Five separate
    'no features declared' lines shouted over the single project that had any."""
    none = [r for r in rows if not r["features"]]
    if not none:
        return ""
    names = ", ".join(r["project"] for r in none)
    done = sum(r["items"][0] for r in none if r["items"])
    total = sum(r["items"][1] for r in none if r["items"])
    tail = (f' {done}/{total} checklist items ticked between them, against no '
            f'product definition.' if total else "")
    return (f'<p class="f-none">{e(names)} — <span class="warn">no features '
            f'declared</span>.{e(tail)}</p>')


def whole_product(rows):
    """(percent, declared, projects_with_registers, total_projects) or None.

    The denominator is stated, never implied. A figure that silently averages
    over projects which declared nothing is the failure mode proposal 08 named,
    and it binds hardest here because this is the number asked for by name.
    """
    feats = [(f, r["closed"]) for r in rows for f in (r["features"] or [])]
    if not feats:
        return None
    with_reg = sum(1 for r in rows if r["features"])
    pcts = [feature_pct(f, c)[0] for f, c in feats]
    scored = [x for x in pcts if x is not None]
    # unscored features count as 0 toward the product, not as absent: a blocked
    # feature is undone, and dropping it would flatter the figure
    pct = round(sum(scored) / len(feats)) if feats else 0
    return pct, len(feats), with_reg, len(rows)


def render_tabs(names, current):
    """Tabs are links carrying ?project=, not DOM state.

    The page re-requests itself every 10s via <meta refresh>, and DOM state does
    not survive that -- measured when the view tabs were built: a CSS :checked
    tab reverted to its default on every reload, while a query string survived.
    The constraint is unchanged, so the mechanism is too.
    """
    out = []
    for name in names:
        cls = "tab on" if name == current else "tab"
        label = "ALL" if name == ALL else name
        out.append(f'<a class="{cls}" href="/?project={e(name)}">{e(label)}</a>')
    return f'<div class="tabs">{"".join(out)}</div>'


def render_board(rows):
    """Features in columns by state (#70). Replaces PIPELINE rather than sitting
    beside it: PIPELINE was already a board of work by state, and two boards of
    the same shape at different altitudes is the noise proposal 10 removed."""
    if rows is None:
        return unavailable("features")
    by_kind = {}
    for r in rows:
        for f in r["features"] or []:
            by_kind.setdefault(f["kind"], []).append((r, f))
    out = ['<div class="board">']
    for kind, label, colour in BOARD_COLUMNS:
        items = by_kind.get(kind, [])
        style = f' style="color:{colour}"' if colour else ""
        out.append(f'<div class="col"><p class="psec"{style}>{label} · {len(items)}</p>')
        if not items:
            out.append(f'<p class="sub">{e(EMPTY_COLUMN.get(kind, "none"))}</p>')
        for r, f in items:
            pct, note = feature_pct(f, r["closed"])
            fig = f'<span class="f-fig">{pct}%</span>' if pct is not None else ""
            out.append(f'<div class="fcard"><p class="fc-t clamp2" '
                       f'title="{e(f["title"])}">{e(f["title"])}</p>'
                       f'<p class="fc-m clamp1">{e(project_tag(r["project"]))} · '
                       f'{e(note)}</p>{fig}</div>')
        out.append("</div>")
    out.append("</div>")
    out.append(undeclared_line(rows))
    return "\n".join(out)


# An empty column is a fact, and DONE·0 is an uncomfortable one. Say why rather
# than hiding it: proposal 05 means a feature is done when the sponsor closes
# it, not when its tickets are shut.
EMPTY_COLUMN = {
    "in flight": "nothing in flight",
    "next": "nothing queued behind what is in flight",
    "blocked": "nothing blocked",
    "done": "nothing closed yet — a feature is done when you close it, "
            "not when its issues are",
}


def sparkline(points, width=260, height=44):
    """Two lines — done and total — over the checklist's own history (#63).

    A burn*up*, not a burndown, and the gap between the lines is the point.
    finance-tracker went 9/25 to 16/51: seven items completed while the
    percentage FELL from 36% to 31%, because scope grew by 26. One number
    cannot tell "nothing is happening" from "a lot is happening and scope is
    outrunning it", and those need opposite responses.

    Not smoothed and not clamped monotonic. The real data dips — mac-explorer's
    total went 8 to 5 — and a dip is a re-scoping, which is information.
    """
    if len(points) < 2:
        return ""
    hi = max(t for _, _, t in points) or 1
    n = len(points) - 1
    def path(idx):
        pts = []
        for i, row in enumerate(points):
            x = round(i / n * width, 1)
            y = round(height - (row[idx] / hi) * height, 1)
            pts.append(f'{x},{y}')
        return " ".join(pts)
    return (f'<svg class="spark" viewBox="0 0 {width} {height}" '
            f'preserveAspectRatio="none" role="img" aria-label="burnup">'
            f'<polyline points="{path(2)}" class="sp-total"/>'
            f'<polyline points="{path(1)}" class="sp-done"/></svg>')


def render_progress(history):
    """PROGRESS — what moved, and how fast (#66, #63).

    A third tab rather than a sixth region: the screen is 900px and already
    holds the band, the features region and the strip. Measurement over time is
    detail, and detail belongs behind a tab.
    """
    if not history:
        return ('<p class="sub">no project has enough checklist history yet — '
                'this reads the git log of CLAUDE-checklist.md, so a project '
                'needs at least two revisions of one</p>')
    out = ['<div class="prog">']
    for h in history:
        pts = h["points"]
        d0, t0 = pts[0][1], pts[0][2]
        d1, t1 = pts[-1][1], pts[-1][2]
        v = velocity(pts)
        mv = moved(pts)
        pct0 = round(d0 / t0 * 100) if t0 else 0
        pct1 = round(d1 / t1 * 100) if t1 else 0
        out.append(f'<div class="pname">{e(h["project"])}</div>')
        out.append(f'<div class="pchart">{sparkline(pts)}</div>')
        out.append(f'<div class="pfig">{d1}/{t1}<br><span class="dim">{pct1}%</span></div>')
        notes = [f'{pts[0][0]} → {pts[-1][0]} · {d0}/{t0} → {d1}/{t1}']
        if pct1 < pct0:
            # the case a single percentage actively hides
            notes.append(f'{pct0}% → {pct1}% while completing {d1 - d0}: '
                         f'scope grew by {t1 - t0}')
        if v and v[0]:
            notes.append(f'{v[0]} item(s) completed in the last {v[1]} days')
        if mv:
            b0, b1, s0, s1 = mv
            bits = []
            if b1 != b0:
                bits.append(f'{b1 - b0:+d} done')
            if s1 != s0:
                bits.append(f'{s1 - s0:+d} scope' if s1 > s0
                            else f'{s1 - s0:+d} scope (re-scoped)')
            if bits:
                notes.append("today: " + ", ".join(bits))
        out.append(f'<div class="pnote">' +
                   "<br>".join(f'<span class="clamp1">{e(x)}</span>' for x in notes) +
                   "</div>")
    out.append("</div>")
    out.append('<p class="sub">measured from each checklist\'s own git history · '
               'a rate is what happened, not a forecast — no ETA, by the same '
               'rule proposal 08 set</p>')
    return "\n".join(out)


def render_project(name, data):
    """Everything about one project, on one screen (#81).

    The lenses existed because six projects' features, history and flow do not
    fit in 900px. One project's do -- measured, the largest is 7 features, 6
    sessions and 9 history points -- so the split is not re-cut per project, it
    is retired.
    """
    feats = [r for r in data["features"] if r["project"] == name]
    hist = [h for h in data["history"] if h["project"] == name]
    wts = [w for w in data["worktrees"] if w["project"] == name]
    pipe = data["pipeline"]
    if pipe:
        pipe = {**pipe,
                "queued": [r for r in pipe["queued"] if r.get("project") == name],
                "merged": [r for r in pipe["merged"] if r.get("project") == name]}
        # queued_more counts issues beyond the shown slice across every project,
        # so it cannot be filtered honestly -- drop it rather than misattribute
        pipe["queued_more"] = 0

    row = feats[0] if feats else None
    head = [name]
    if row and row["features"]:
        head.append(f'{len(row["features"])} features')
    if row and row.get("items"):
        d, t = row["items"]
        head.append(f'{d}/{t} items · {round(d / t * 100) if t else 0}%')
    out = [f'<p class="phead">{e(" · ".join(head))}</p>']

    out.append(render_board(feats))
    if hist:
        out.append('<p class="psec">PROGRESS</p>')
        out.append(render_progress(hist))
    out.append(render_flow(pipe))
    out.append('<p class="psec">SESSIONS</p>')
    out.append(render_strip(wts, data["needs_input"], data["contested"], feats))
    return "\n".join(out)


def render_all(data):
    """One line per project, comparable down each column (#81).

    This is where "which app is stuck" is answerable, which is the only
    question a top level needs to answer.
    """
    feats = {r["project"]: r for r in data["features"]}
    hist = {h["project"]: h for h in data["history"]}
    drift = {d["project"]: d for d in data["drift"]}
    counts = {}
    for w in data["worktrees"]:
        counts[w["project"]] = counts.get(w["project"], 0) + 1
    names = sorted(set(feats) | set(counts))
    if not names:
        return unavailable("projects")
    # The whole-product figure moves here from the retired LEDGER (#81). The
    # estate summary is where it belongs: it is a statement about every project,
    # so it cannot sit on a page showing one. Denominator stated, never implied.
    out = []
    wp = whole_product(data["features"])
    if wp:
        pct, n, with_reg, total = wp
        out.append(f'<p class="wp"><b>{pct}%</b> of declared scope · {n} features '
                   f'in {with_reg} of {total} projects</p>')
    else:
        out.append('<p class="sub">no project has declared its features yet, so '
                   'there is no whole-product figure to report</p>')
    out.append('<div class="estate">')
    out.append('<div class="lh">PROJECT</div><div class="lh">FEATURES</div>'
               '<div class="lh">ITEMS</div><div class="lh">7-DAY</div>'
               '<div class="lh">SESSIONS</div><div class="lh">RULES</div>')
    for n in names:
        r = feats.get(n)
        if r and r["features"]:
            by_kind = {}
            for f in r["features"]:
                by_kind[f["kind"]] = by_kind.get(f["kind"], 0) + 1
            fcell = " · ".join(f'{v} {k}' for k, v in sorted(by_kind.items()))
        else:
            fcell = '<span class="warn">no features declared</span>'
        items = r.get("items") if r else None
        if items and items[1]:
            pct = round(items[0] / items[1] * 100)
            icell = (f'<div class="bar"><i style="width:{pct}%"></i></div>'
                     f'<span class="f-fig">{pct}%</span>')
        else:
            icell = '<span class="dim">no checklist</span>'
        v = velocity(hist[n]["points"]) if n in hist else None
        vcell = f'{v[0]:+d}' if v else "—"
        d = drift.get(n)
        if d is None:
            rcell = '<span class="dim">aligned</span>'
        elif d["behind"] is None:
            rcell = '<span class="warn">never stamped</span>'
        else:
            rcell = f'<span class="warn">{d["behind"]} behind</span>'
        out.append(f'<a class="pname" href="/?project={e(n)}">{e(n)}</a>'
                   f'<div class="clamp1">{fcell}</div>'
                   f'<div class="lprog">{icell}</div>'
                   f'<div class="f-fig">{vcell}</div>'
                   f'<div class="f-fig">{counts.get(n, 0)}</div>'
                   f'<div class="clamp1">{rcell}</div>')
    out.append("</div>")
    out.append('<p class="sub">click a project, or its tab, for everything about '
               'it · 7-day is items completed, a measurement and not a forecast</p>')
    return "\n".join(out)


def render_flow(pipeline):
    """QUEUED and MERGED TODAY, moved here when PIPELINE came off the main
    screen (#71). Issue-level flow is detail; the board is the altitude the
    sponsor asked for."""
    if not pipeline:
        return ""
    out = ['<p class="psec">QUEUED · '
           f'{len(pipeline["queued"]) + pipeline["queued_more"]}</p>']
    for r in pipeline["queued"]:
        out.append(chip(issue_label(r, strip_prefix(r["title"]))))
    if pipeline["queued_more"]:
        out.append(f'<p class="sub">+{pipeline["queued_more"]} more</p>')
    out.append(f'<p class="psec">MERGED TODAY · {len(pipeline["merged"])}</p>')
    if pipeline["merged"]:
        for r in pipeline["merged"]:
            out.append(chip(issue_label(r, r["title"])))
    else:
        out.append('<p class="sub">none yet</p>')
    return "\n".join(out)


def render_strip(worktrees, needs_input, contested, features):
    """SESSIONS, grouped by the feature each one is moving (#65).

    Two things changed from #52. It groups by *declared feature* rather than
    showing one flat row -- the grouping concept 07 drew as dashed hulls, which
    #52 dropped and nothing replaced. And **no worktree or branch name appears
    anywhere**, including in the hover: a folder on disk is not a fact about the
    product, and naming one was the whole of the sponsor's complaint.
    """
    if not worktrees:
        return unavailable("no worktrees found")
    cont = contested_notes(contested)
    by_project = {r["project"]: r["features"] for r in (features or [])}

    groups, counts = {}, {"active": 0, "needs you": 0, "contested": 0, "idle": 0}
    for w in sorted(worktrees, key=lambda x: (x["project"], x["short"])):
        age_s = (time.time() - w["session"]) if w["session"] else None
        # Every session lands in exactly one bucket. In #52 the contested branch
        # assigned a class and counted nothing, so the summary read
        # "22 · 0 active, 1 needs you, 4 idle" and 17 sessions vanished from
        # their own total.
        if w["name"] in needs_input:
            cls, bucket = "you", "needs you"
        elif w["name"] in cont:
            cls, bucket = "cont", "contested"
        elif age_s is not None and age_s < 1800:
            cls, bucket = "live", "active"
        else:
            cls, bucket = "idle", "idle"
        counts[bucket] += 1

        feat = feature_of_issue(by_project.get(w["project"]), w.get("issue"))
        key = (f'{project_tag(w["project"])} · {feat["title"]}' if feat
               else "no declared feature")
        # The hover names the feature and the issue. Never the worktree.
        bits = [key]
        if w.get("issue_title"):
            bits.append(f'{project_tag(w["project"])} #{w["issue"]}: {w["issue_title"]}')
        if age_s is not None:
            bits.append(f'last active {ago(w["session"])}')
        sid = session_id_of(w)
        tip = " — ".join(bits)
        dot = (f'<a class="dot {cls}" href="/session/{e(sid)}" title="{e(tip)}">'
               f'<span></span></a>' if sid else
               f'<span class="dot {cls}" title="{e(tip)}"><span></span></span>')
        groups.setdefault(key, []).append(dot)

    total = len(worktrees)
    parts = [f'{total} · ' + ", ".join(f'{n} {k}' for k, n in counts.items() if n)]
    out = [f'<p class="strip-count">{e(parts[0])}</p>']
    # declared features first, the unmapped remainder last: it is a gap, not a group
    for key in sorted(groups, key=lambda k: (k == "no declared feature", k)):
        dots = groups[key]
        out.append(f'<p class="strip-grp">{e(key)} · {len(dots)}</p>'
                   f'<div class="strip">{"".join(dots)}</div>')
    out.append('<p class="sub">hover a dot for the feature and issue · '
               'click to open the session</p>')
    return "\n".join(out)


def issue_label(row, title):
    """`finance #41 the Ticket Rail` — the project tag is not decoration: with
    six repos on one screen a bare "#22" names two different tickets."""
    tag = project_tag(row.get("project", "")) if row.get("project") else ""
    return f'{tag} #{row["number"]} {title}'.strip()


def chip(label, cls=""):
    return (f'<div class="chip {cls} clamp1" title="{e(label)}">{e(label)}</div>')


def strip_prefix(title):
    return title.split(":", 1)[-1].strip() if ":" in title else title


def render_header(header, wall_count, stale=None):
    if header:
        behind = [c for c in header["chips"] if c["state"] != "aligned"]
        aligned = len(header["chips"]) - len(behind)
        bits = [f'rules {e(header["rules"])}']
        if aligned:
            bits.append(f'<span style="color:var(--green)">●</span> {aligned} aligned')
        if behind:
            # Every project named inline overran the header once discovery
            # found six of them. The signal is which ones are *not* aligned, so
            # those keep their names (up to three) and the rest is a count.
            named = ", ".join(c["name"] for c in behind[:3])
            rest = len(behind) - 3
            bits.append(f'<span style="color:var(--amber)">△</span> {len(behind)} '
                        f'behind: {e(named)}{f" +{rest}" if rest > 0 else ""}')
        line1 = " ".join(bits)
    else:
        line1 = "rules unavailable"
    out = [f'<div class="hdr-r"><p>{line1}</p>',
           f'<p><span class="wall-hd">THE WALL</span> · '
           f'{wall_count} item(s) waiting</p>']
    # Absent when current. A staleness line that is always there is finding 3 of
    # proposal 12 all over again -- a permanent warning nobody reads.
    if stale:
        out.append(f'<p class="stale">⚠ running {e(stale["here"])} · main is '
                   f'{stale["behind"]} ahead · restart to update</p>')
    out.append('</div>')
    return "".join(out)


def render_page(project=ALL):
    data = collect()
    now = datetime.datetime.now()

    # hulls_err used to be in here, so a failure inside compute_hulls blanked
    # both NEEDS YOU and SESSIONS for data neither of them showed (#65).
    graph_err = (data["worktrees_err"] or data["contested_err"]
                 or data["gate_err"])

    drift_rows = min(len(data["drift"]), DRIFT_ROWS_SHOWN) + \
        (1 if len(data["drift"]) > DRIFT_ROWS_SHOWN else 0)
    n_you = (len(data["needs_input"]) + len(contested_notes(data["contested"])) // 2
             + (1 if data["queue"] else 0) + drift_rows)
    title = f'NEEDS YOU · {n_you}' if n_you else "NEEDS YOU"
    if data["queue"]:
        title += f' · OLDEST WAITING {(ago(data["queue"]["oldest"]) or "now").upper()}'
    needs_you = region(
        title, None,
        render_needs_you(data["worktrees"], data["needs_input"],
                         data["contested"], data["features"],
                         data["queue"], data["drift"]),
        graph_err, "needs you")

    sessions_all = region(
        "SESSIONS · EVERY PROJECT",
        '<span style="color:var(--green)">green</span> active · '
        '<span style="color:var(--dim)">grey</span> idle · '
        '<span style="color:var(--amber)">amber</span> contested · '
        '<span style="color:var(--purple)">purple</span> needs you',
        render_strip(data["worktrees"], data["needs_input"],
                     data["contested"], data["features"]),
        graph_err, "sessions")

    # The features region replaces PIPELINE outright (#70). PIPELINE was
    # already a board of work by state; a board of *features* by state beside it
    # would be two boards of one shape at different altitudes. The feature board
    # IS the pipeline, one altitude up, and it needs the full width for four
    # columns — at ~600px they were ~150px each and every title truncated.
    tabs = tab_projects(data)
    if project not in tabs:
        project = ALL          # unknown or stale project name falls back
    body = (render_all(data) if project == ALL
            else render_project(project, data))
    body_err = (data["features_err"] or data["history_err"]
                or (data["pipeline_err"] if project != ALL else None))
    features = region("PROJECTS", None, render_tabs(tabs, project) + body,
                      body_err, "projects")

    # The estate-wide strip belongs on ALL only: a project page has its own,
    # already filtered, and showing both would say the same thing twice.
    sessions_block = (f'<div class="cell wide">{sessions_all}</div>'
                      if project == ALL else "")

    return f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="refresh" content="10">
<title>TOWER · apps autopilot, live</title>
<style>{CSS}</style>
</head>
<body>
<div class="tower">
  <header class="hdr">
    <div>
      <h1>TOWER · APPS AUTOPILOT · LIVE</h1>
      <p class="stamp">{e(now.strftime("%Y-%m-%d %H:%M:%S"))} · updates every {CACHE_TTL}s</p>
    </div>
    {render_header(data["header"], len(data["wall"]), data["stale"])}
  </header>
  <div class="band">{needs_you}</div>
  <!-- The order proposal 09's mockup locked: what needs him first and
       full-width, the work beside its progress, and the sessions demoted to a
       strip at the foot. The old page opened with 615px of session grid, so
       the two items that required him were below the fold of their own
       screen. -->
  <main class="grid">
    <div class="cell wide">{features}</div>
    {sessions_block}
  </main>
  <p class="foot">tower · loopback only · recollects every {CACHE_TTL}s ·
    <a href="/pulse">/pulse</a> for the plain-page view</p>
</div>
</body>
</html>
"""


def render_session_page(session_id):
    """The click-through panel: what a session last said, and what was handed
    to it. A page, not a dialog — the Tower is a served document, and a link
    is the only interaction an SVG screen gets for free."""
    d = session_digest(session_id)
    if not d:
        return ("<body style='background:#0B0E13;color:#DFE3EA;font-family:ui-monospace,monospace;"
                "padding:40px'><p>No transcript for that session.</p>"
                "<p><a style='color:#5FA985' href='/'>&larr; back to the Tower</a></p></body>")
    cwd = resolve_cwd(d["cwd"])
    received = "".join(
        f'<div style="border-left:2px solid #39434F;padding:6px 0 6px 12px;margin:10px 0">'
        f'<div style="color:#7C8594;font-size:12px">{e(m["ts"][11:16])} · from {e(m["sender"])}</div>'
        f'<div>{e(m["summary"])}</div></div>'
        for m in d["received"]) or '<p style="color:#7C8594">nothing was handed to this session</p>'
    return f"""<body style="background:#0B0E13;color:#DFE3EA;
      font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13px;
      line-height:1.6;margin:0;padding:40px;max-width:1000px">
  <p><a style="color:#5FA985;text-decoration:none" href="/">&larr; back to the Tower</a></p>
  <h2 style="font-size:15px;letter-spacing:.1em;color:#7C8594;font-weight:600">SESSION</h2>
  <p style="color:#DFE3EA">{e(session_id)}</p>
  <p style="color:#7C8594">working in {e(cwd)}</p>
  <h2 style="font-size:15px;letter-spacing:.1em;color:#7C8594;font-weight:600;margin-top:30px">
    HANDED TO THIS SESSION</h2>
  {received}
  <h2 style="font-size:15px;letter-spacing:.1em;color:#7C8594;font-weight:600;margin-top:30px">
    LAST DIGEST</h2>
  <pre style="white-space:pre-wrap;background:#131820;border:1px solid #26303C;
    border-radius:8px;padding:16px;color:#DFE3EA">{e(d["digest"]) or "(nothing said yet)"}</pre>
</body>"""


def render_pulse_page():
    # write=False: a GET here must not write the repo — pulse builds and
    # returns the HTML string, docs/pulse.html is untouched.
    body = PULSE.render(write=False)
    body = body.replace("<title>", '<meta http-equiv="refresh" content="10"><title>', 1)
    return body


# --- apprun self-registration (best-effort; never fatal) ---

def register_apprun(port):
    """Register this instance so 'leave nothing running' has something to
    check — a --demo proto copy, since it's started for the user to look
    at, not owned by any one task. Registration needs an owning session
    (apprun refuses ownerless entries by design); a plain-terminal run has
    none, so it's skipped, said out loud, and nothing else changes."""
    if not os.environ.get("CLAUDE_CODE_SESSION_ID"):
        print("apprun: registration skipped — CLAUDE_CODE_SESSION_ID is unset "
              "(not running inside an agent session), and apprun refuses to "
              "register an entry with no owner, by design.")
        return
    apprun = RULES / "bin" / "apprun"
    try:
        r = subprocess.run(
            [str(apprun), "start", "--project", "tower", "--phase", "proto",
             "--port", str(port), "--pid", str(os.getpid()),
             "--url", f"http://127.0.0.1:{port}/", "--demo"],
            capture_output=True, text=True, timeout=15)
        if r.returncode == 0:
            print(f"apprun: {r.stdout.strip()}")
        else:
            print(f"apprun: registration failed (non-fatal): {r.stderr.strip()}")
    except Exception as exc:
        print(f"apprun: registration failed (non-fatal): {exc}")


_deregistering = False  # reentrancy guard — see deregister_apprun


def deregister_apprun(port):
    # subprocess.run(), not Popen — deliberately blocking. `apprun stop`'s
    # own open_entries() drops any pid that's already dead *before it ever
    # calls terminate()*, so a fire-and-forget spawn races this process's
    # own exit: if we return control and the interpreter tears down before
    # the child's first registry read, the entry is skipped as already-gone
    # and left permanently "open" — worse than slow, silently wrong. Blocking
    # keeps this process alive (mid-call) until apprun's terminate() sees it,
    # so the close is guaranteed. The cost is apprun's own terminate() sending
    # *this* pid a redundant self-targeted SIGTERM as its first action.
    #
    # That redundant SIGTERM is exactly what makes the guard below load-
    # bearing, not defensive dressing: a signal handler in Python is not
    # blocked during its own execution, so that self-inflicted SIGTERM
    # re-enters _on_sigterm *while still blocked inside this very call*,
    # which spawns a second `apprun stop`, whose terminate() sends a third
    # SIGTERM, which spawns a third — found empirically as an unbounded
    # recursive subprocess spawn (confirmed via a 164KB traceback of nested
    # `_on_sigterm -> deregister_apprun -> subprocess.run -> _on_sigterm`
    # frames) that never let the registry write happen at all. One flag,
    # checked and set before the blocking call, makes every self-inflicted
    # repeat a no-op instead of a new spawn.
    global _deregistering
    if _deregistering:
        return
    _deregistering = True
    apprun = RULES / "bin" / "apprun"
    try:
        subprocess.run([str(apprun), "stop", "--port", str(port), "--include-demo"],
                       capture_output=True, text=True, timeout=15)
    except Exception:
        pass  # best-effort on the way out; never block shutdown forever on this


# --- server ---

def serve(port):
    import http.server

    register_apprun(port)
    atexit.register(deregister_apprun, port)

    def _on_sigterm(signum, frame):
        # Ignore SIGTERM from here on, *before* doing anything blocking:
        # deregister_apprun's own spawned `apprun stop` sends this exact pid
        # a redundant self-targeted SIGTERM as its first move. Left handled,
        # that re-enters this function while it's still blocked inside the
        # first call, which spawns a second `apprun stop`, which sends a
        # third SIGTERM, recursing without bound — confirmed empirically as
        # runaway nested subprocess spawns that never let the registry write
        # land. Ignoring means that redundant signal is silently dropped at
        # the OS level; apprun's terminate() still ends this process via
        # SIGKILL at its own 8s timeout if we haven't exited by then, and
        # SIGKILL cannot be ignored, so shutdown is still guaranteed.
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        deregister_apprun(port)
        sys.exit(0)  # triggers the atexit handler above too; deregister is idempotent

    signal.signal(signal.SIGTERM, _on_sigterm)

    class H(http.server.BaseHTTPRequestHandler):
        def _send(self, body, ctype="text/html; charset=utf-8"):
            data = body.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            if self.path.startswith("/pulse"):
                try:
                    self._send(render_pulse_page())
                except Exception as exc:
                    self._send(f"<pre>pulse unavailable: {html.escape(str(exc))}</pre>")
                return
            if self.path.startswith("/session/"):
                sid = self.path[len("/session/"):].split("?")[0]
                try:
                    self._send(render_session_page(sid))
                except Exception as exc:
                    self._send(f"<pre>session view failed: {html.escape(str(exc))}</pre>")
                return
            if self.path == "/" or self.path.startswith("/?"):
                # The tab is a query parameter, not DOM state (#70, #81). The
                # page re-requests itself every 10s via <meta refresh>, which
                # throws the DOM away -- measured: a CSS :checked tab reverted on
                # every reload, while a query string survived. An unknown or
                # missing project falls back to ALL rather than erroring.
                q = urllib.parse.urlparse(self.path).query
                project = urllib.parse.parse_qs(q).get("project", [ALL])[0]
                try:
                    self._send(render_page(project))
                except Exception as exc:
                    self._send(f"<pre>tower render failed: {html.escape(str(exc))}</pre>")
                return
            self.send_response(404)
            self.end_headers()

        def log_message(self, *a):
            pass

    # loopback only: the screen renders private session data, same rule as pulse --serve
    httpd = http.server.HTTPServer(("127.0.0.1", port), H)
    print(f"tower: http://127.0.0.1:{port}/  (and /pulse)")
    httpd.serve_forever()


if __name__ == "__main__":
    port = DEFAULT_PORT
    if "--port" in sys.argv:
        port = int(sys.argv[sys.argv.index("--port") + 1])
    serve(port)
