#!/usr/bin/env python3
"""remember — the write side of recall (proposal 19, D11, W-06).

Writes one fact file in Claude Code's own auto-memory shape and appends its
index line, so it is loaded next session without anything new to search.

  remember --name SLUG --description TEXT --type {user,feedback,project,reference}
           [--item ID] [--issue N] [--dir MEMORY_DIR] [BODY]

BODY comes from the argument, or from stdin when it is omitted.

Default --dir is Claude Code's own auto-memory location for the current
project: ~/.claude/projects/<cwd with every "/" replaced by "-">/memory.

Exit codes: 0 written, 1 a file of that name already exists (nothing is
written), 2 a bad --name.
"""
from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

SLUG = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
TYPES = ("user", "feedback", "project", "reference")


def default_dir() -> Path:
    slug_cwd = str(Path.cwd()).replace("/", "-")
    return Path.home() / ".claude" / "projects" / slug_cwd / "memory"


def title_for(slug: str) -> str:
    title = slug.replace("-", " ")
    return title[0].upper() + title[1:] if title else title


def ledger_line(item: str | None, issue: int | None) -> str | None:
    if not item and issue is None:
        return None
    if item and issue is not None:
        return f"Ledger: {item} · issue #{issue}"
    if item:
        return f"Ledger: {item}"
    return f"Ledger: issue #{issue}"


def write_memory(path: Path, name: str, description: str, type_: str, body: str,
                  item: str | None, issue: int | None) -> None:
    extra = ledger_line(item, issue)
    body = body.rstrip("\n")
    if extra:
        body = f"{body}\n{extra}" if body else extra
    content = (
        "---\n"
        f"name: {name}\n"
        f"description: {description}\n"
        "metadata:\n"
        f"  type: {type_}\n"
        "---\n"
        "\n"
        f"{body}\n"
    )
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")


def append_index(dir_: Path, slug: str, description: str) -> None:
    index = dir_ / "MEMORY.md"
    line = f"- [{title_for(slug)}]({slug}.md) — {description}\n"
    if not index.exists():
        index.write_text("# Memory index\n\n" + line, encoding="utf-8")
        return
    existing = index.read_text(encoding="utf-8")
    if not existing.endswith("\n"):
        existing += "\n"
    index.write_text(existing + line, encoding="utf-8")


def run(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="remember", add_help=True)
    parser.add_argument("--name", required=True, dest="name")
    parser.add_argument("--description", required=True, dest="description")
    parser.add_argument("--type", required=True, choices=TYPES, dest="type_")
    parser.add_argument("--item", default=None)
    parser.add_argument("--issue", type=int, default=None)
    parser.add_argument("--dir", default=None, dest="dir_")
    parser.add_argument("body", nargs="?", default=None, metavar="BODY")
    args = parser.parse_args(argv)

    if not SLUG.match(args.name):
        print(f"remember: --name {args.name!r} is not lower-kebab-case", file=sys.stderr)
        return 2

    mem_dir = Path(args.dir_).expanduser() if args.dir_ else default_dir()
    path = mem_dir / f"{args.name}.md"
    if path.exists():
        print(f"already remembered: {path}; update that file instead", file=sys.stderr)
        return 1

    body = args.body if args.body is not None else sys.stdin.read()

    write_memory(path, args.name, args.description, args.type_, body, args.item, args.issue)
    append_index(mem_dir, args.name, args.description)
    print(str(path))
    return 0


if __name__ == "__main__":
    sys.exit(run(sys.argv[1:]))
