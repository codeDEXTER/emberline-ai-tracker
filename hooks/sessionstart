#!/usr/bin/env python3
"""SessionStart hook (proposal 19, D8 / W-07; proposal 21, S-05). After a
compaction, points the session back at the ledger rather than the summary it
just lost context to (proposal 19, section K, "after the cut"); at an
ordinary start, nudges toward `/warmup` when there is an open ledger to read.

When the start folder has no open ledger of its own -- a session started in
a parent folder that holds several projects, like PhotoVault/ holding app/
and engine/ -- it looks one level down instead (S-05): any direct child
directory that is itself a project (its own `.common-rules.json`, or an open
ledger under its own docs/proposals/) gets one line naming it and its status,
plus the `/warmup --project` command to warm it up. A start folder with its
own open ledger behaves exactly as before; this only fires when it has none.
Capped at MAX_CHILDREN, sorted by name, with a `+N more` line rather than one
pair per project on the machine. A child this session cannot read (a
permission error, a race) is left off the list rather than hiding every
other child's line.

Reads the hook's JSON on stdin (fields including `cwd`, `source` -- both
optional, per Claude Code's SessionStart contract; `source` is one of
startup | resume | clear | compact). Anything printed to stdout here is
added to the session's context. Read-only throughout: no writes, no network,
no git command that writes, and only one level down -- no recursion into a
child's own subdirectories beyond what ledger.find already reads (its own
docs/proposals/). Never fails the session: every exception is swallowed and
the exit code is always 0.

DISPATCH TO WARMUP (proposal 28, R-03). When the start folder has its own
open ledger, `startup` runs `bin/warmup` (the plain card, no --queue: a hook
never writes); `compact` and `resume` run `bin/warmup --reheat`. Both always
pass `--no-pull`, keeping this hook's own read-only, no-network contract even
though warmup's plain card and --reheat otherwise fast-forward the rules
checkout (R-05). Every call to warmup is bounded by WARMUP_TIMEOUT (well
under Claude Code's own hook timeout); a timeout, a non-zero exit, or any
other failure falls back to this hook's own one-line-per-ledger summary,
never to a failed session. `clear` and any other or missing source keep that
same one-line fallback outright -- only startup, resume and compact reach
for the fuller card.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO))

# proposal 28, R-03: a hard timeout well under Claude Code's own. Overridable
# only for tests, which need a deterministic way to exercise the fallback.
WARMUP_TIMEOUT = float(os.environ.get("COMMON_RULES_HOOK_TIMEOUT", "8"))


def _run_warmup(project: Path, extra_args: list[str]) -> str | None:
    """`bin/warmup`'s own stdout, or None on any failure, timeout, or
    non-zero exit -- the hook falls back to its own plain line rather than
    ever failing the session. Always `--no-pull`: a SessionStart hook is
    read-only, per this file's own contract, and warmup's plain card and
    --reheat otherwise reach the network and can move the rules checkout."""
    cmd = [sys.executable, str(REPO / "bin" / "warmup"), "--project", str(project),
           "--no-recall", "--no-pull", *extra_args]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=WARMUP_TIMEOUT, check=False)
    except Exception:
        return None
    return r.stdout if r.returncode == 0 and r.stdout.strip() else None


def _printable(text) -> str:
    """Control characters as visible escapes, lone surrogates as U+FFFD --
    every value printed here can come from a directory name or a ledger this
    session does not control (S-05), so nothing untrusted reaches stdout
    without going through this first."""
    out = []
    for ch in str(text):
        cp = ord(ch)
        if ch == "\n":
            out.append("\\n")
        elif ch == "\t":
            out.append("\\t")
        elif cp < 0x20 or 0x7f <= cp <= 0x9f:
            out.append(f"\\x{cp:02x}")
        elif 0xD800 <= cp <= 0xDFFF:
            out.append("�")
        else:
            out.append(ch)
    return "".join(out)


def _read_payload() -> dict:
    try:
        raw = sys.stdin.read()
    except Exception:
        return {}
    if not raw or not raw.strip():
        return {}
    try:
        data = json.loads(raw)
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


MAX_CHILDREN = 10  # a card, not a directory listing -- round 2, item 3.


def _safe_open_ledgers(child: Path) -> list:
    """checkpoint.open_ledgers(child), or [] when the child cannot be read.
    A sibling this session has no permission on (a stray chmod 000 directory,
    a race with something else touching the tree) must not hide every OTHER
    child's line -- round 2, item 1: only main()'s outer `except Exception`
    caught this before, which discarded the whole card, not just that one
    child."""
    from tools.tracker import checkpoint
    try:
        return checkpoint.open_ledgers(child)
    except OSError:
        return []


def _is_child_project(child: Path) -> bool:
    """A direct child directory counts as a project when it declares itself
    (its own `.common-rules.json`) or has an open ledger of its own -- the
    same two markers S-05 was asked to check for. Each check is its own
    try/except: a child that cannot be stat'd or read is simply not a
    project, not a reason to stop looking at its siblings."""
    try:
        if (child / ".common-rules.json").is_file():
            return True
    except OSError:
        return False
    return bool(_safe_open_ledgers(child))


def _child_projects(parent: Path) -> list[Path]:
    """Direct child directories that are projects, one level down only, in
    name order. Read-only, and never raises: a parent folder that cannot be
    listed (permissions, a race) simply has no children to report."""
    try:
        candidates = [p for p in parent.iterdir() if p.is_dir() and not p.name.startswith(".")]
    except OSError:
        return []
    candidates.sort(key=lambda p: p.name)
    return [c for c in candidates if _is_child_project(c)]


def _child_block(child: Path) -> list[str]:
    """The two lines S-05 asks for: the name with its open-ledger count and
    done/in progress/blocked/not started counts, then the /warmup command."""
    from tools.tracker import ledger
    open_ledgers = _safe_open_ledgers(child)
    totals = {"done": 0, "in progress": 0, "blocked": 0, "not started": 0}
    for _, d in open_ledgers:
        c = ledger.counts(d)
        for k in totals:
            totals[k] += c[k]
    n = len(open_ledgers)
    ledger_word = "ledger" if n == 1 else "ledgers"
    counts_str = (f'{totals["done"]} done / {totals["in progress"]} in progress / '
                  f'{totals["blocked"]} blocked / {totals["not started"]} not started')
    return [
        _printable(f"{child.name}: {n} open {ledger_word} · {counts_str}"),
        _printable(f"/warmup --project {child}"),
    ]


def _parent_card(project: Path, source) -> None:
    """When `project` itself has no open ledger, the card for a folder that
    holds several projects one level down (S-05). Capped at MAX_CHILDREN
    (round 2, item 3): a folder with dozens of projects below it -- every
    project on the machine, in the worst case -- must not print a line pair
    for each one."""
    children = _child_projects(project)
    if not children:
        return
    if source == "compact":
        print("Context was compacted. The summary above is a paraphrase; the ledger is the record.")
        print("Re-read that project's ledger and checkpoint, not the summary above.")
    noun = "project" if len(children) == 1 else "projects"
    print(f"This folder holds {len(children)} {noun} on the common-rules standard; "
          f"warm up the one you work on.")
    shown, rest = children[:MAX_CHILDREN], children[MAX_CHILDREN:]
    for child in shown:
        for line in _child_block(child):
            print(line)
    if rest:
        print(f"+{len(rest)} more -- /warmup --project <dir> for yours")


def main() -> int:
    try:
        payload = _read_payload()
        project = Path(payload.get("cwd") or os.getcwd())
        source = payload.get("source")

        from tools.tracker import checkpoint, ledger

        open_ledgers = checkpoint.open_ledgers(project)
        if not open_ledgers:
            _parent_card(project, source)
            return 0

        # Proposal 28, R-03: startup runs the plain card; compact or resume
        # runs --reheat (a delta against warmup's own saved state, or the
        # full card the first time). Any other source (clear, or none) keeps
        # this hook's own one-line-per-ledger fallback, unchanged.
        if source == "compact":
            print("Context was compacted. The summary above is a paraphrase; the ledger is the record.")
            print("Quote rulings from disk, never from the summary.")
            out = _run_warmup(project, ["--reheat"])
            if out:
                print(out, end="" if out.endswith("\n") else "\n")
            else:
                statuses = "; ".join(f"Proposal {d.get('proposal')}: {ledger.status_line(d)}"
                                     for _, d in open_ledgers)
                latest = checkpoint.latest_checkpoint(project)
                latest_str = str(latest) if latest else "no checkpoint yet"
                print(f"Re-read, in order: HANDOFF.md → docs/OPERATING-RULES.md → the ledger(s) → {latest_str}.")
                print(f"Status: {statuses}.")
        elif source == "resume":
            out = _run_warmup(project, ["--reheat"])
            if out:
                print(out, end="" if out.endswith("\n") else "\n")
            else:
                for _, d in open_ledgers:
                    print(f"Proposal {d.get('proposal')}: {ledger.status_line(d)} · run /warmup")
        elif source == "startup":
            out = _run_warmup(project, [])
            if out:
                print(out, end="" if out.endswith("\n") else "\n")
            else:
                for _, d in open_ledgers:
                    print(f"Proposal {d.get('proposal')}: {ledger.status_line(d)} · run /warmup")
        else:
            for _, d in open_ledgers:
                print(f"Proposal {d.get('proposal')}: {ledger.status_line(d)} · run /warmup")
    except Exception:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
