#!/usr/bin/env python3
"""Stop hook (proposal 19, D8 / W-07). Refreshes the checkpoint after every
turn, without depending on the session remembering to write one (proposal
19, section H, "the write side").

Fires on every assistant turn, so it writes only `--if-changed` -- a
checkpoint is not rewritten just because a turn happened, only when the
ledger it is built from moved. Does nothing at all when `stop_hook_active`
is true (Claude Code re-invoking Stop hooks on a hook-triggered continuation
would otherwise recurse the same write). Never fails the session: every
exception is swallowed, the exit code is always 0, and nothing is printed
on success.

RULES MOVED (proposal 28, R-03). warmup's own state file (the one --state or
--reheat writes, at bin/warmup's default_state_path) carries the shared
rules checkout's HEAD as of that run. If this project has such a state file
and the checkout has moved past it since -- read with `git rev-parse`, never
a fetch -- this hook prints one line: `rules moved -- run /reheat`. No state
file, or a checkout that has not moved, prints nothing. Hard-timed the same
as the checkpoint write below; still exits 0 on any failure.

WORKLOG COLLECT (proposal 27, W-03). Also runs `tools.worklog.collect()` --
the fast, incremental pass over transcripts that `bin/worklog collect`
itself runs, writing new rows into `worklog/<day>.jsonl` under common-rules.
This is best-effort telemetry, not a gate: any exception it raises
(including `worklog.StateTrustError`, e.g. a `.state.json` an earlier
`--rebuild` left mid-way) is caught and swallowed inside `_collect_worklog`
itself, before it ever reaches this hook's own outer guard. A session never
commits what this writes -- see `bin/worklog-nightly`, the separate,
non-interactive script that collects the rest and makes the day's one
commit of `worklog/`. Nothing here calls git.

`collect` scans every transcript on the machine (`~/.agent-data/projects`), not
just this project's -- fine once its own `.state.json` is warm (only new
bytes since the last run), but a first pass, or a machine with many
sessions writing at once, can run long. So this never blocks the hook past
`WORKLOG_COLLECT_TIMEOUT` seconds (default 5, same default as the
rules-moved check above): it runs in a daemon thread and the hook moves on
without waiting for it. `collect` only persists its new byte offsets in
`.state.json` once, at the very end of a run, after any day files it
touched are already written -- so a run this abandons mid-way leaves those
day files ahead of what `.state.json` remembers, and the *next* collect
re-reads and re-adds the same transcript bytes once more. That is a
one-time, self-correcting over-count under sustained heavy concurrency, not
data corruption (every file write is still tmp-then-`os.replace`) and not a
hang -- the trade this hook is allowed to make, being best-effort telemetry
rather than a gate.
"""
from __future__ import annotations

import contextlib
import io
import json
import os
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO))

RULES_MOVED_TIMEOUT = float(os.environ.get("COMMON_RULES_HOOK_TIMEOUT", "5"))
WORKLOG_COLLECT_TIMEOUT = float(os.environ.get("WORKLOG_COLLECT_TIMEOUT", "5"))


def _load_warmup():
    import importlib.machinery
    import importlib.util
    loader = importlib.machinery.SourceFileLoader("warmup_for_stop", str(REPO / "bin" / "warmup"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def _rules_moved_line(project: Path) -> str | None:
    try:
        import subprocess
        W = _load_warmup()
        state_path = W.default_state_path(project)
        if not state_path.is_file():
            return None
        old = json.loads(state_path.read_text())
        saved = old.get("rules_head")
        if not saved:
            return None
        r = subprocess.run(["git", "-C", str(W.RULES_DIR), "rev-parse", "HEAD"],
                           capture_output=True, text=True, timeout=RULES_MOVED_TIMEOUT, check=False)
        current = r.stdout.strip() if r.returncode == 0 else None
        if current and current != saved:
            return "rules moved -- run /reheat"
    except Exception:
        return None
    return None


def _collect_worklog() -> None:
    """Best-effort `worklog collect` (W-03): never raises, never prints,
    never touches git, and never blocks the hook past
    `WORKLOG_COLLECT_TIMEOUT` seconds -- see this file's own docstring for
    why a daemon thread with a join timeout, rather than waiting outright,
    is the right trade here. `tools.worklog` is imported lazily, like
    `_load_warmup`, so a broken import of it cannot break every other hook
    that loads this file's siblings."""
    import threading

    def _run():
        try:
            from tools import worklog
            worklog.collect()
        except Exception:
            pass

    try:
        t = threading.Thread(target=_run, daemon=True)
        t.start()
        t.join(WORKLOG_COLLECT_TIMEOUT)
    except Exception:
        pass


def _read_payload() -> dict:
    try:
        raw = sys.stdin.read()
    except Exception:
        return {}
    if not raw or not raw.strip():
        return {}
    try:
        data = json.loads(raw)
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def main() -> int:
    try:
        payload = _read_payload()
        if payload.get("stop_hook_active") is True:
            return 0
        project = payload.get("cwd") or os.getcwd()
        _collect_worklog()
        # Keep the generated tracker current after every Claude/Codex cycle.
        # This is best-effort and deliberately does not stage or commit.
        from tools.tracker import auto_update
        auto_update.update(project)
        from tools.tracker import checkpoint
        with contextlib.redirect_stdout(io.StringIO()):
            checkpoint.main(["--project", str(project), "--reason", "stop", "--if-changed"])
        line = _rules_moved_line(Path(project))
        if line:
            print(line)
    except Exception:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
