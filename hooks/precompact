#!/usr/bin/env python3
"""PreCompact hook (proposal 19, D8 / W-07). Writes the checkpoint from the
ledger before Claude Code's own summary is made, so what survives a
compaction is the ledger's record, not a paraphrase (proposal 19, section K).

Reads the hook's JSON on stdin (fields including `cwd`, `trigger` -- both
optional, per Claude Code's PreCompact contract). Always writes when an
open ledger exists; a project with none writes nothing (checkpoint.py's own
rule). Never fails the session: every exception is swallowed, the exit code
is always 0, and nothing is printed on success.
"""
from __future__ import annotations

import contextlib
import io
import json
import os
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO))


def _read_payload() -> dict:
    try:
        raw = sys.stdin.read()
    except Exception:
        return {}
    if not raw or not raw.strip():
        return {}
    try:
        data = json.loads(raw)
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def main() -> int:
    try:
        payload = _read_payload()
        project = payload.get("cwd") or os.getcwd()
        from tools.tracker import checkpoint
        with contextlib.redirect_stdout(io.StringIO()):
            checkpoint.main(["--project", str(project), "--reason", "precompact"])
    except Exception:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
